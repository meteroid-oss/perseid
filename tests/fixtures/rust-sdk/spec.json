{
  "openapi": "3.1.0",
  "info": {
    "title": "Synthetic transport tests",
    "version": "1"
  },
  "components": {
    "schemas": {
      "Ack": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      },
      "File": {
        "type": "string",
        "format": "binary"
      }
    }
  },
  "paths": {
    "/upload": {
      "put": {
        "tags": [
          "Files"
        ],
        "operationId": "upload",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ack"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
    "/optional-upload": {
      "put": {
        "tags": [
          "Files"
        ],
        "operationId": "optional_upload",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ack"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
    "/multipart": {
      "post": {
        "tags": [
          "Files"
        ],
        "operationId": "multipart",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ack"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "title"
                ],
                "properties": {
                  "file": {
                    "$ref": "#/components/schemas/File"
                  },
                  "title": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "csv",
                      "json"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "get": {
        "tags": [
          "Files"
        ],
        "operationId": "events",
        "responses": {
          "200": {
            "description": "Events",
            "content": {
              "text/event-stream": {}
            }
          }
        }
      }
    },
    "/buffered": {
      "get": {
        "tags": [
          "Files"
        ],
        "operationId": "buffered",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ack"
                }
              }
            }
          }
        }
      }
    },
    "/form-url": {
      "post": {
        "tags": [
          "Files"
        ],
        "operationId": "form_url",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ack"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
