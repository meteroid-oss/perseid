<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>@@PACKAGE_NAME@@</RootNamespace>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>@@PACKAGE_NAME@@</PackageId>
    <Version>@@VERSION@@</Version><!-- x-release-please-version -->
    <Authors>@@AUTHORS_NAMES@@</Authors>
    <Description>@@DESCRIPTION@@</Description>
    <PackageTags>@@USER_AGENT_PREFIX@@;api;sdk</PackageTags>
    <PackageLicenseExpression>@@LICENSE@@</PackageLicenseExpression>
    <PackageProjectUrl>@@PROJECT_URL@@</PackageProjectUrl>
    <RepositoryUrl>@@REPOSITORY@@</RepositoryUrl><RepositoryType>git</RepositoryType>
    <PackageReadmeFile Condition="Exists('../README.md')">README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The IHttpClientFactory integration, generated with `dependency_injection = true` in [csharp.context]. -->
  <ItemGroup Condition="Exists('@@CLIENT_NAME@@ServiceCollectionExtensions.cs')">
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" Condition="Exists('../README.md')" />
  </ItemGroup>
</Project>
