{% import "types/macros.ts.jinja" as m -%}
{% import "docs.jinja" as docs -%}
{% set _ = set_summary_filename((resource.name | to_lower_camel_case) ~ ".test.ts") -%}
{% set bodies = cases | selectattr("body") | map(attribute="body.schema") | map("to_upper_camel_case") | unique | list -%}
// this file is @generated
import assert from "node:assert/strict";
import { test } from "node:test";
{% if bodies %}import { parseJson{% for b in bodies %}, {{ b }}Serializer{% endfor %} } from "../../src/index.js";
{% endif %}import { mock } from "./mock.js";
{% for case in cases %}
{%- set op = resource.operations[case.index] %}
{%- set args = namespace(list=[]) %}
{%- for arg in case.path_args %}{% set args.list = args.list + [docs.literal(arg)] %}{% endfor %}
{%- set twin = resource.operations | selectattr("name", "equalto", op.name ~ "_stream") | selectattr("stream_property", "defined") | first %}
{%- if case.body %}
{%- set body = (case.body.schema | to_upper_camel_case) ~ "Serializer.parse(parseJson(" ~ (case.body.json | tojson) ~ "))" %}
{#- The body of the operation a `_stream` twin has does not ask for the stream. #}
{%- if twin %}{% set body = "{ ..." ~ body ~ ", " ~ (twin.stream_property | ident("camel")) ~ ": false }" %}{% endif %}
{%- set args.list = args.list + [body] %}
{%- endif %}

test("{{ resource.path | join(".") }}.{{ op.name }}", async () => {
  const { client, requests } = mock({
    status: {{ case.response.status }},
    contentType: {{ case.response.content_type | tojson }},
    body: {{ case.response.body | tojson }},
  });
{%- set call = docs.resource(resource.path) ~ "." ~ docs.method(op) ~ "(" ~ (args.list | join(", ")) ~ ")" %}
{%- if op.response_is_event_stream %}
  for await (const event of await {{ call }}) {
    void event;
  }
{%- elif op.response_is_binary | default(false) %}
  assert.equal(await (await {{ call }}).text(), {{ case.response.body | tojson }});
{%- else %}
  await {{ call }};
{%- endif %}
  assert.deepEqual(requests, [{{ (case.method ~ " " ~ case.path) | tojson }}]);
});
{%- endfor %}
