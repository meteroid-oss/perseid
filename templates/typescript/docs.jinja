{#- The API as TypeScript names it, for api.md and the README's examples. An example is a
    `{resource, operation, path_args, body, result, item}` the README receives. -#}

{#- The heading of a resource in api.md, and links to every resource's. -#}
{% macro title(name) %}{{ name | to_snake_case | replace("_", " ") | capitalize }}{% endmacro %}

{% macro contents(resources) -%}
    {%- for r in resources %}[{{ title(r.name) }}](#{{ r.name | to_kebab_case }}){% if not loop.last %} · {% endif %}{% endfor -%}
{%- endmacro %}

{% macro resource(name) %}client.{{ name | to_lower_camel_case }}{% endmacro %}

{% macro method(op) %}{{ op.name | ident("camel") }}{% endmacro %}

{% macro model_path(name) %}src/models/{{ name | to_lower_camel_case }}.ts{% endmacro %}

{% macro resource_path(name) %}src/api/{{ name | to_lower_camel_case }}.ts{% endmacro %}

{#- A variable holding a value of schema `name`, `fallback` without one. -#}
{% macro var(name, fallback) -%}
    {%- set id = name | ident("camel", "typescript") if name else fallback -%}
    {{ fallback if id in ["client", "page", "stream", "response", "error"] else id }}
{%- endmacro %}

{% macro literal(arg) -%}
    {%- if arg.kind == "integer" and arg.int64 and sdk.int64 == "bigint" %}{{ arg.value }}n
    {%- elif arg.kind == "integer" and arg.int64 and sdk.int64 == "string" %}"{{ arg.value }}"
    {%- else %}{{ arg.value | tojson }}{% endif -%}
{%- endmacro %}

{#- The call of an example, with `request_options` as its last argument when given. -#}
{% macro call(ex, request_options="") -%}
    {%- set out = namespace(args=[]) -%}
    {%- for a in ex.path_args %}{% set out.args = out.args + [literal(a)] %}{% endfor -%}
    {%- if ex.body -%}
        {%- set fields = namespace(list=[]) -%}
        {%- for f in ex.body.fields %}{% set fields.list = fields.list + [(f.name | ident("camel")) ~ ": " ~ literal(f)] %}{% endfor -%}
        {%- set out.args = out.args + (["{ " ~ (fields.list | join(", ")) ~ " }"] if fields.list else ["{}"]) -%}
    {%- endif -%}
    {%- if request_options -%}
        {%- if ex.operation | has_query_or_header_params %}{% set out.args = out.args + ["undefined"] %}{% endif -%}
        {%- set out.args = out.args + [request_options] -%}
    {%- endif -%}
    {{ resource(ex.resource) }}.{{ method(ex.operation) }}({{ out.args | join(", ") }})
{%- endmacro %}
