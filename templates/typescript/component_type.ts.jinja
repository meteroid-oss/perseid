// this file is @generated
{% if type.description is defined -%}
{% set doc_comment = type.description | to_doc_comment(style="js") -%}
{% else -%}
{% set doc_comment = "" -%}
{% endif -%}

{#
    The body is rendered first so that the runtime helpers are only imported
    by the models that use them (a conversion can sit deep in a list, a map or
    an enum variant).
-#}
{% set body -%}
{% if type.kind == "struct" -%}
    {% include "types/struct.ts.jinja" -%}
{% elif type.kind == "string_enum" -%}
    {% include "types/string_enum.ts.jinja" -%}
{% elif type.kind == "integer_enum" -%}
    {% include "types/integer_enum.ts.jinja" -%}
{% elif type.kind == "struct_enum" -%}
    {% include "types/struct_enum.ts.jinja" -%}
{% elif type.kind == "string_alias" -%}
    {% include "types/string_alias.ts.jinja" -%}
{% elif type.kind == "alias" -%}
    {% include "types/alias.ts.jinja" -%}
{% else -%}
    {# Fail loudly rather than silently emitting nothing for an unhandled kind. #}
    {{ panic("typescript codegen: unsupported schema kind `" ~ type.kind ~ "` for type `" ~ type.name ~ "`") }}
{% endif %}
{% endset -%}
{% set json_helpers = ["extraProperties", "isJsonObject", "omitProperties", "pickProperties"] | select("in", body) | list -%}
{% if json_helpers -%}
import { {{ json_helpers | join(", ") }} } from "../json.js";
{% endif -%}
{% set union_helpers = ["unionBestMatch", "unionHas", "unionTagged", "unionTry"] | select("in", body) | list -%}
{% if union_helpers -%}
import { {{ union_helpers | join(", ") }} } from "../unions.js";
{% endif -%}
{% set decode_helpers = ["decodeBoolean", "decodeDateTime", "decodeInteger", "decodeList", "decodeMap", "decodeNumber", "decodeObject", "decodePath", "decodeRequired", "decodeString"] | select("in", body) | list -%}
{% if decode_helpers -%}
import { {{ decode_helpers | join(", ") }} } from "../decode.js";
{% endif -%}
{{ body }}
