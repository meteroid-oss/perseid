{% import "types/macros.ts.jinja" as m -%}
{% set resource_type_name = resource.name | to_upper_camel_case -%}
// this file is @generated

{# A blank line keeps the marker apart from the imports, which may be removed if unused.
   Operations declaring an error schema other than the API default parse their own. -#}
{% set errs = namespace(ops=[]) -%}
{% for op in resource.operations -%}
{% for _, schema in op.errors | items %}{% if schema != default_error and op.id not in errs.ops %}{% set errs.ops = errs.ops + [op.id] %}{% endif %}{% endfor -%}
{% endfor -%}
{% for c in referenced_components -%}
import { type {{ c | to_upper_camel_case }}, {{ c | to_upper_camel_case }}Serializer } from "../models/{{ c | to_lower_camel_case }}.js";
{% endfor -%}
{% if resource.operations | selectattr("pagination", "defined") | list | length > 0 -%}
import { paginate } from "../pagination.js";
{% endif -%}
import { {{ sdk.client_name }}Request, type {{ sdk.client_name }}RequestContext, type RequestOptions } from "../request.js";
{% set kinds = resource.operations | map(attribute="request_body_kind") | list -%}
{% set streams = resource.operations | selectattr("response_is_event_stream") | list | length > 0 -%}
{% if streams or "binary" in kinds or "multipart" in kinds -%}
import {
    {% if streams %}type EventStream,{% endif %}
    {% if "multipart" in kinds %}MultipartBody, type Upload,{% endif %}
    {% if "binary" in kinds %}type UploadBody,{% endif %}
} from "../streaming.js";
{% endif %}

{% for op in resource.operations -%}
    {% if op.request_body_kind == "multipart" -%}
    /** Multipart form fields. */
    export interface {{ resource_type_name }}{{ op.name | to_upper_camel_case }}Body {
        {% for field in op.multipart_fields -%}
            {% if field.description is defined -%}
                {{ field.description | to_doc_comment(style="js") }}
            {% endif -%}
            {{ field.name | ident("camel") }}{% if not field.required %}?{% endif %}: {% if field.is_file %}Upload{% else %}{{ m.js_type(field.type) }}{% endif %}{% if field.nullable %} | null{% endif %};
        {% endfor -%}
    }

    {% endif -%}
    {% if op | has_query_or_header_params -%}
    export interface {{ resource_type_name }}{{ op.name | to_upper_camel_case }}Options {
        {% for p in op.query_params -%}
            {{ m.doc(p.description, false) }}{{ p.name | ident("camel") }}{% if not p.required %}?{% endif %}: {{ m.js_type(p.type) }};
        {% endfor -%}
        {% for p in op.header_params -%}
            {{ p.name | ident("camel") }}{% if not p.required %}?{% endif %}: string;
        {% endfor -%}
    }

    {% endif -%}
{% endfor -%}

export class {{ resource_type_name }} {
    public constructor(private readonly requestCtx: {{ sdk.client_name }}RequestContext) {}

    {% set extension %}extensions/{{ resource.name | to_snake_case }}.ts{% endset -%}
    {% include extension ignore missing %}

    {% for op in resource.operations -%}
        {% if op.response_is_event_stream -%}
            {% set response_type = "EventStream" -%}
        {% elif op.response_is_binary | default(false) -%}
            {% set response_type = "Uint8Array" -%}
        {% elif op.response_is_text | default(false) -%}
            {% set response_type = "string" -%}
        {% elif op.response_body_json_type is defined -%}
            {% set response_type = m.js_type(op.response_body_json_type) -%}
        {% elif op.response_body_schema_name is defined -%}
            {% set response_type = op.response_body_schema_name | to_upper_camel_case -%}
            {% if op.response_body_is_list %}{% set response_type = response_type ~ "[]" %}{% endif -%}
        {% else -%}
            {% set response_type = "void" -%}
        {% endif -%}
        {{ m.doc(op.description, op.deprecated) }}public {{ op.name | ident("camel") }}(
            {% for p in op.path_params -%}
                {{ p | ident("camel", "typescript") }}: string,
            {% endfor -%}

            {% if op.request_body_schema_name is defined -%}
                {% set body_arg = op.request_body_schema_name | ident("camel", "typescript") -%}
                {% if body_arg in ["request", "options", "requestOptions"] or body_arg in (op.path_params | map("ident", "camel", "typescript") | list) %}{% set body_arg = "body" %}{% endif -%}
                {{ body_arg }}: {{ op.request_body_schema_name | to_upper_camel_case }}{% if op.request_body_is_list %}[]{% endif %},
            {% elif op.request_body_json_type is defined -%}
                body: {{ m.js_type(op.request_body_json_type) }},
            {% elif op.request_body_kind in ["binary", "multipart"] -%}
                {% set body_ty = "UploadBody" if op.request_body_kind == "binary" else resource_type_name ~ (op.name | to_upper_camel_case) ~ "Body" -%}
                {% if not op.request_body_optional -%}
                body: {{ body_ty }},
                {% elif op | has_required_query_or_header_params -%}
                body: {{ body_ty }} | undefined,
                {% else -%}
                body?: {{ body_ty }},
                {% endif -%}
            {% endif -%}

            {% if op | has_query_or_header_params -%}
                options{% if not op | has_required_query_or_header_params %}?{% endif %}: {{ resource_type_name }}{{ op.name | to_upper_camel_case }}Options,
            {% endif -%}
            requestOptions?: RequestOptions,
        ): Promise<{{ response_type }}> {
            const request = new {{ sdk.client_name }}Request("{{ op.method | upper }}", {{ op.path | tojson }});

            {% for p in op.path_params -%}
                request.setPathParam({{ p | tojson }}, {{ p | ident("camel", "typescript") }});
            {% endfor -%}
            {% if op.security is defined -%}
                request.setSecurity({{ op.security | tojson }});
            {% endif -%}
            {% if op.id in errs.ops -%}
                request.setErrors({
                    {% for status, schema in op.errors | items -%}
                    {{ status | tojson }}: {{ schema | to_upper_camel_case }}Serializer.parse,
                    {% endfor -%}
                });
            {% endif -%}

            {% for p in op.query_params -%}
                {% set accessor %}options{% if not p.required %}?{% endif %}.{{ p.name | ident("camel") }}{% endset -%}
                {% if p.structured -%}
                    {% set value = accessor if not m.converted(p.type, true) else accessor ~ " != null ? " ~ m.to_json("options." ~ (p.name | ident("camel")), p.type) ~ " : undefined" -%}
                    request.setStructuredQueryParam({{ p.name | tojson }}, {{ value }}, {{ p.deep_object | lower }}, {{ p.explode | lower }});
                {% elif (p.type.is_list() or p.type.is_set()) and p.explode | default(true) -%}
                    request.setExplodedQueryParam({{ p.name | tojson }}, {{ accessor }});
                {% else -%}
                    request.setQueryParam({{ p.name | tojson }}, {{ accessor }});
                {% endif -%}
            {% endfor -%}

            {% for p in op.header_params -%}
                request.setHeaderParam({{ p.name | tojson }}, options{% if not p.required %}?{% endif %}.{{ p.name | ident("camel") }});
            {% endfor -%}

            {% if op.request_body_schema_name is defined -%}
                {% set serializer = (op.request_body_schema_name | to_upper_camel_case) ~ "Serializer" -%}
                {% if op.request_body_is_form | default(false) -%}
                request.setFormBody({{ serializer }}.serialize({{ body_arg }}){% if op.form_deep_object or op.form_unexploded %}, {{ op.form_deep_object | default([]) | tojson }}, {{ op.form_unexploded | default([]) | tojson }}{% endif %});
                {% elif op.request_body_is_list -%}
                request.setBody({{ body_arg }}.map((item) => {{ serializer }}.serialize(item)));
                {% else -%}
                request.setBody({{ serializer }}.serialize({{ body_arg }}));
                {% endif -%}
            {% elif op.request_body_json_type is defined -%}
                request.setBody({{ m.to_json("body", op.request_body_json_type) }});
            {% endif -%}

            {% if op.request_body_kind == "binary" -%}
                {% if op.request_body_optional %}if (body !== undefined) {% endif %}request.setUploadBody(body{% if op.request_body_content_type is defined %}, {{ op.request_body_content_type | tojson }}{% endif %});
            {% elif op.request_body_kind == "multipart" -%}
                {% if op.request_body_optional %}if (body !== undefined) { {% endif %}
                const form = new MultipartBody();
                {% for field in op.multipart_fields -%}
                    {% set value = "body." ~ (field.name | ident("camel")) -%}
                    {% if not field.required or field.nullable %}if ({{ value }} !== undefined && {{ value }} !== null) { {% endif -%}
                    {% if field.is_file -%}
                    form.file({{ field.name | tojson }}, {{ value }});
                    {% else -%}
                    form.field({{ field.name | tojson }}, {{ m.to_json(value, field.type) }});
                    {% endif -%}
                    {% if not field.required or field.nullable %} } {% endif -%}
                {% endfor -%}
                request.setMultipartBody(form);
                {% if op.request_body_optional %} } {% endif %}
            {% endif -%}

            {% if op.response_is_event_stream -%}
                return request.sendEventStream(this.requestCtx, requestOptions);
            {% elif op.response_is_binary | default(false) -%}
                return request.sendBinary(this.requestCtx, requestOptions);
            {% elif op.response_is_text | default(false) -%}
                return request.sendText(this.requestCtx, requestOptions);
            {% elif op.response_body_json_type is defined -%}
                {% set parse = m.from_json("json", op.response_body_json_type) -%}
                return request.send(this.requestCtx, (json: any) => {{ parse }}, requestOptions);
            {% elif op.response_body_schema_name is defined -%}
                {% set serializer = (op.response_body_schema_name | to_upper_camel_case) ~ "Serializer" -%}
                {% if op.response_body_is_list -%}
                return request.send(this.requestCtx, (json: any[]) => json.map((item) => {{ serializer }}.parse(item)), requestOptions);
                {% else -%}
                return request.send(this.requestCtx, {{ serializer }}.parse, requestOptions);
                {% endif -%}
            {% else -%}
                return request.sendNoResponseBody(this.requestCtx, requestOptions);
            {% endif -%}
        }

        {% if op.pagination is defined -%}
        {% set pg = op.pagination -%}
        {% set param_field = pg.param | ident("camel") -%}
        {% set options_ty = resource_type_name ~ (op.name | to_upper_camel_case) ~ "Options" -%}
        /** Iterates with `for await` over every item of `{{ op.name | ident("camel") }}`, fetching further pages on demand. */
        public {{ op.name | to_lower_camel_case }}Iter(
            {% for p in op.path_params -%}
                {{ p | ident("camel", "typescript") }}: string,
            {% endfor -%}
            {% if op.request_body_schema_name is defined -%}
                {{ body_arg }}: {{ op.request_body_schema_name | to_upper_camel_case }}{% if op.request_body_is_list %}[]{% endif %},
            {% elif op.request_body_json_type is defined -%}
                body: {{ m.js_type(op.request_body_json_type) }},
            {% endif -%}
            options{% if not op | has_required_query_or_header_params %}?{% endif %}: {{ options_ty }},
            requestOptions?: RequestOptions,
        ): AsyncIterableIterator<{{ pg.item_schema | to_upper_camel_case }}> {
            return paginate(
                {
                    style: "{{ pg.style }}",
                    items: {{ pg.items | tojson }},
                    {% if pg.next_cursor is defined -%}
                    nextCursor: {{ pg.next_cursor | tojson }},
                    {% endif -%}
                    {% if pg.item_cursor is defined -%}
                    itemCursor: {{ pg.item_cursor | tojson }},
                    {% endif -%}
                    {% if pg.has_more is defined -%}
                    hasMore: {{ pg.has_more | tojson }},
                    {% endif -%}
                    {% if pg.total_pages is defined -%}
                    totalPages: {{ pg.total_pages | tojson }},
                    {% endif -%}
                    {% if pg.total is defined -%}
                    total: {{ pg.total | tojson }},
                    {% endif -%}
                    firstPage: {{ pg.first_page }},
                },
                options?.{{ param_field }},
                (param) =>
                    this.{{ op.name | ident("camel") }}(
                        {% for p in op.path_params %}{{ p | ident("camel", "typescript") }}, {% endfor -%}
                        {% if op.request_body_schema_name is defined %}{{ body_arg }}, {% elif op.request_body_json_type is defined %}body, {% endif -%}
                        { ...options, {{ param_field }}: param },
                        requestOptions,
                    ),
                {{ op.response_body_schema_name | to_upper_camel_case }}Serializer.serialize,
                {{ pg.item_schema | to_upper_camel_case }}Serializer.parse,
            );
        }

        {% endif -%}
        {% set extra_path -%}
            api_extra/{{ resource.name | to_snake_case }}_{{ op.name | to_snake_case }}.ts
        {%- endset -%}
        {% include extra_path ignore missing %}

    {% endfor -%}
}

{% set extra_path -%}
    api_extra/{{ resource.name | to_snake_case }}.ts
{%- endset -%}
{% include extra_path ignore missing %}
