                request.setFormBody({{ serializer }}.serialize({{ body_arg }}){% if op.form_deep_object or op.form_unexploded %}, {{ op.form_deep_object | default([]) | tojson }}, {{ op.form_unexploded | default([]) | tojson }}{% endif %});
                {% elif op.request_body_is_list -%}
                request.setBody({{ body_arg }}.map((item) => {{ serializer }}.serialize(item)));
                {% elif op.stream_property is defined -%}
                request.setBody({ ...{{ serializer }}.serialize({{ body_arg }}), {{ op.stream_property | tojson }}: true });
                {% else -%}
                request.setBody({{ serializer }}.serialize({{ body_arg }}));
                {% endif -%}
            {% elif op.request_body_json_type is defined -%}
                request.setBody({{ m.to_json("body", op.request_body_json_type) }});
            {% endif -%}

            {% if op.request_body_kind == "binary" -%}
                {% if op.request_body_optional %}if (body !== undefined) {% endif %}request.setUploadBody(body{% if op.request_body_content_type is defined %}, {{ op.request_body_content_type | tojson }}{% endif %});
            {% elif op.request_body_kind == "multipart" -%}
                {% if op.request_body_optional %}if (body !== undefined) { {% endif %}
                const form = new MultipartBody();
                {% for field in op.multipart_fields -%}
                    {% set value = "body." ~ (field.name | ident("camel")) -%}
                    {% if not field.required or field.nullable %}if ({{ value }} !== undefined && {{ value }} !== null) { {% endif -%}
                    {% set part_type = (", " ~ (field.content_type | tojson)) if field.content_type is defined else "" -%}
                    {% if field.is_file and field.is_file_list -%}
                    for (const file of {{ value }}) { form.file({{ field.name | tojson }}, file{{ part_type }}); }
                    {% elif field.is_file -%}
                    form.file({{ field.name | tojson }}, {{ value }}{{ part_type }});
                    {% else -%}
                    form.field({{ field.name | tojson }}, {{ m.to_json(value, field.type) }}{{ part_type }});
                    {% endif -%}
                    {% if not field.required or field.nullable %} } {% endif -%}
                {% endfor -%}
                request.setMultipartBody(form);
                {% if op.request_body_optional %} } {% endif %}
            {% endif -%}

            {% if op.response_is_event_stream and op.event_schema_name is defined -%}
                return request.sendJsonStream(this.requestCtx, {{ op.event_schema_name | to_upper_camel_case }}Serializer.parse, requestOptions);
            {% elif op.response_is_event_stream -%}
                return request.sendEventStream(this.requestCtx, requestOptions);
            {% elif op.response_is_binary | default(false) -%}
                return request.sendBinary(this.requestCtx, requestOptions);
            {% elif op.response_is_text | default(false) -%}
                return request.sendText(this.requestCtx, requestOptions);
            {% elif op.response_body_json_type is defined -%}
                {% set parse = m.from_json("json", op.response_body_json_type, '"$"', "undefined") -%}
                return request.send{% if may_be_empty %}Optional{% endif %}(this.requestCtx, (json: any) => {{ parse }}, requestOptions);
            {% elif op.response_body_schema_name is defined -%}
                {% set serializer = (op.response_body_schema_name | to_upper_camel_case) ~ "Serializer" -%}
                {% if op.response_body_is_list -%}
                return request.send{% if may_be_empty %}Optional{% endif %}(this.requestCtx, (json: any) => decodeList(json, "$", undefined, (item: any, p: string, i: number) => {{ serializer }}.parse(item, decodePath(p, i))), requestOptions);
                {% else -%}
                return request.send{% if may_be_empty %}Optional{% endif %}(this.requestCtx, {{ serializer }}.parse, requestOptions);
                {% endif -%}
            {% else -%}
                return request.sendNoResponseBody(this.requestCtx, requestOptions);
            {% endif -%}
        }

        {% set extra_path -%}
            api_extra/{{ resource.name | to_snake_case }}_{{ op.name | to_snake_case }}.ts
        {%- endset -%}
        {% include extra_path ignore missing %}

    {% endfor -%}
}

