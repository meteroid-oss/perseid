{% import "types/macros.ts.jinja" as m -%}
{% set resource_type_name = resource.name | to_upper_camel_case -%}
{% set imported = referenced_components | map("to_upper_camel_case") | list -%}
{#- Runtime classes a model of the resource is named like are imported under another name. -#}
{% macro runtime(name) %}{{ "Runtime" ~ name if name in imported else name }}{% endmacro -%}
{% macro runtime_import(name) %}{{ name }}{% if name in imported %} as Runtime{{ name }}{% endif %}{% endmacro -%}

{#- The type of a path parameter sent as text: schemas are given as their text. -#}
{% macro text_type(type) -%}
    {%- if type.is_union() -%}
        {%- for v in type.union_variants() %}{% if not loop.first %} | {% endif %}{{ text_type(v.type) }}{% endfor -%}
    {%- elif type.is_list() or type.is_set() -%}
        {%- set inner = text_type(type.inner_type()) -%}
        {% if " | " in inner %}({{ inner }})[]{% else %}{{ inner }}[]{% endif %}
    {%- elif type.is_schema_ref() or type.is_json_object() or type.is_map() -%}
        string
    {%- else -%}
        {{ m.js_type(type) }}
    {%- endif -%}
{%- endmacro %}

{#- `yes` when `type` names a schema the resource does not import. -#}
{% macro unimported(type) -%}
    {%- if type.is_union() -%}
        {%- for v in type.union_variants() if unimported(v.type) %}{% if loop.first %}yes{% endif %}{% endfor -%}
    {%- elif type.is_list() or type.is_set() -%}
        {{ unimported(type.inner_type()) }}
    {%- elif type.is_map() -%}
        {{ unimported(type.value_type()) }}
    {%- elif type.is_schema_ref() and type.to_js() not in imported -%}
        yes
    {%- endif -%}
{%- endmacro %}

{#- `page.a?.b` for the path `["a", "b"]` of a property of the response. -#}
{% macro at(path) -%}
    page{% for key in path %}{{ "." if loop.first else "?." }}{{ key | ident("camel") }}{% endfor -%}
{%- endmacro %}

{#- The operation's description, else its method and path, then `note`. -#}
{% macro op_doc(op, note="") -%}
    {%- set text = op.description if op.description is defined and op.description else "`" ~ (op.method | upper) ~ " " ~ op.path ~ "`." -%}
    {{ m.doc(text ~ ("\n\n" ~ note if note else ""), op.deprecated) }}
{%- endmacro %}

{% set errs = namespace(ops=[]) -%}
{% for op in resource.operations -%}
{% for _, schema in op.errors | items %}{% if schema != default_error and op.id not in errs.ops %}{% set errs.ops = errs.ops + [op.id] %}{% endif %}{% endfor -%}
{% endfor -%}
{% set kinds = resource.operations | map(attribute="request_body_kind") | list -%}
{% set paginated = resource.operations | selectattr("pagination", "defined") | list | length > 0 -%}
{% set streams = resource.operations | selectattr("response_is_event_stream") | list -%}
{% set typed_streams = streams | selectattr("event_schema_name", "defined") | list | length > 0 -%}
{% set raw_streams = streams | rejectattr("event_schema_name", "defined") | list | length > 0 -%}

{% set body -%}
{% for op in resource.operations -%}
    {% if op.request_body_kind == "multipart" -%}
    /** Multipart form fields. */
    export interface {{ resource_type_name }}{{ op.name | to_upper_camel_case }}Body {
        {% for field in op.multipart_fields -%}
            {% if field.description is defined -%}
                {{ field.description | to_doc_comment(style="js") }}
            {% endif -%}
            {{ field.name | ident("camel") }}{% if not field.required %}?{% endif %}: {% if field.is_file and field.is_file_list %}Upload[]{% elif field.is_file %}Upload{% else %}{{ m.js_type(field.type) }}{% endif %}{% if field.nullable %} | null{% endif %}{% if not field.required %} | undefined{% endif %};
        {% endfor -%}
    }

    {% endif -%}
    {% if op | has_query_or_header_params -%}
    /** The query and header parameters of `{{ op.name | ident("camel") }}`. */
    export interface {{ resource_type_name }}{{ op.name | to_upper_camel_case }}Options {
        {% for p in op.query_params -%}
            {#- A union is typed as such rather than as untyped JSON. -#}
            {% set ptype = p.typed_union if p.typed_union is defined and not unimported(p.typed_union) else p.type -%}
            {{ m.doc(p.description, false) }}{{ p.ident | ident("camel") }}{% if not p.required %}?{% endif %}: {{ m.js_type(ptype) }}{% if not p.required %} | undefined{% endif %};
        {% endfor -%}
        {% for p in op.header_params -%}
            {% if p.description is defined and p.description %}{{ m.doc(p.description, false) }}{% else %}/** Sent as the `{{ p.name }}` {{ "cookie" if p.cookie else "header" }}{% if p.json %}, as compact JSON{% endif %}. */
            {% endif %}{{ p.ident | ident("camel") }}{% if not p.required %}?{% endif %}: {{ m.js_type(p.type) }}{% if not p.required %} | undefined{% endif %};
        {% endfor -%}
    }

    {% endif -%}
{% endfor -%}

{% set summary = resource.path | join(" ") | replace("_", " ") -%}
/** The {{ summary }} operations, reached through the client's `{{ resource.path | map("to_lower_camel_case") | join(".") }}`. */
export class {{ resource_type_name }} {
    {% for child in resource.children -%}
    private _{{ child.accessor | to_lower_camel_case }}?: {{ child.name | to_upper_camel_case }};
    {% endfor -%}

    /** @internal */
    public constructor(private readonly requestCtx: {{ sdk.client_name }}RequestContext) {}

    {% set extension %}extensions/{{ resource.path | join(".") }}.ts{% endset -%}
    {% include extension ignore missing %}

    {% for child in resource.children -%}
    /** The {{ child.accessor | replace("_", " ") }} operations. */
    public get {{ child.accessor | to_lower_camel_case }}(): {{ child.name | to_upper_camel_case }} {
        this._{{ child.accessor | to_lower_camel_case }} ??= new {{ child.name | to_upper_camel_case }}(this.requestCtx);
        return this._{{ child.accessor | to_lower_camel_case }};
    }

    {% endfor -%}

    {% for op in resource.operations -%}
        {% if op.response_is_event_stream and op.event_schema_name is defined -%}
            {% set response_type = runtime("Stream") ~ "<" ~ (op.event_schema_name | to_upper_camel_case) ~ ">" -%}
        {% elif op.response_is_event_stream -%}
            {% set response_type = runtime("EventStream") -%}
        {% elif op.response_is_binary | default(false) -%}
            {% set response_type = "Uint8Array" -%}
        {% elif op.response_is_text | default(false) -%}
            {% set response_type = "string" -%}
        {% elif op.response_body_json_type is defined -%}
            {% set response_type = m.js_type(op.response_body_json_type) -%}
        {% elif op.response_body_schema_name is defined -%}
            {% set response_type = op.response_body_schema_name | to_upper_camel_case -%}
            {% if op.response_body_is_list %}{% set response_type = response_type ~ "[]" %}{% endif -%}
        {% else -%}
            {% set response_type = "void" -%}
        {% endif -%}
        {% set may_be_empty = op.response_may_be_empty | default(false) and op.pagination is not defined and (op.response_body_schema_name is defined or op.response_body_json_type is defined) -%}
        {% if may_be_empty -%}
            {% set response_type = response_type ~ " | undefined" -%}
        {% endif -%}
        {% set method = op.name | ident("camel") -%}
        {% set options_ty = resource_type_name ~ (op.name | to_upper_camel_case) ~ "Options" -%}

        {% set body_arg = "body" -%}
        {% if op.request_body_schema_name is defined -%}
            {% set body_arg = op.request_body_schema_name | ident("camel", "typescript") -%}
            {% if body_arg in ["request", "options", "requestOptions"] or body_arg in (op.path_params | map("ident", "camel", "typescript") | list) %}{% set body_arg = "body" %}{% endif -%}
        {% endif -%}
        {#- The parameters, and the arguments passing them on. -#}
        {% set params -%}
            {#- A path parameter of another style, or a list, object or JSON value, takes its type. -#}
            {% for p in op.typed_path_params -%}
                {{ p.name | ident("camel", "typescript") }}: {% if p.name in op.path_styles and op.path_styles[p.name].type is defined %}{{ m.js_type(op.path_styles[p.name].type) }}{% else %}{{ text_type(p.type) }}{% endif %},
            {% endfor -%}
            {% if op.request_body_schema_name is defined -%}
                {{ body_arg }}: {{ op.request_body_schema_name | to_upper_camel_case }}{% if op.request_body_is_list %}[]{% endif %},
            {% elif op.request_body_json_type is defined -%}
                body: {{ m.js_type(op.request_body_json_type) }},
            {% elif op.request_body_kind in ["binary", "multipart"] -%}
                {% set body_ty = "UploadBody" if op.request_body_kind == "binary" else resource_type_name ~ (op.name | to_upper_camel_case) ~ "Body" -%}
                {% if not op.request_body_optional -%}
                body: {{ body_ty }},
                {% elif op | has_required_query_or_header_params -%}
                body: {{ body_ty }} | undefined,
                {% else -%}
                body?: {{ body_ty }},
                {% endif -%}
            {% endif -%}
            {% if op | has_query_or_header_params -%}
                options{% if not op | has_required_query_or_header_params %}?{% endif %}: {{ options_ty }},
            {% endif -%}
            requestOptions?: RequestOptions,
        {%- endset -%}
        {% set leading_args -%}
            {% for p in op.path_params %}{{ p | ident("camel", "typescript") }}, {% endfor -%}
            {% if op.request_body_schema_name is defined or op.request_body_json_type is defined or op.request_body_kind in ["binary", "multipart"] %}{{ body_arg }}, {% endif -%}
        {%- endset -%}

        {% if op.pagination is defined -%}
        {% set pg = op.pagination -%}
        {% set item_type = pg.item_schema | to_upper_camel_case -%}
        {% set page_type = op.response_body_schema_name | to_upper_camel_case -%}
        {% set pf = namespace(name=pg.param) -%}
        {% for p in op.query_params if p.name == pg.param %}{% set pf.name = p.ident %}{% endfor -%}
        {% set param_field = pf.name | ident("camel") -%}
        {% if pg.before is defined -%}
        {% set bf = namespace(name=pg.before) -%}
        {% for p in op.query_params if p.name == pg.before %}{% set bf.name = p.ident %}{% endfor -%}
        {% set before_field = bf.name | ident("camel") -%}
        {% endif -%}
        {% set pv = namespace(value=pg.style) -%}
        {% for p in op.query_params if p.name == pg.param and pg.style != "cursor" and m.is_int64(p.type) -%}
            {% set pv.value = ("BigInt(" if sdk.int64 == "bigint" else "String(") ~ pg.style ~ ")" -%}
        {% endfor -%}
        {{ op_doc(op, "Await it for the first page: the response body, its properties read on the page, with\n`items`, `hasNextPage()`, `getNextPage()` and `iterPages()`. Or iterate it with `for await`\nover every item of every page, fetched on demand." ~ ("\nSetting `" ~ before_field ~ "` pages backwards, each page ending before the first item of the last." if pg.before is defined else "")) }}public {{ method }}({{ params }}): {{ runtime("PagePromise") }}<{{ page_type }}, {{ item_type }}> {
            {% if pg.before is defined -%}
            const backwards = options?.{{ before_field }} !== undefined && options?.{{ before_field }} !== null;
            {% endif -%}
            return new {{ runtime("PagePromise") }}<{{ page_type }}, {{ item_type }}>(
                {
                    style: "{{ pg.style }}",
                    items: (page) => {{ at(pg.items) }},
                    {% if pg.has_more is defined -%}
                    hasMore: (page) => {{ at(pg.has_more) }},
                    {% endif -%}
                    {% if pg.next_cursor is defined -%}
                    nextCursor: (page) => {{ at(pg.next_cursor) }},
                    {% elif pg.item_cursor is defined -%}
                    nextCursor: (_page, items) => {% if pg.before is defined %}(backwards ? items[0] : items[items.length - 1]){% else %}items[items.length - 1]{% endif %}?.{{ pg.item_cursor | ident("camel") }},
                    {% endif -%}
                    {% if pg.total_pages is defined -%}
                    totalPages: (page) => {{ at(pg.total_pages) }},
                    {% endif -%}
                    {% if pg.total is defined -%}
                    total: (page) => {{ at(pg.total) }},
                    {% endif -%}
                    {% if pg.style == "page" -%}
                    firstPage: {{ pg.first_page }},
                    {% endif -%}
                    fetch: ({{ pg.style }}) => this.#{{ method }}({{ leading_args }}
                        {%- if pg.style == "cursor" %}cursor === undefined ? options : {% endif %}
                        {%- if pg.before is defined %}backwards ? { ...options, {{ before_field }}: cursor } : {% endif %}{ ...options, {{ param_field }}: {{ pv.value }} },
                        requestOptions,
                    ),
                },
                {% if pg.before is defined %}backwards ? options?.{{ before_field }} : {% endif %}options?.{{ param_field }},
            );
        }

        #{{ method }}({{ params }}): {{ runtime("APIPromise") }}<{{ page_type }}> {
        {% else -%}
        {{ op_doc(op) }}public {{ method }}({{ params }}): {{ runtime("APIPromise") }}<{{ response_type }}> {
        {% endif -%}
            const request = new {{ sdk.client_name }}Request("{{ op.method | upper }}", {{ op.path | tojson }});

            {% for p in op.path_params -%}
                {% if p in op.path_styles -%}
                {% set ps = op.path_styles[p] -%}
                {% set arg = p | ident("camel", "typescript") -%}
                request.setStyledPathParam({{ p | tojson }}, {% if ps.type is defined and m.converted(ps.type, true) %}{{ m.to_json(arg, ps.type) }}{% else %}{{ arg }}{% endif %}, {{ ps.style | tojson }}, {{ ps.explode | lower }});
                {% else -%}
                request.setPathParam({{ p | tojson }}, {{ p | ident("camel", "typescript") }});
                {% endif -%}
            {% endfor -%}
            {% if op.security is defined -%}
                request.setSecurity({{ op.security | tojson }});
            {% endif -%}
            {% if op.id in errs.ops -%}
                request.setErrors({
                    {% for status, schema in op.errors | items -%}
                    {{ status | tojson }}: {{ schema | to_upper_camel_case }}Serializer.parse,
                    {% endfor -%}
                });
            {% endif -%}

            {% for p in op.query_params -%}
                {% set accessor %}options{% if not p.required %}?{% endif %}.{{ p.ident | ident("camel") }}{% endset -%}
                {% set ptype = p.typed_union if p.typed_union is defined and not unimported(p.typed_union) else p.type -%}
                {% if p.structured -%}
                    {% set value = accessor if not m.converted(ptype, true) else accessor ~ " != null ? " ~ m.to_json("options." ~ (p.ident | ident("camel")), ptype) ~ " : undefined" -%}
                    {% if p.json -%}
                    request.setJsonQueryParam({{ p.name | tojson }}, {{ value }});
                    {% elif p.delimiter is defined -%}
                    request.setDelimitedQueryParam({{ p.name | tojson }}, {{ value }}, {{ p.delimiter | tojson }});
                    {% else -%}
                    request.setStructuredQueryParam({{ p.name | tojson }}, {{ value }}, {{ p.deep_object | lower }}, {{ p.explode | lower }});
                    {% endif -%}
                {% elif (p.type.is_list() or p.type.is_set()) and p.explode | default(true) -%}
                    request.setExplodedQueryParam({{ p.name | tojson }}, {{ accessor }});
                {% else -%}
                    request.setQueryParam({{ p.name | tojson }}, {{ accessor }});
                {% endif -%}
            {% endfor -%}

            {% for p in op.header_params -%}
                {% set accessor %}options{% if not p.required %}?{% endif %}.{{ p.ident | ident("camel") }}{% endset -%}
                {% if p.json -%}
                request.setJsonHeaderParam({{ p.name | tojson }}, {% if m.converted(p.type, true) %}{{ accessor }} != null ? {{ m.to_json("options." ~ (p.ident | ident("camel")), p.type) }} : undefined{% else %}{{ accessor }}{% endif %});
                {% else -%}
                request.set{{ "Cookie" if p.cookie else "Header" }}Param({{ p.name | tojson }}, {{ accessor }});
                {% endif -%}
            {% endfor -%}

            {% if op.request_body_schema_name is defined -%}
                {% set serializer = (op.request_body_schema_name | to_upper_camel_case) ~ "Serializer" -%}
