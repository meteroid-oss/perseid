{% import "types/macros.ts.jinja" as m -%}
{% for c in referenced_components -%}
import { type {{ c | to_upper_camel_case }}, {{ c | to_upper_camel_case }}Serializer } from "./{{ c | to_lower_camel_case }}.js";
{% endfor -%}
{% for c in union_refs | default([]) if c != type.name -%}
import { type {{ c | to_upper_camel_case }}, {{ c | to_upper_camel_case }}Serializer } from "./{{ c | to_lower_camel_case }}.js";
{% endfor -%}

{% set type_name = type.name | to_upper_camel_case -%}
{% set ns = namespace(bases=[]) -%}
{% for field in type.fields if field.flatten %}{% set ns.bases = ns.bases + [field.type.to_js()] %}{% endfor -%}
{% set base_names = ns.bases -%}

{#- Own fields that redeclare an inherited one are left out of the base with `Omit`, and a
    base that is not an object (a union) is intersected rather than extended. -#}
{% set overridden = type.fields | rejectattr("flatten") | map(attribute="name") | select("in", inherited_fields) | list -%}
{% set omitted = overridden | map("ident", "camel") | map("tojson") | join(" | ") -%}
{% set ns.parents = [] -%}
{% for base in base_names %}{% set ns.parents = ns.parents + ["Omit<" ~ base ~ ", " ~ omitted ~ ">" if overridden else base] %}{% endfor -%}

{{ doc_comment }}
{% set intersect = base_names | select("in", non_struct_refs) | list -%}
{% if intersect -%}
export type {{ type_name }} = {{ ns.parents | join(" & ") }} & {
{%- else -%}
export interface {{ type_name }}{% if base_names %} extends {{ ns.parents | join(", ") }}{% endif %} {
{%- endif %}
    {% for field in type.fields if not field.flatten -%}
    {{ m.field_decl(field) }}
    {% endfor -%}
}{% if intersect %};{% endif %}

export const {{ type_name }}Serializer = {
    parse(json: any): {{ type_name }} {
        return {
            {%- for base in base_names %}
            ...{{ base }}Serializer.parse(json),
            {%- endfor %}
            {{- m.parse_fields(type.fields, "json", type.discriminator_defaults | default({})) }}
        };
    },

    serialize(value: {{ type_name }}): any {
        return {
            {%- for base in base_names %}
            ...{{ base }}Serializer.serialize({% if overridden %}value as unknown as {{ base }}{% else %}value{% endif %}),
            {%- endfor %}
            {{- m.serialize_fields(type.fields, "value", type.discriminator_defaults | default({})) }}
        };
    },
{{ m.legacy_aliases(type_name) }}
};
