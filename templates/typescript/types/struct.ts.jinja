{% import "types/macros.ts.jinja" as m -%}
{% for c in referenced_components -%}
import { type {{ c | to_upper_camel_case }}, {{ c | to_upper_camel_case }}Serializer } from "./{{ c | to_lower_camel_case }}.js";
{% endfor -%}
{% for c in union_refs | default([]) if c != type.name and c not in referenced_components -%}
import { type {{ c | to_upper_camel_case }}, {{ c | to_upper_camel_case }}Serializer } from "./{{ c | to_lower_camel_case }}.js";
{% endfor -%}

{% set type_name = type.name | to_upper_camel_case -%}
{% set ns = namespace(bases=[]) -%}
{% for field in type.fields if field.flatten %}{% set ns.bases = ns.bases + [field.type.to_js()] %}{% endfor -%}
{% set base_names = ns.bases -%}

{#- Own fields that redeclare an inherited one are left out of the base with `Omit`, and a
    base that is not an object (a union) is intersected rather than extended. -#}
{% set overridden = type.fields | rejectattr("flatten") | map(attribute="name") | select("in", inherited_fields) | list -%}
{% set omitted = overridden | map("ident", "camel") | map("tojson") | join(" | ") -%}
{% set ns.parents = [] -%}
{% for base in base_names %}{% set ns.parents = ns.parents + ["Omit<" ~ base ~ ", " ~ omitted ~ ">" if overridden else base] %}{% endfor -%}

{{ doc_comment }}
{% set intersect = base_names | select("in", non_struct_refs) | list -%}
{% if intersect -%}
export type {{ type_name }} = {{ ns.parents | join(" & ") }} & {
{%- else -%}
export interface {{ type_name }}{% if base_names %} extends {{ ns.parents | join(", ") }}{% endif %} {
{%- endif %}
    {% for field in type.fields if not field.flatten -%}
    {{ m.field_decl(field) }}
    {% endfor -%}
    {% set extra_value = type.additional_properties.value_type() if type.additional_properties is defined else none -%}
    {% if extra_value is not none and not extra_value.is_json_object() and not base_names -%}
    {#- An index signature takes the types of the declared properties too. -#}
    {% set index = namespace(types=[m.js_type(extra_value)]) -%}
    {% for field in type.fields -%}
    {% set index.types = index.types + [m.field_type(field)] + ([] if field.required else ["undefined"]) -%}
    {% endfor -%}
    /** The properties beyond the declared ones, as the schema's `additionalProperties` types them. */
    [key: string]: {{ index.types | unique | join(" | ") }};
    {% endif -%}
}{% if intersect %};{% endif %}

{# Properties this SDK version does not know are kept as received, under their JSON names, and
    sent back. A base that is not an object (a union) has no fixed properties to tell apart. -#}
{% set extras = not intersect -%}
{% set inherited = inherited_fields | list -%}
{#- A typed `additionalProperties` converts the values of those properties. -#}
{% set extra_ty = type.additional_properties.value_type() if type.additional_properties is defined else none -%}
{% set parse_extra = (", (item: any) => " ~ m.from_json("item", extra_ty)) if extra_ty is not none and m.converted(extra_ty) else "" -%}
{% set serialize_extra = (", (item: any) => " ~ m.to_json("item", extra_ty)) if extra_ty is not none and m.converted(extra_ty, true) else "" -%}
/** Converts `{{ type_name }}` values from (`parse`) and to (`serialize`) their JSON form. */
export const {{ type_name }}Serializer = {
    parse(json: any): {{ type_name }} {
        return {
            {%- if extras %}
            ...extraProperties(json, {{ m.names(type.fields, false, inherited) }}{{ parse_extra }}),
            {%- endif %}
            {%- for base in base_names %}
            ...{% if extras %}pickProperties({{ base }}Serializer.parse(json), {{ m.names([], true, inherited) }}){% else %}{{ base }}Serializer.parse(json){% endif %},
            {%- endfor %}
            {{- m.parse_fields(type.fields, "json", type.discriminator_defaults | default({})) }}
        };
    },

    serialize(value: {{ type_name }}): any {
        return {
            {%- if extras %}
            ...extraProperties(value, {{ m.names(type.fields, true, inherited) }}{{ serialize_extra }}),
            {%- endif %}
            {%- for base in base_names %}
            {%- set serialized %}{{ base }}Serializer.serialize({% if overridden %}value as unknown as {{ base }}{% else %}value{% endif %}){% endset %}
            ...{% if extras %}pickProperties({{ serialized }}, {{ m.names([], false, inherited) }}){% else %}{{ serialized }}{% endif %},
            {%- endfor %}
            {{- m.serialize_fields(type.fields, "value", type.discriminator_defaults | default({})) }}
        };
    },
};
