{#
    Shared helpers for the TypeScript templates. `from_json` / `to_json` render the expression
    converting a value between its JSON wire form and its TypeScript form.
-#}

{% macro is_int64(type) -%}
    {%- if sdk.int64 | default("number") != "number" and type.to_go() in ["int64", "uint64"] %}yes{% endif -%}
{%- endmacro %}

{# `unknown` for any-JSON values, so callers narrow them before use. The enums of `received`,
   in the models only responses carry, also take the values a later API version adds. -#}
{% macro js_type(type, received=[]) -%}
    {%- if type.is_nullable() -%}
        {{ js_type(type.inner_type(), received) }} | null
    {%- elif type.is_union() -%}
        {%- for v in type.union_variants() -%}
            {% if not loop.first %} | {% endif %}{% if v.empty %}""{% elif untyped_int64(v) %}{{ untyped_js_type(v.type) }}{% else %}{{ js_type(v.type, received) }}{% endif %}
        {%- endfor -%}
    {%- elif type.is_json_object() -%}
        unknown
    {%- elif is_int64(type) -%}
        {{ sdk.int64 }}
    {%- elif type.is_list() or type.is_set() -%}
        {% if type.inner_type().is_union() or type.inner_type().is_nullable() %}({{ js_type(type.inner_type(), received) }})[]{% else %}{{ js_type(type.inner_type(), received) }}[]{% endif %}
    {%- elif type.is_map() -%}
        { [key: string]: {{ js_type(type.value_type(), received) }} }
    {%- elif type.is_schema_ref() and type.to_js() in received -%}
        ({{ type.to_js() }} | (string & {}))
    {%- else -%}
        {{ type.to_js() }}
    {%- endif -%}
{%- endmacro %}

{% macro field_type(field, received=[]) -%}
    {{- field.literal | tojson if field.literal is defined else js_type(field.type, received) }}{% if field.nullable %} | null{% endif -%}
{%- endmacro %}

{% macro doc(description, deprecated) -%}
    {%- if description is defined and description -%}
        {{ description | with_javadoc_deprecation(deprecated) | to_doc_comment(style="js") }}
    {% elif deprecated -%}
        /** @deprecated */
    {% endif -%}
{%- endmacro %}

{# Optional fields also take `undefined`, which parsing leaves in absent fields. -#}
{% macro field_decl(field, received=[]) -%}
    {{ doc(field.description, field.deprecated) }}{{ field.name | ident("camel") }}{% if not field.required %}?{% endif %}: {{ field_type(field, received) }}{% if not field.required %} | undefined{% endif %};
{%- endmacro %}

{#- The int64 values of a union variant, alone or in lists and maps, stay numbers, or `bigint`
    beyond 2^53, when int64 values are strings, which would read as a string variant. -#}
{% macro untyped_int64(variant) -%}
    {%- if sdk.int64 | default("number") == "string" and int64_leaf(variant.type) %}yes{% endif -%}
{%- endmacro %}

{% macro int64_leaf(type) -%}
    {%- if type.is_list() or type.is_set() -%}{{ int64_leaf(type.inner_type()) }}
    {%- elif type.is_map() -%}{{ int64_leaf(type.value_type()) }}
    {%- else -%}{{ is_int64(type) }}{%- endif -%}
{%- endmacro %}

{% macro untyped_js_type(type) -%}
    {%- if type.is_list() or type.is_set() -%}({{ untyped_js_type(type.inner_type()) }})[]
    {%- elif type.is_map() -%}{ [key: string]: {{ untyped_js_type(type.value_type()) }} }
    {%- else -%}number | bigint{%- endif -%}
{%- endmacro %}

{% macro variant_converted(variant, outgoing) -%}
    {%- if not untyped_int64(variant) %}{{ converted(variant.type, outgoing) }}{% endif -%}
{%- endmacro %}

{#- The test that a value, on the wire or in its TypeScript form, holds the union variant
    of `json_type`. -#}
{% macro is_variant(expr, json_type) -%}
    {%- if json_type == "array" -%}
        Array.isArray({{ expr }})
    {%- elif json_type == "object" -%}
        isJsonObject({{ expr }})
    {%- elif json_type == "integer" and sdk.int64 | default("number") != "number" -%}
        {#- `parseJson` reads the integers beyond `Number.MAX_SAFE_INTEGER` as `bigint`. -#}
        (typeof {{ expr }} === "number" || typeof {{ expr }} === "bigint")
    {%- else -%}
        typeof {{ expr }} === "{{ "number" if json_type == "integer" else json_type }}"
    {%- endif -%}
{%- endmacro %}

{# `yes` when values of `type` need converting from JSON, or to JSON with `outgoing`. -#}
{% macro converted(type, outgoing=false) -%}
    {%- if type.is_nullable() -%}
        {{ converted(type.inner_type(), outgoing) }}
    {%- elif type.is_union() -%}
        {%- for v in type.union_variants() if variant_converted(v, outgoing) %}{% if loop.first %}yes{% endif %}{% endfor -%}
    {%- elif type.is_schema_ref() -%}
        yes
    {%- elif outgoing and is_int64(type) and sdk.int64 == "string" -%}
        yes
    {%- elif not outgoing and (type.is_datetime() or is_int64(type)) -%}
        yes
    {%- elif type.is_list() or type.is_set() -%}
        {{ converted(type.inner_type(), outgoing) }}
    {%- elif type.is_map() -%}
        {{ converted(type.value_type(), outgoing) }}
    {%- endif -%}
{%- endmacro %}

{# `yes` when parsing values of `type` checks or converts them: all but untyped JSON, and the
   unions with nothing to convert, which are kept as received. -#}
{% macro checked(type) -%}
    {%- if type.is_nullable() -%}
        {{ checked(type.inner_type()) }}
    {%- elif type.is_union() -%}
        {{ converted(type) }}
    {%- elif not type.is_json_object() -%}
        yes
    {%- endif -%}
{%- endmacro %}

{#- The conversion of the object `expr` to or from the object variant of the union `type` it
    is: the first whose conditions it meets, or the best match. Other objects are kept as is. -#}
{% macro pick_object(expr, type, outgoing, p, k) -%}
    {%- set candidates = type.object_variants() -%}
    {%- macro convert(v) -%}
        {%- if outgoing -%}{{ to_json("(" ~ expr ~ " as " ~ js_type(v.type) ~ ")", v.type) }}{%- else -%}{{ from_json(expr, v.type, p, k) }}{%- endif -%}
    {%- endmacro -%}
    {%- macro name(p) -%}{{ p | ident("camel") if outgoing else p }}{%- endmacro -%}
    {%- if type.union_mode() == "rules" -%}
        ({% for v in candidates %}{% for c in v.when %}{% if not loop.first %} && {% endif %}unionHas({{ expr }}, {{ name(c.property) | tojson }}{% if c.value is defined %}, {{ c.value | tojson }}{% endif %}){% else %}true{% endfor %} ? {{ convert(v) }} : {% endfor %}{{ expr }})
    {%- else -%}
        ((variant: number) => {% for v in candidates %}variant === {{ loop.index0 }} ? {{ convert(v) }} : {% endfor %}{{ expr }})(unionBestMatch({{ expr }}, [{% for v in candidates %}[[{% for p in v.required %}{{ name(p) | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}], [{% for p in v.properties %}{{ name(p) | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}]]{% if not loop.last %}, {% endif %}{% endfor %}]))
    {%- endif -%}
{%- endmacro %}

{#- The wire shape of the items of a list variant, as the `UnionShape` literal. -#}
{% macro shape(items) -%}
    { type: "{{ items.json_type }}"{% if items["items"] is defined and items["items"] %}, items: {{ shape(items["items"]) }}{% endif %} }
{%- endmacro %}

{#- The union conversion of `expr` when variants share a JSON type: `unionTry` tries the
    variants in order, each as its shape, rules or property sets, and conversion. -#}
{% macro union_try(expr, type, outgoing, p, k) -%}
    {%- macro name(p) -%}{{ p | ident("camel") if outgoing else p }}{%- endmacro -%}
    {%- set mode = type.union_mode() -%}
    unionTry({{ expr }}, [
        {%- for v in type.try_variants() -%}
        { type: "{{ v.json_type }}"
            {%- if v["items"] is defined and v["items"] %}, items: {{ shape(v["items"]) }}{% endif -%}
            {%- if v.empty %}, empty: true{% endif -%}
            {%- if mode == "rules" and v.json_type == "object" and v.when %}, when: [{% for c in v.when %}[{{ name(c.property) | tojson }}{% if c.value is defined %}, {{ c.value | tojson }}{% endif %}]{% if not loop.last %}, {% endif %}{% endfor %}]{% endif -%}
            {%- if mode == "best-match" and v.json_type == "object" %}, required: [{% for p in v.required %}{{ name(p) | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}], known: [{% for p in v.properties %}{{ name(p) | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif -%}
            , parse: (part: any) => {% if variant_converted(v, outgoing) %}{{ to_json("part", v.type) if outgoing else from_json("part", v.type, p, k) }}{% else %}part{% endif %} }
            {%- if not loop.last %}, {% endif -%}
        {%- endfor -%}
    ], {{ (mode | tojson) if mode in ["rules", "best-match"] else "undefined" }}, {{ "true" if outgoing else "false" }})
{%- endmacro %}

{#- The union conversion of `expr`, by JSON type, then among objects by `pick_object`. -#}
{% macro union_json(expr, type, outgoing, p=none, k=none) -%}
    {%- if type.union_decode() == "try" -%}
    {{ union_try(expr, type, outgoing, p, k) }}
    {%- else -%}
    {%- set objects = type.union_mode() != "json" -%}
    ({% if objects %}isJsonObject({{ expr }}) ? {{ pick_object(expr, type, outgoing, p, k) }} : {% endif %}{% for v in type.union_variants() if variant_converted(v, outgoing) and not (objects and v.json_type == "object") %}{{ is_variant(expr, v.json_type) }} ? {{ to_json(expr, v.type) if outgoing else from_json(expr, v.type, p, k) }} : {% endfor %}{{ expr }})
    {%- endif -%}
{%- endmacro %}

{#- The parsing of the JSON value `expr`, the one at key `k` of the value at path `p` (both
    TypeScript expressions), checked against `type` and converted to its TypeScript form. -#}
{% macro from_json(expr, type, p, k) -%}
    {%- set at %}{{ expr }}, {{ p }}, {{ k }}{% endset -%}
    {%- if type.is_nullable() -%}
        {%- if checked(type) %}({{ expr }} == null ? null : {{ from_json(expr, type.inner_type(), p, k) }}){% else %}{{ expr }}{% endif -%}
    {%- elif type.is_union() -%}
        {%- if converted(type) %}{{ union_json(expr, type, false, p, k) }}{% else %}{{ expr }}{% endif -%}
    {%- elif type.is_json_object() -%}
        {{ expr }}
    {%- elif type.is_datetime() -%}
        decodeDateTime({{ at }})
    {%- elif type.is_schema_ref() -%}
        {{ type.to_js() }}Serializer.parse({{ expr }}, {% if k == "undefined" %}{{ p }}{% else %}decodePath({{ p }}, {{ k }}){% endif %})
    {%- elif is_int64(type) -%}
        {{ "BigInt" if sdk.int64 == "bigint" else "String" }}(decodeInteger({{ at }}))
    {%- elif type.is_map() -%}
        decodeMap({{ at }}, {% if checked(type.value_type()) %}(entry: any, p: string, key: string) => {{ from_json("entry", type.value_type(), "p", "key") }}{% else %}(entry: any) => entry{% endif %})
    {%- elif type.is_list() or type.is_set() -%}
        decodeList({{ at }}, {% if checked(type.inner_type()) %}(item: any, p: string, i: number) => {{ from_json("item", type.inner_type(), "p", "i") }}{% else %}(item: any) => item{% endif %})
    {%- elif type.to_js() == "boolean" -%}
        decodeBoolean({{ at }})
    {%- elif type.to_js() == "number" -%}
        {{ "decodeInteger" if type.is_int_or_uint() else "decodeNumber" }}({{ at }})
    {%- elif type.to_js() == "string" -%}
        decodeString({{ at }})
    {%- else -%}
        {{ expr }}
    {%- endif -%}
{%- endmacro %}

{# Dates are left to `JSON.stringify`, which calls `toISOString`. -#}
{% macro to_json(expr, type) -%}
    {%- if type.is_nullable() -%}
        {%- if converted(type, true) %}({{ expr }} == null ? null : {{ to_json(expr, type.inner_type()) }}){% else %}{{ expr }}{% endif -%}
    {%- elif type.is_union() and converted(type, true) -%}
        {{ union_json(expr, type, true) }}
    {%- elif type.is_schema_ref() -%}
        {{ type.to_js() }}Serializer.serialize({{ expr }})
    {%- elif is_int64(type) and sdk.int64 == "string" -%}
        BigInt({{ expr }})
    {%- elif not converted(type, true) -%}
        {{ expr }}
    {%- elif type.is_map() -%}
        Object.fromEntries(Object.entries({{ expr }}).map(([key, entry]) => [key, {{ to_json("entry", type.value_type()) }}]))
    {%- else -%}
        {{ expr }}.map((item: any) => {{ to_json("item", type.inner_type()) }})
    {%- endif -%}
{%- endmacro %}

{# Absent and null values are passed through, keeping `null` for nullable fields only. A
   union's conversion already passes them through. -#}
{% macro guarded(expr, field, conversion, outgoing) -%}
    {%- set needed = converted(field.type, true) if outgoing else checked(field.type) -%}
    {%- if needed and (not field.required or field.nullable) and not (field.nullable and field.type.is_union()) -%}
        {{ expr }} != null ? {{ conversion }} : {{ expr if field.nullable else "undefined" }}
    {%- else -%}
        {{ conversion }}
    {%- endif -%}
{%- endmacro %}

{#- A missing field with a `fallback` (JSON) value takes it. Unions, which keep what no variant
    holds, are checked to be present here. -#}
{% macro field_from_json(json, field, p="path", fallback=none) -%}
    {#- `json["constructor"]` reads `Object.prototype` when the JSON has no such own property. -#}
    {%- if field.name in ["__proto__", "__defineGetter__", "__defineSetter__", "__lookupGetter__", "__lookupSetter__", "constructor", "hasOwnProperty", "isPrototypeOf", "propertyIsEnumerable", "toLocaleString", "toString", "valueOf"] -%}
    {%- set expr %}(Object.prototype.hasOwnProperty.call({{ json }}, {{ field.name | tojson }}) ? {{ json }}[{{ field.name | tojson }}] : undefined){% endset -%}
    {%- else -%}
    {%- set expr %}{{ json }}[{{ field.name | tojson }}]{% endset -%}
    {%- endif -%}
    {%- set key = field.name | tojson -%}
    {%- set conversion = from_json(expr, field.type, p, key) -%}
    {%- if field.literal is defined and checked(field.type) %}{% set conversion %}({{ conversion }} as {{ field_type(field) }}){% endset %}{% endif -%}
    {%- if fallback is not none -%}
    {% if checked(field.type) %}{{ expr }} != null ? {{ conversion }} : {{ fallback | tojson }}{% else %}{{ expr }} ?? {{ fallback | tojson }}{% endif %}
    {%- elif field.required and not (field.nullable or field.type.is_nullable()) and field.type.is_union() -%}
    decodeRequired({{ conversion }}, {{ p }}, {{ key }})
    {%- else -%}
    {{ guarded(expr, field, conversion, false) }}
    {%- endif -%}
{%- endmacro %}

{% macro field_to_json(value, field) -%}
    {%- set expr %}{{ value }}.{{ field.name | ident("camel") }}{% endset -%}
    {{ guarded(expr, field, to_json(expr, field.type), true) }}
{%- endmacro %}

{#- The object literal members parsing `fields` out of `json`. `defaults` fills the
    discriminator of a union variant model when it is missing. -#}
{% macro parse_fields(fields, json, defaults={}, p="path") -%}
    {%- for field in fields if not field.flatten %}
    {{ field.name | ident("camel") }}: {{ field_from_json(json, field, p, defaults[field.name] if field.name in defaults else none) }},
    {%- endfor %}
{%- endmacro %}

{#- A `__proto__` key is computed: written plainly, it would set the object's prototype. -#}
{% macro serialize_fields(fields, value, defaults={}) -%}
    {%- for field in fields if not field.flatten %}
    {% if field.name == "__proto__" %}["__proto__"]{% else %}{{ field.name | tojson }}{% endif %}: {{ field_to_json(value, field) }}{% if field.name in defaults %} ?? {{ defaults[field.name] | tojson }}{% endif %},
    {%- endfor %}
{%- endmacro %}

{#- The names of `fields` as a list literal: the JSON names, or the TypeScript ones with `ts`. -#}
{% macro names(fields, ts=false, extra=[]) -%}
    [{% for name in (fields | rejectattr("flatten") | map(attribute="name") | list) + extra %}{{ (name | ident("camel") if ts else name) | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endmacro %}
