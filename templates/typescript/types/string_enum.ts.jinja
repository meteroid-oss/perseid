{% set type_name = type.name | to_upper_camel_case -%}
{% set members = type.values | idents("pascal", none, "schema `" ~ type.name ~ "`") -%}
{{ doc_comment }}
export const {{ type_name }} = {
    {% for value in type.values -%}
    {{ members[loop.index0] }}: {{ value | tojson }},
    {% endfor -%}
} as const;

export type {{ type_name }} = (typeof {{ type_name }})[keyof typeof {{ type_name }}];

/** Converts `{{ type_name }}` values from (`parse`) and to (`serialize`) their JSON form. */
export const {{ type_name }}Serializer = {
    parse(json: any): {{ type_name }} {
        return json;
    },

    serialize(value: {{ type_name }}): any {
        return value;
    },
};
