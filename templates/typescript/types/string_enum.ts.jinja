{% set type_name = type.name | to_upper_camel_case -%}
{% set members = type.values | enum_names | idents("pascal", none, "schema `" ~ type.name ~ "`") -%}
{{ doc_comment }}
export const {{ type_name }} = {
    {% for value in type.values -%}
    {{ members[loop.index0] }}: {{ value | tojson }},
    {% endfor -%}
} as const;

{#- An open enum (any string, in the spec) takes values this SDK version does not list, and
    `string & {}` keeps the editor's completion of the known ones. A closed one takes its values,
    though parsing keeps those a later API version adds, as the models of responses type them. -#}
export type {{ type_name }} = (typeof {{ type_name }})[keyof typeof {{ type_name }}]{% if type.open %} | (string & {}){% endif %};

/** Converts `{{ type_name }}` values from (`parse`) and to (`serialize`) their JSON form. */
export const {{ type_name }}Serializer = {
    parse(json: any, path = "$"): {{ type_name }} {
        return decodeString(json, path){% if not type.open %} as {{ type_name }}{% endif %};
    },

    serialize(value: {{ type_name }}{% if not type.open %} | (string & {}){% endif %}): any {
        return value;
    },
};
