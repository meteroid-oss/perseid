{% import "types/macros.ts.jinja" as m -%}
{% for c in referenced_components -%}
import { type {{ c | to_upper_camel_case }}, {{ c | to_upper_camel_case }}Serializer } from "./{{ c | to_lower_camel_case }}.js";
{% endfor -%}
{% for c in union_refs | default([]) if c != type.name and c not in referenced_components -%}
import { type {{ c | to_upper_camel_case }}, {{ c | to_upper_camel_case }}Serializer } from "./{{ c | to_lower_camel_case }}.js";
{% endfor %}

{% if type.repr != "internally_tagged" and type.repr != "adjacently_tagged" -%}
{{ panic("typescript codegen: unsupported struct enum representation `" ~ type.repr ~ "` for type `" ~ type.name ~ "`") }}
{% endif -%}

{% set type_name = type.name | to_upper_camel_case -%}
{% set disc_json = type.discriminator_field -%}
{% set disc = disc_json | ident("camel") -%}
{% set adjacent = type.repr == "adjacently_tagged" -%}
{% set content_json = type.content_field if adjacent else "" -%}
{% set content = content_json | ident("camel") if adjacent else "" -%}
{% set base = "_" ~ type_name ~ "Base" if type.fields else "" -%}
{% set ns = namespace(taken=[], members=[]) -%}
{% for c in referenced_components %}{% set ns.taken = ns.taken + [c | to_upper_camel_case] %}{% endfor -%}

{% if base -%}
interface {{ base }} {
    {% for field in type.fields -%}
    {{ m.field_decl(field) }}
    {% endfor -%}
}
{% endif %}

{#- Each variant is `{Union}{Value}`, or an inline type where that name is already a model
    or the variant is not an object. -#}
{% for variant in type.variants -%}
{% set alias = type_name ~ (variant.name | to_upper_camel_case) -%}
{% set ref = variant.schema_ref | to_upper_camel_case if variant.type == "ref" and variant.schema_ref is defined else "" -%}
{% set fields = variant.fields if variant.type == "struct" and variant.fields is defined else [] -%}
{% if adjacent and fields -%}
export interface {{ alias }}{{ content_json | to_upper_camel_case }} {
    {% for field in fields -%}
    {{ m.field_decl(field) }}
    {% endfor -%}
}
{% endif -%}
{% set tag %}{{ disc }}: {{ variant.name | tojson }};{% endset -%}
{% if adjacent -%}
    {% set own %}{{ tag }}{% if ref %} {{ content }}: {{ ref }};{% elif fields %} {{ content }}: {{ alias }}{{ content_json | to_upper_camel_case }};{% endif %}{% endset -%}
    {% set parents = [base] if base else [] -%}
{% else -%}
    {% set own %}{{ tag }}{% for field in fields %}
    {{ m.field_decl(field) }}{% endfor %}{% endset -%}
    {% set parents = ([base] if base else []) + ([ref] if ref else []) -%}
{% endif -%}
{% if alias in ns.taken or ref in non_struct_refs -%}
    {% set ns.members = ns.members + ["(" ~ (parents + ["{ " ~ own ~ " }"]) | join(" & ") ~ ")"] -%}
{% else -%}
export interface {{ alias }}{% if parents %} extends {{ parents | join(", ") }}{% endif %} {
    {{ own }}
}
    {% set ns.members = ns.members + [alias] -%}
{% endif -%}
{% endfor %}

{{ doc_comment }}
export type {{ type_name }} =
    {%- for member in ns.members %}
    | {{ member }}
    {%- endfor %};

/** Converts `{{ type_name }}` values from (`parse`) and to (`serialize`) their JSON form. */
export const {{ type_name }}Serializer = {
    parse(json: any): {{ type_name }} {
        switch (json[{{ disc_json | tojson }}]) {
        {%- for variant in type.variants %}
            case {{ variant.name | tojson }}:
                return {
                    {% if adjacent -%}
                    ...extraProperties(json, {{ m.names(type.fields, false, [disc_json, content_json]) }}),
                    {% if variant.type == "ref" and variant.schema_ref is defined -%}
                    {{ content }}: {{ variant.schema_ref | to_upper_camel_case }}Serializer.parse(json[{{ content_json | tojson }}]),
                    {% elif variant.type == "struct" and variant.fields is defined and variant.fields -%}
                    {{ content }}: { {{- m.parse_fields(variant.fields, "json[" ~ (content_json | tojson) ~ "]") }} },
                    {% endif -%}
                    {% elif variant.type == "ref" and variant.schema_ref is defined -%}
                    {% set parsed %}{{ variant.schema_ref | to_upper_camel_case }}Serializer.parse(json){% endset -%}
                    ...{% if type.fields %}omitProperties({{ parsed }}, {{ m.names(type.fields) }}){% else %}{{ parsed }}{% endif %},
                    {% elif variant.type == "struct" and variant.fields is defined -%}
                    ...extraProperties(json, {{ m.names(variant.fields + type.fields, false, [disc_json]) }}),
                    {{- m.parse_fields(variant.fields, "json") }}
                    {% else -%}
                    ...extraProperties(json, {{ m.names(type.fields, false, [disc_json]) }}),
                    {% endif -%}
                    {% if type.fields %}{{ m.parse_fields(type.fields, "json") }}
                    {% endif -%}
                    {{ disc }}: {{ variant.name | tojson }},
                };
        {%- endfor %}
            default:
                // A variant added to the API after this SDK was generated, kept as received.
                return json;
        }
    },

    serialize(value: {{ type_name }}): any {
        switch (value.{{ disc }}) {
        {%- for variant in type.variants %}
            case {{ variant.name | tojson }}:
                return {
                    {% if adjacent -%}
                    ...extraProperties(value, {{ m.names(type.fields, true, [disc_json, content_json]) }}),
                    {% if variant.type == "ref" and variant.schema_ref is defined -%}
                    {{ content_json | tojson }}: {{ variant.schema_ref | to_upper_camel_case }}Serializer.serialize(value.{{ content }}),
                    {% elif variant.type == "struct" and variant.fields is defined and variant.fields -%}
                    {{ content_json | tojson }}: { {{- m.serialize_fields(variant.fields, "value." ~ content) }} },
                    {% endif -%}
                    {% elif variant.type == "ref" and variant.schema_ref is defined -%}
                    {% set serialized %}{{ variant.schema_ref | to_upper_camel_case }}Serializer.serialize(value){% endset -%}
                    ...{% if type.fields %}omitProperties({{ serialized }}, {{ m.names(type.fields, true) }}){% else %}{{ serialized }}{% endif %},
                    {% elif variant.type == "struct" and variant.fields is defined -%}
                    ...extraProperties(value, {{ m.names(variant.fields + type.fields, true, [disc_json]) }}),
                    {{- m.serialize_fields(variant.fields, "value") }}
                    {% else -%}
                    ...extraProperties(value, {{ m.names(type.fields, true, [disc_json]) }}),
                    {% endif -%}
                    {% if type.fields %}{{ m.serialize_fields(type.fields, "value") }}
                    {% endif -%}
                    {{ disc_json | tojson }}: {{ variant.name | tojson }},
                };
        {%- endfor %}
            default:
                return value;
        }
    },
};
