{% import "types/macros.ts.jinja" as m -%}
{% set type_name = type.name | to_upper_camel_case -%}
{% set ns = namespace(names=[]) -%}
{% for name, value in type.variants %}{% set ns.names = ns.names + [name] %}{% endfor -%}
{% set members = ns.names | idents("pascal", none, "schema `" ~ type.name ~ "`") -%}
{{ doc_comment }}
export const {{ type_name }} = {
    {% for name, value in type.variants -%}
    {{ members[loop.index0] }}: {{ value }},
    {% endfor -%}
} as const;

export type {{ type_name }} = (typeof {{ type_name }})[keyof typeof {{ type_name }}];

export const {{ type_name }}Serializer = {
    parse(json: any): {{ type_name }} {
        return json;
    },

    serialize(value: {{ type_name }}): any {
        return value;
    },
{{ m.legacy_aliases(type_name) }}
};
