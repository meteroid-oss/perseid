{#- How the SDK names and calls each operation, for `perseid docs-data`: each macro renders one
    value of its JSON. An example is the `{resource, operation, path_args, body, result, item}`
    of docs.jinja. -#}
{% import "docs.jinja" as docs %}
{% import "api_reference.md.jinja" as ref %}

{% macro install() %}npm install {{ sdk.npm_package }}{% endmacro %}

{% macro setup() -%}
import { {{ sdk.client_name }} } from "{{ sdk.npm_package }}";

const client = new {{ sdk.client_name }}({ apiKey: process.env.{{ sdk.env_prefix }}_API_KEY });
{%- endmacro %}

{% macro method(resource, op) %}{{ docs.resource(resource.name) }}.{{ docs.method(op) }}{% endmacro %}

{% macro signature(resource, op) %}{{ ref.signature(resource, op) }}{% endmacro %}

{#- `[[wire name, name], ...]` of the parameters of `op`, as JSON. -#}
{% macro param_names(resource, op) -%}
    {%- set ns = namespace(pairs=[]) -%}
    {%- for p in op.path_params %}{% set ns.pairs = ns.pairs + [[p, p | ident("camel", "typescript")]] %}{% endfor -%}
    {%- for p in op.query_params + op.header_params %}{% set ns.pairs = ns.pairs + [[p.name, p.ident | ident("camel")]] %}{% endfor -%}
    {{ ns.pairs | tojson }}
{%- endmacro %}

{% macro type_name(name) %}{{ name | to_upper_camel_case }}{% endmacro %}

{#- `[[wire name, name], ...]` of the fields of the schema `name`, as JSON. -#}
{% macro field_names(name, ty) -%}
    {%- set ns = namespace(pairs=[]) -%}
    {%- for f in ty.fields | default([]) if not f.flatten %}{% set ns.pairs = ns.pairs + [[f.name, f.name | ident("camel")]] %}{% endfor -%}
    {{ ns.pairs | tojson }}
{%- endmacro %}

{% macro sample(ex) -%}
    {%- set op = ex.operation -%}
    {%- set call = docs.call(ex) -%}
    {%- if op.pagination is defined -%}
for await (const {{ docs.var(ex.item, "item") }} of {{ call }}) {
  console.log({{ docs.var(ex.item, "item") }});
}
    {%- elif op.response_is_event_stream -%}
const stream = await {{ call }};
for await (const event of stream) {
  console.log(event);
}
    {%- elif ex.result -%}
const {{ docs.var(ex.result, "result") }} = await {{ call }};
    {%- elif op.response_body_schema_name is defined or op.response_body_json_type is defined or op.response_is_text | default(false) or op.response_is_binary | default(false) -%}
const result = await {{ call }};
    {%- else -%}
await {{ call }};
    {%- endif -%}
{%- endmacro %}
