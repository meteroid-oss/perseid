{% from "types/macros.py.jinja" import module_name -%}
# this file is @generated
{% set _ = set_summary_filename(module_name(type.name) ~ ".py") -%}
{% if type.kind == "struct" -%}
    {% include "types/struct.py.jinja" -%}
{% elif type.kind == "string_enum" -%}
    {% include "types/string_enum.py.jinja" -%}
{% elif type.kind == "integer_enum" -%}
    {% include "types/integer_enum.py.jinja" -%}
{% elif type.kind == "struct_enum" -%}
    {% include "types/struct_enum.py.jinja" -%}
{% elif type.kind == "string_alias" -%}
    {% include "types/string_alias.py.jinja" -%}
{% elif type.kind == "alias" -%}
    {% include "types/alias.py.jinja" -%}
{% else -%}
    {{ panic("`" ~ type.kind ~ "` types are not supported by the Python codegen templates (type `" ~ type.name ~ "`)") }}
{% endif %}
