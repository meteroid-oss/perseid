def _build_configuration(
    token: str | None, options: {{ sdk.client_name }}Options | None
) -> Configuration:
    options = options if options is not None else {{ sdk.client_name }}Options()
    if options.retry_schedule is not None:
        retry_schedule = list(options.retry_schedule)
    else:
        num_retries = (
            options.num_retries if options.num_retries is not None else DEFAULT_NUM_RETRIES
        )
        retry_schedule = default_retry_schedule(num_retries)
    return Configuration(
        base_path=(options.server_url or DEFAULT_SERVER_URL).rstrip("/"),
        bearer_access_token=token,
{%- if "bearer" in kinds %}
        token_provider=options.token_provider,
{%- endif %}
{%- if "basic" in kinds %}
