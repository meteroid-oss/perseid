{#- The API as Python names it, for api.md and the README's examples. An example is a
    `{resource, operation, path_args, body, result, item}` the README receives. -#}
{% from "types/macros.py.jinja" import field_ident, page_class, py_field, py_ident, module_name, resource_module %}

{#- The heading of a resource in api.md, and links to every resource's. -#}
{% macro title(name) %}{{ name | to_snake_case | replace("_", " ") | capitalize }}{% endmacro %}

{% macro contents(resources) -%}
    {%- for r in resources %}[{{ title(r.name) }}](#{{ r.name | to_kebab_case }}){% if not loop.last %} · {% endif %}{% endfor -%}
{%- endmacro %}

{% macro package() %}{{ sdk.package_name | replace(".", "_") | replace("-", "_") }}{% endmacro %}

{% macro resource(name) %}client.{{ py_ident(name) }}{% endmacro %}

{% macro method(op) %}{{ py_ident(op.name) }}{% endmacro %}

{% macro model_path(name) %}{{ package() }}/models/{{ module_name(name) }}.py{% endmacro %}

{#- The page class the list of example `ex` returns. -#}
{% macro page(ex) %}{{ page_class(ex.resource, ex.operation.name) }}{% endmacro %}

{#- A response property its paging reads, as a page of example `ex` reads it: `meta.total_pages`. -#}
{% macro page_field(ex) -%}
    {%- set pg = ex.operation.pagination -%}
    {%- set path = pg.total or pg.total_pages or pg.next_cursor or pg.has_more or pg["items"] -%}
    {%- for key in path %}{% if not loop.first %}.{% endif %}{{ py_field(key) }}{% endfor -%}
{%- endmacro %}

{% macro resource_path(name) %}{{ package() }}/api/{{ resource_module(name) }}.py{% endmacro %}

{#- A variable holding a value of schema `name`, `fallback` without one. -#}
{% macro var(name, fallback) -%}
    {%- set id = py_ident(name) if name else fallback -%}
    {{ fallback if id in ["client", "page", "stream", "response", "error"] else id }}
{%- endmacro %}

{% macro literal(arg) -%}
    {%- if arg.kind == "boolean" %}{{ "True" if arg.value else "False" }}
    {%- elif arg.kind == "uuid" %}UUID({{ arg.value | tojson }})
    {%- elif arg.kind == "date" %}date.fromisoformat({{ arg.value | tojson }})
    {%- elif arg.kind == "enum" %}{{ arg.schema | to_upper_camel_case }}({{ arg.value | tojson }})
    {%- elif arg.kind == "list" %}[{% for item in arg["items"] %}{{ literal(item) }}{% if not loop.last %}, {% endif %}{% endfor %}]
    {%- elif arg.kind == "object" %}{{ arg.schema | to_upper_camel_case }}({% for f in arg.fields %}{{ field_ident(f) }}={{ literal(f) }}{% if not loop.last %}, {% endif %}{% endfor %})
    {%- else %}{{ arg.value | tojson }}{% endif -%}
{%- endmacro %}

{#- The kinds of the literals `args` and of those they nest, space-separated, with `model:Name`
    for the enums and models they construct. -#}
{% macro kinds(args) -%}
    {%- for a in args %} {{ a.kind }}{% if a.kind in ["enum", "object"] %} model:{{ a.schema | to_upper_camel_case }}{% endif -%}
    {%- if a.kind == "object" %}{{ kinds(a.fields) }}{% elif a.kind == "list" %}{{ kinds(a["items"]) }}{% endif %}{% endfor -%}
{%- endmacro %}

{#- The imports the literals of the examples `exs` need, each on its line. -#}
{% macro imports(exs) -%}
    {%- set ns = namespace(kinds=[]) -%}
    {%- for ex in exs if ex %}{% set ns.kinds = ns.kinds + (kinds(ex.path_args + (ex.body.fields if ex.body and ex.body.fields else [])) | split | list) %}{% endfor -%}
    {%- set models = ns.kinds | select("startingwith", "model:") | map("replace", "model:", "") | unique | sort | list -%}
    {%- if "date" in ns.kinds %}from datetime import date
{% endif -%}
    {%- if "uuid" in ns.kinds %}from uuid import UUID
{% endif -%}
    {%- if models %}from {{ package() }}.models import {{ models | join(", ") }}
{% endif -%}
{%- endmacro %}

{#- The call of an example, `kwargs` (`name=value, ...`) closing its arguments. -#}
{% macro call(ex, kwargs="", raw=false) -%}
    {%- set out = namespace(args=[]) -%}
    {%- for a in ex.path_args %}{% set out.args = out.args + [literal(a)] %}{% endfor -%}
    {%- if ex.body %}{% for f in ex.body.fields %}{% set out.args = out.args + [field_ident(f) ~ "=" ~ literal(f)] %}{% endfor %}{% endif -%}
    {%- if kwargs %}{% set out.args = out.args + [kwargs] %}{% endif -%}
    client.{{ "with_raw_response." if raw }}{{ py_ident(ex.resource) }}.{{ method(ex.operation) }}({{ out.args | join(", ") }})
{%- endmacro %}
