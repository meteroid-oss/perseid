{#
    Shared helpers for the Python templates.
-#}

{#- Render `text` as a Python docstring literal, to indent with `| indent(n)`.
    Backslashes and triple quotes are escaped. -#}
{% macro docstring(text) -%}
    {%- set escaped = text | replace("\\", "\\\\") | replace('"""', '\\"\\"\\"') -%}
    {%- if escaped is endingwith '"' -%}
        {%- set escaped = escaped ~ " " -%}
    {%- endif -%}
    """{{ escaped }}"""
{%- endmacro %}

{#- A Python string literal. -#}
{% macro py_str(text) -%}
    "{{ text | replace("\\", "\\\\") | replace('"', '\\"') | replace("\n", "\\n") }}"
{%- endmacro %}

{#- Convert a spec name into a safe snake_case Python identifier. -#}
{% macro py_ident(name) -%}
    {{ name | ident("snake", "python") }}
{%- endmacro %}

{#- A model attribute: also clear of the builtins and `BaseModel` members a field would shadow. -#}
{% macro py_field(name) -%}
    {{ name | ident("snake", "python_field") }}
{%- endmacro %}

{#- The module a schema or resource is generated into. -#}
{% macro module_name(name) -%}
    {{ name | ident("snake", "python") }}
{%- endmacro %}

{#- The module of a resource, clear of the runtime modules next to it. -#}
{% macro resource_module(name) -%}
    {%- set module = name | ident("snake", "python") -%}
    {{ module ~ "_api" if module in ["client", "common", "middleware"] else module }}
{%- endmacro %}

{#- The attribute of a field; a `flatten` field is named after the schema it inlines. Names of
    `BaseModel` members (`extra_fields`, `to_dict`...) and of the builtins a model body uses get a
    trailing `_`, like a keyword. -#}
{% macro field_ident(field) -%}
    {{- py_field(field.type.to_python() if field.flatten else field.name) -}}
{%- endmacro %}

{#- The annotation of one variant of a union: its `""` variant is `t.Literal[""]`, a free-form
    object `dict[str, t.Any]`. -#}
{% macro variant_type(variant) -%}
    {%- if variant.empty %}t.Literal[""]
    {%- elif variant.type.is_json_object() and not variant.type.is_union() %}dict[str, t.Any]
    {%- else %}{{ py_type(variant.type) }}{% endif -%}
{%- endmacro %}

{#- The Python annotation for a field type. An any-JSON schema (`{}`) is
    `t.Any`, as its value may be a list, a scalar or `null` too. A union told
    apart by JSON type is `str | Customer`, its `""` variant `t.Literal[""]`; one whose
    variants share a JSON type (`str | list[str] | list[int]`) lists them in the order they are
    tried. -#}
{% macro py_type(ty) -%}
    {%- if ty.is_nullable() -%}
        {%- if ty.inner_type().is_json_object() and not ty.inner_type().is_union() -%}t.Any{%- else -%}{{ py_type(ty.inner_type()) }} | None{%- endif -%}
    {%- elif ty.is_union() and ty.union_mode() != "json" -%}
        t.Annotated[{% for variant in (ty.try_variants() if ty.union_decode() == "try" else ty.union_variants()) %}{{ variant_type(variant) }} | {% endfor %}UnknownVariant, {{ object_union(ty) }}]
    {%- elif ty.is_union() -%}
        {%- for variant in (ty.try_variants() if ty.union_decode() == "try" else ty.union_variants()) -%}
            {%- if not loop.first %} | {% endif -%}
            {{ variant_type(variant) }}
        {%- endfor -%}
    {%- elif ty.is_json_object() -%}
        t.Any
    {%- elif ty.is_list() or ty.is_set() -%}
        list[{{ py_type(ty.inner_type()) }}]
    {%- elif ty.is_map() -%}
        dict[str, {{ py_type(ty.value_type()) }}]
    {%- else -%}
        {{ ty.to_python() }}
    {%- endif -%}
{%- endmacro %}

{#- The annotation of `ty`, a body or field type holding a union, with the union written as `name`. -#}
{% macro named_type(ty, name) -%}
    {%- if ty.is_union() -%}{{ name }}
    {%- elif ty.is_nullable() -%}{{ named_type(ty.inner_type(), name) }} | None
    {%- elif ty.is_list() or ty.is_set() -%}list[{{ named_type(ty.inner_type(), name) }}]
    {%- elif ty.is_map() -%}dict[str, {{ named_type(ty.value_type(), name) }}]
    {%- else -%}{{ py_type(ty) }}{% endif -%}
{%- endmacro %}

{#- The annotation of the union inside the body type `ty`, which `named_type` names. -#}
{% macro union_type(ty) -%}
    {%- if ty.is_union() -%}{{ py_type(ty) }}
    {%- elif ty.is_nullable() or ty.is_list() or ty.is_set() -%}{{ union_type(ty.inner_type()) }}
    {%- elif ty.is_map() -%}{{ union_type(ty.value_type()) }}
    {%- endif -%}
{%- endmacro %}

{#- The annotation of a query parameter: a union of scalars or lists of them is typed. -#}
{% macro param_type(p) -%}
    {%- if p.typed_union is defined -%}
        {%- for variant in (p.typed_union.try_variants() if p.typed_union.union_decode() == "try" else p.typed_union.union_variants()) -%}
            {%- if not loop.first %} | {% endif -%}
            {{ variant_type(variant) }}
        {%- endfor -%}
    {%- else -%}
        {{ py_type(p.type) }}
    {%- endif -%}
{%- endmacro %}

{#- The models the variants of a union reference, each followed by a space. -#}
{% macro union_refs(ty) -%}
    {%- for variant in ty.union_variants() -%}
        {%- if variant.type.is_schema_ref() %}{{ variant.type.to_python() }} {% endif -%}
        {%- if (variant.type.is_list() or variant.type.is_set()) and variant.type.inner_type().is_schema_ref() -%}
            {{ variant.type.inner_type().to_python() }} {% endif -%}
    {%- endfor -%}
{%- endmacro %}

{#- The `ObjectUnion` metadata telling apart the object variants of `ty`. -#}
{% macro object_union(ty) -%}
    {%- macro literal(value) -%}
        {%- set j = value | tojson -%}
        {%- if j == "true" %}True{% elif j == "false" %}False{% else %}{{ j }}{% endif -%}
    {%- endmacro -%}
    {%- set others -%}
        {%- for variant in (ty.try_variants() if ty.union_decode() == "try" else ty.union_variants()) if variant.json_type != "object" -%}
            {%- if not loop.first %} | {% endif -%}
            {{ variant_type(variant) }}
        {%- endfor -%}
    {%- endset -%}
    {%- set others = others ~ ", " if others else "" -%}
    {%- if ty.union_mode() == "rules" -%}
        ObjectUnion({{ others }}when=[{% for v in ty.object_variants() %}({{ variant_type(v) }}, { {%- for c in v.when %}{{ c.property | tojson }}: {% if c.value is defined %}{{ literal(c.value) }}{% else %}...{% endif %}{% if not loop.last %}, {% endif %}{% endfor -%} }){% if not loop.last %}, {% endif %}{% endfor %}])
    {%- else -%}
        ObjectUnion({{ others }}best_match=[{% for v in ty.object_variants() %}({{ variant_type(v) }}, ({% for p in v.required %}{{ p | tojson }}{% if not loop.last %}, {% elif loop.length == 1 %},{% endif %}{% endfor %}), ({% for p in v.properties %}{{ p | tojson }}{% if not loop.last %}, {% elif loop.length == 1 %},{% endif %}{% endfor %})){% if not loop.last %}, {% endif %}{% endfor %}])
    {%- endif -%}
{%- endmacro %}

{#- "1" when `ty` holds a union of several objects, directly or in collections. -#}
{% macro has_object_union(ty) -%}
    {%- if ty.is_union() -%}
        {%- if ty.union_mode() != "json" %}1{% endif -%}
        {%- for v in ty.union_variants() %}{{ has_object_union(v.type) }}{% endfor -%}
    {%- elif ty.is_list() or ty.is_set() or ty.is_nullable() -%}
        {{ has_object_union(ty.inner_type()) }}
    {%- elif ty.is_map() -%}
        {{ has_object_union(ty.value_type()) }}
    {%- endif -%}
{%- endmacro %}

{#- Whether a field is optional and also accepts `null`, so needs UNSET to tell them apart:
    only in the schemas requests send, as responses never need to. -#}
{% macro is_tristate(field, in_request=true) -%}
    {%- if field.nullable and not field.required and in_request %}1{% endif -%}
{%- endmacro %}

{#- The annotation of a struct field: required `X`, required nullable `X | None`, optional
    `X | None`, optional nullable `X | None | Unset` in request schemas. `ty` replaces the
    annotation of the value, such as an enum taking its literals too. -#}
{% macro field_type(field, in_request=true, ty=none) -%}
    {%- set ty = ty or literal_type(field) or py_type(field.type) -%}
    {%- if ty == "t.Any" or (field.required and not field.nullable) %}{{ ty }}
    {%- elif field.required or not is_tristate(field, in_request) %}{{ ty }} | None
    {%- else %}{{ ty }} | None | Unset{% endif -%}
{%- endmacro %}

{#- `t.Literal[...]` of a field of one string value, else nothing. -#}
{% macro literal_type(field) -%}
    {%- if field.literal is defined %}t.Literal[{{ py_str(field.literal) }}]{% endif -%}
{%- endmacro %}

{#- The annotation and default of a struct field: optional ones default to `None`, or to
    `UNSET` when `None` sends `null`. -#}
{#- `annotation` in a class with the attributes `attrs`: an attribute `date` hides the type. -#}
{% macro in_class(annotation, attrs) -%}
    {{ annotation | replace_ident("date", "_datetime.date") if "date" in attrs else annotation }}
{%- endmacro %}

{#- The attribute names of `fields`. -#}
{% macro attr_names(fields) -%}
    {%- for field in fields %}{{ field_ident(field) }} {% endfor -%}
{%- endmacro %}

{% macro field_decl(field, in_request=true, ty=none) -%}
    {{ field_type(field, in_request, ty) }}
    {%- if not field.required %} = {% if is_tristate(field, in_request) %}UNSET{% else %}None{% endif %}{% endif -%}
{%- endmacro %}

{#- The models `ty` names, each followed by a space. -#}
{% macro type_refs(ty) -%}
    {%- if ty.is_schema_ref() %}{{ ty.to_python() }} {% endif -%}
    {%- if ty.is_list() or ty.is_set() or ty.is_nullable() %}{{ type_refs(ty.inner_type()) }}{% endif -%}
    {%- if ty.is_map() %}{{ type_refs(ty.value_type()) }}{% endif -%}
    {%- if ty.is_union() %}{% for v in ty.union_variants() %}{{ type_refs(v.type) }}{% endfor %}{% endif -%}
{%- endmacro %}

{#- "1" when the struct enum `type` is the plain union of its variant models, told apart by
    its discriminator, rather than a model holding the discriminator and the variant. -#}
{% macro is_flat_union(type) -%}
    {%- set refs = type.variants | map(attribute="schema_ref") | list -%}
    {%- if type.repr == "internally_tagged" and type.fields | length == 0
        and refs | select | list | length == refs | length
        and refs | unique | list | length == refs | length %}1{% endif -%}
{%- endmacro %}

{#- The `t.Literal` alias of the values of an enum, which arguments take next to the enum;
    nothing when a schema has its name. `names` holds the class name of every schema. -#}
{% macro literal_alias(type, names) -%}
    {%- set alias = (type.name | to_upper_camel_case) ~ "Literal" -%}
    {%- if alias not in names %}{{ alias }}{% endif -%}
{%- endmacro %}

{#- The annotation of an argument holding `ty`: an enum also takes its values as literals.
    `enums` lists the class names of the enums with a `literal_alias`. -#}
{% macro arg_type(ty, enums) -%}
    {{ py_type(ty) }}{% if ty.is_schema_ref() and ty.to_python() in enums %} | {{ ty.to_python() }}Literal{% endif %}
{%- endmacro %}

{#- `from __future__` and imports shared by the model modules. Other models are
    imported for type checkers only, which keeps recursive schemas importable:
    the runtime resolves their names in the models package. -#}
{% macro model_imports(referenced_components, runtime_names, union_refs=[]) -%}
{%- set referenced_components = (referenced_components | list) + (union_refs | reject("in", referenced_components | list) | sort | list) -%}
from __future__ import annotations

import dataclasses
import datetime as _datetime
import typing as t
from datetime import date, datetime
from decimal import Decimal
from uuid import UUID

from ..serialization import {{ runtime_names | reject("equalto", "ObjectUnion") | sort | join(", ") }}
{%- if "ObjectUnion" in runtime_names %}
from ..unions import ObjectUnion
{%- endif %}
{%- if referenced_components | length > 0 %}

if t.TYPE_CHECKING:
{%- for c in referenced_components %}
    from .{{ module_name(c) }} import {{ c | to_upper_camel_case }}
{%- endfor %}
{%- endif %}
{%- endmacro %}
