{#
    Shared helpers for the Python templates.
-#}

{#- Render `text` as a Python docstring literal, to indent with `| indent(n)`.
    Backslashes and triple quotes are escaped. -#}
{% macro docstring(text) -%}
    {%- set escaped = text | replace("\\", "\\\\") | replace('"""', '\\"\\"\\"') -%}
    {%- if escaped is endingwith '"' -%}
        {%- set escaped = escaped ~ " " -%}
    {%- endif -%}
    """{{ escaped }}"""
{%- endmacro %}

{#- A Python string literal. -#}
{% macro py_str(text) -%}
    "{{ text | replace("\\", "\\\\") | replace('"', '\\"') | replace("\n", "\\n") }}"
{%- endmacro %}

{#- Convert a spec name into a safe snake_case Python identifier. -#}
{% macro py_ident(name) -%}
    {{ name | ident("snake", "python") }}
{%- endmacro %}

{#- The module a schema or resource is generated into. -#}
{% macro module_name(name) -%}
    {{ name | ident("snake", "python") }}
{%- endmacro %}

{#- The module of a resource, clear of the runtime modules next to it. -#}
{% macro resource_module(name) -%}
    {%- set module = name | ident("snake", "python") -%}
    {{ module ~ "_api" if module in ["client", "common", "middleware"] else module }}
{%- endmacro %}

{#- The attribute of a field; a `flatten` field is named after the schema it inlines. -#}
{% macro field_ident(field) -%}
    {%- if field.flatten -%}
        {{ py_ident(field.type.to_python()) }}
    {%- else -%}
        {{ py_ident(field.name) }}
    {%- endif -%}
{%- endmacro %}

{#- The Python annotation for a field type. An any-JSON schema (`{}`) is
    `t.Any`, as its value may be a list, a scalar or `null` too. A union told
    apart by JSON type is `str | Customer`, its `""` variant `t.Literal[""]`. -#}
{% macro py_type(ty) -%}
    {%- if ty.is_union() -%}
        {%- for variant in ty.union_variants() -%}
            {%- if not loop.first %} | {% endif -%}
            {%- if variant.empty %}t.Literal[""]{% else %}{{ py_type(variant.type) }}{% endif -%}
        {%- endfor -%}
    {%- elif ty.is_json_object() -%}
        t.Any
    {%- elif ty.is_list() or ty.is_set() -%}
        list[{{ py_type(ty.inner_type()) }}]
    {%- elif ty.is_map() -%}
        dict[str, {{ py_type(ty.value_type()) }}]
    {%- else -%}
        {{ ty.to_python() }}
    {%- endif -%}
{%- endmacro %}

{#- Whether a field is optional and also accepts `null`, so needs UNSET. -#}
{% macro is_tristate(field) -%}
    {%- if field.nullable and not field.required %}1{% endif -%}
{%- endmacro %}

{#- The annotation and default of a struct field:
    required `X`, required nullable `X | None`, optional `X | None = None`,
    optional nullable `X | None | Unset = UNSET`. -#}
{% macro field_decl(field) -%}
    {%- set ty = py_type(field.type) -%}
    {%- if field.required and not field.nullable -%}
        {{ ty }}
    {%- elif field.required -%}
        {%- if ty == "t.Any" %}t.Any{% else %}{{ ty }} | None{% endif -%}
    {%- elif ty == "t.Any" -%}
        t.Any = {% if is_tristate(field) %}UNSET{% else %}None{% endif %}
    {%- elif is_tristate(field) -%}
        {{ ty }} | None | Unset = UNSET
    {%- else -%}
        {{ ty }} | None = None
    {%- endif -%}
{%- endmacro %}

{#- `from __future__` and imports shared by the model modules. Other models are
    imported for type checkers only, which keeps recursive schemas importable:
    the runtime resolves their names in the models package. -#}
{% macro model_imports(referenced_components, runtime_names, union_refs=[]) -%}
{%- set referenced_components = (referenced_components | list) + (union_refs | reject("in", referenced_components | list) | sort | list) -%}
from __future__ import annotations

import dataclasses
import typing as t
from datetime import datetime
from decimal import Decimal

from ..serialization import {{ runtime_names | sort | join(", ") }}
{%- if referenced_components | length > 0 %}

if t.TYPE_CHECKING:
{%- for c in referenced_components %}
    from .{{ module_name(c) }} import {{ c | to_upper_camel_case }}
{%- endfor %}
{%- endif %}
{%- endmacro %}
