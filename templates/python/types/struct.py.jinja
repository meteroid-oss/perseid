{% from "types/macros.py.jinja" import py_str, docstring, field_decl, field_ident, has_object_union, model_imports, py_ident -%}
{#- A union variant's discriminator defaults to its tag: `Circle(radius=1)`. -#}
{% set defaults = type.discriminator_defaults if type.discriminator_defaults is defined else {} -%}
{% set runtime_names = ["BaseModel"] -%}
{% if request_schema and type.fields | selectattr("nullable") | rejectattr("required") | list | length > 0 -%}
    {% set runtime_names = runtime_names + ["UNSET", "Unset"] -%}
{% endif -%}
{% set objects = namespace(any=false) -%}
{% for field in type.fields if has_object_union(field.type) -%}
    {% set objects.any = true -%}
{% endfor -%}
{% if objects.any -%}
    {% set runtime_names = runtime_names + ["ObjectUnion", "UnknownVariant"] -%}
{% endif -%}
{{ model_imports(referenced_components, runtime_names, union_refs | reject("in", [type.name]) | list) }}

{% set json_keys %}
    {#- Keyed by the attribute name: a keyword field `class` is exposed as `class_`. -#}
    {%- for field in type.fields if not field.flatten -%}
        {%- set attr = field_ident(field) -%}
        {%- if attr != field.name -%}
            "{{ attr }}": {{ py_str(field.name) }},
        {%- endif -%}
    {%- endfor -%}
{% endset -%}

{% set flattened %}
    {%- for field in type.fields if field.flatten -%}
        "{{ field_ident(field) }}",
    {%- endfor -%}
{% endset -%}


@dataclasses.dataclass(kw_only=True)
class {{ type.name | to_upper_camel_case }}(BaseModel):
    {{ docstring(type.description if type.description is defined else "The `" ~ type.name ~ "` object.") | indent(4) }}


    {%- if json_keys | trim %}
    _JSON_KEYS: t.ClassVar[t.Mapping[str, str]] = { {{ json_keys | trim }} }
    {%- endif %}

    {%- if flattened | trim %}
    _FLATTENED: t.ClassVar[tuple[str, ...]] = ( {{ flattened | trim }} )
    {%- endif %}

    {#- Required fields first, for readability: every field is keyword-only. -#}
    {%- for required_pass in [true, false] %}
        {%- for field in type.fields if field.required == required_pass %}

    {{ field_ident(field) }}: {{ field_decl(field, request_schema) }}
            {%- if field.required and not field.nullable and field.name in defaults and field.type.to_python() == "str" %} = {{ py_str(defaults[field.name]) }}{% endif %}
            {%- if field.description is defined or field.deprecated %}
    {{ docstring(((field.description if field.description is defined else "") ~ ("\n\n.. deprecated:: This field is deprecated." if field.deprecated else "")) | trim) | indent(4) }}
            {%- endif %}
        {%- endfor %}
    {%- endfor %}

    {%- if type.fields | length == 0 %}

    pass
    {%- endif %}
