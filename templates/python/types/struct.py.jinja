{% from "types/macros.py.jinja" import py_str, docstring, field_decl, field_ident, model_imports, py_ident -%}
{% set runtime_names = ["BaseModel"] -%}
{% if type.fields | selectattr("nullable") | rejectattr("required") | list | length > 0 -%}
    {% set runtime_names = runtime_names + ["UNSET", "Unset"] -%}
{% endif -%}
{{ model_imports(referenced_components, runtime_names) }}

{% set json_keys %}
    {#- Keyed by the attribute name: a keyword field `class` is exposed as `class_`. -#}
    {%- for field in type.fields if not field.flatten -%}
        {%- set attr = py_ident(field.name) -%}
        {%- if attr != field.name -%}
            "{{ attr }}": {{ py_str(field.name) }},
        {%- endif -%}
    {%- endfor -%}
{% endset -%}

{% set flattened %}
    {%- for field in type.fields if field.flatten -%}
        "{{ field_ident(field) }}",
    {%- endfor -%}
{% endset -%}


@dataclasses.dataclass(kw_only=True)
class {{ type.name | to_upper_camel_case }}(BaseModel):
    {% if type.description is defined -%}
        {{ docstring(type.description) | indent(4) }}
    {% endif %}

    {%- if json_keys | trim %}
    _JSON_KEYS: t.ClassVar[t.Mapping[str, str]] = { {{ json_keys | trim }} }
    {%- endif %}

    {%- if flattened | trim %}
    _FLATTENED: t.ClassVar[tuple[str, ...]] = ( {{ flattened | trim }} )
    {%- endif %}

    {#- Required fields first, for readability: every field is keyword-only. -#}
    {%- for required_pass in [true, false] %}
        {%- for field in type.fields if field.required == required_pass %}

    {{ field_ident(field) }}: {{ field_decl(field) }}
            {%- if field.description is defined or field.deprecated %}
    {{ docstring(((field.description if field.description is defined else "") ~ ("\n\n.. deprecated:: This field is deprecated." if field.deprecated else "")) | trim) | indent(4) }}
            {%- endif %}
        {%- endfor %}
    {%- endfor %}

    {%- if type.fields | length == 0 %}

    pass
    {%- endif %}
