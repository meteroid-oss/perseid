{% from "types/macros.rs.jinja" import extra_field, extra_name, struct_fields, struct_new, unknown_variant, value_type, union_enums, union_imports -%}
use serde::{Deserialize, Deserializer, Serialize, Serializer};

use crate::models::codec;
{% if referenced_components -%}
use super::{
    {% for c in referenced_components -%}
        {{ c | to_rust_ident }}::{{ c | to_upper_camel_case }},
    {% endfor -%}
};
{% endif %}
{{ union_imports() }}

{% set recursive = recursive_refs | map("to_upper_camel_case") | list -%}
{% set type_name = type.name | to_upper_camel_case -%}
{% set tag = type.discriminator_field -%}
{% set adjacent = type.repr == "adjacently_tagged" -%}
{% set shared = type.fields | rejectattr("name", "equalto", tag) | list -%}
{% set enum_name = type_name ~ "Content" if shared else type_name -%}
{% set variant_names = type.variants | map(attribute="name") | map("to_rust_variant") | list -%}
{% set unknown = unknown_variant(variant_names) -%}

{% if shared -%}
{{ doc_comment }}
#[derive(Clone, Debug, PartialEq, Deserialize, Serialize)]
pub struct {{ type_name }} {
    {{ struct_fields(shared, recursive, patch_body, owner=type_name) }}

    #[serde(flatten)]
    pub content: {{ enum_name }},
}
{{ union_enums(type_name, shared) }}
{% endif %}

{% for variant in type.variants if variant.type == "struct" and variant.fields -%}
{% set struct_name = type_name ~ (variant.name | to_rust_variant) ~ "Variant" -%}
{% set required = variant.fields | selectattr("required") | rejectattr("nullable") | rejectattr("name", "equalto", tag) | list -%}
/// The `{{ variant.name }}` variant of [`{{ enum_name }}`].
#[derive(Clone, Debug, {% if not required %}Default, {% endif %}PartialEq, Deserialize, Serialize)]
{% set extra = extra_name(variant.fields) -%}
pub struct {{ struct_name }} {
    {{ struct_fields(variant.fields, recursive, false, tag, owner=struct_name) }}
    {{- extra_field(extra) }}
}

impl {{ struct_name }} {
    {{ struct_new(variant.fields, recursive, tag, owner=struct_name, extra=extra) }}
}
{{ union_enums(struct_name, variant.fields) }}
{% endfor %}

{% macro payload(variant) -%}
{% if variant.type == "struct" and variant.fields -%}
{{ type_name }}{{ variant.name | to_rust_variant }}Variant
{%- elif variant.schema_ref is defined and variant.schema_ref | to_upper_camel_case in recursive -%}
Box<{{ variant.schema_ref | to_upper_camel_case }}>
{%- elif variant.schema_ref is defined -%}
{{ variant.schema_ref | to_upper_camel_case }}
{%- endif %}
{%- endmacro %}

{% if not shared and doc_comment %}{{ doc_comment }}
///
{% endif -%}
/// Variants are told apart by `{{ tag }}`{% if adjacent %}, their fields sit under `{{ type.content_field }}`{% endif %}.
#[derive(Clone, Debug, PartialEq)]
#[non_exhaustive]
pub enum {{ enum_name }} {
    {% for variant in type.variants -%}
        {% set p = payload(variant) -%}
        {{ variant.name | to_rust_variant }}{% if p %}({{ p }}){% endif %},
    {% endfor -%}
    /// A variant this version of the SDK does not know yet, as received.
    {{ unknown }}(serde_json::Value),
}

impl {{ enum_name }} {
    /// The `{{ tag }}` value of this variant.
    #[must_use]
    pub fn tag(&self) -> Option<&str> {
        match self {
            {% for variant in type.variants -%}
                Self::{{ variant.name | to_rust_variant }}{% if payload(variant) %}(_){% endif %} => Some({{ variant.name | rust_str }}),
            {% endfor -%}
            Self::{{ unknown }}(value) => value.get({{ tag | rust_str }})?.as_str(),
        }
    }
}


impl Serialize for {{ enum_name }} {
    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
        match self {
            {% for variant in type.variants -%}
            {% if payload(variant) -%}
            Self::{{ variant.name | to_rust_variant }}(value) => {
                {% if adjacent -%}
                codec::adjacently_tagged(serializer, {{ tag | rust_str }}, {{ variant.name | rust_str }}, {{ type.content_field | rust_str }}, Some(value))
                {% else -%}
                codec::internally_tagged(serializer, {{ tag | rust_str }}, {{ variant.name | rust_str }}, value)
                {% endif -%}
            }
            {% else -%}
            Self::{{ variant.name | to_rust_variant }} => {
                codec::adjacently_tagged(serializer, {{ tag | rust_str }}, {{ variant.name | rust_str }}, {{ type.content_field | rust_str }}, None::<&()>)
            }
            {% endif -%}
            {% endfor -%}
            Self::{{ unknown }}(value) => value.serialize(serializer),
        }
    }
}

impl<'de> Deserialize<'de> for {{ enum_name }} {
    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
        let (tag, {% if adjacent %}mut {% endif %}value) = codec::split_tag(deserializer, {{ tag | rust_str }})?;
        Ok(match tag.as_str() {
            {% for variant in type.variants -%}
            {% if payload(variant) -%}
            {{ variant.name | rust_str }} => Self::{{ variant.name | to_rust_variant }}(codec::from_value({% if adjacent %}codec::take(&mut value, {{ type.content_field | rust_str }}){% elif variant.type == "struct" and variant.fields %}codec::without(value, {{ tag | rust_str }}){% else %}value{% endif %})?),
            {% else -%}
            {{ variant.name | rust_str }} => Self::{{ variant.name | to_rust_variant }},
            {% endif -%}
            {% endfor -%}
            _ => Self::{{ unknown }}(value),
        })
    }
}
