{% from "types/macros.rs.jinja" import extra_field, extra_name, struct_fields, struct_new, unknown_variant, value_type, union_enums, union_imports -%}
use serde::{Deserialize, Deserializer, Serialize, Serializer};

use crate::models::codec;
{% if referenced_components -%}
use super::{
    {% for c in referenced_components -%}
        {{ c | to_rust_ident }}::{{ c | to_upper_camel_case }},
    {% endfor -%}
};
{% endif %}
{{ union_imports() }}

{% set recursive = recursive_refs | map("to_upper_camel_case") | list -%}
{% set type_name = type.name | to_upper_camel_case -%}
{% set tag = type.discriminator_field -%}
{% set adjacent = type.repr == "adjacently_tagged" -%}
{% set shared = type.fields | rejectattr("name", "equalto", tag) | list -%}
{% set enum_name = type_name ~ "Content" if shared else type_name -%}
{% set variant_names = type.variants | map(attribute="name") | map("to_rust_variant") | list -%}
{% set unknown = unknown_variant(variant_names) -%}
{#- The tag a variant is sent with: the constant it declares, which several may share. -#}
{% set wire = namespace(tags=[]) -%}
{% for variant in type.variants -%}
{% set wire.tags = wire.tags + [declared_tags[variant.name] if variant.name in declared_tags else variant.name] -%}
{% endfor -%}

{% if shared -%}
{{ doc_comment }}
#[derive(Clone, Debug, PartialEq, Deserialize, Serialize)]
pub struct {{ type_name }} {
    {{ struct_fields(shared, recursive, tri_state, owner=type_name) }}

    #[serde(flatten)]
    pub content: {{ enum_name }},
}
{{ union_enums(type_name, shared) }}
{% endif %}

{% for variant in type.variants if variant.type == "struct" and variant.fields -%}
{% set struct_name = type_name ~ (variant.name | to_rust_variant) ~ "Variant" -%}
{% set required = variant.fields | selectattr("required") | rejectattr("nullable") | rejectattr("name", "equalto", tag) | list -%}
/// The `{{ variant.name }}` variant of [`{{ enum_name }}`].
#[derive(Clone, Debug, {% if not required %}Default, {% endif %}PartialEq, Deserialize, Serialize)]
{% set extra = extra_name(variant.fields) -%}
pub struct {{ struct_name }} {
    {{ struct_fields(variant.fields, recursive, tri_state, tag, owner=struct_name) }}
    {{- extra_field(extra) }}
}

impl {{ struct_name }} {
    {{ struct_new(variant.fields, recursive, tag, owner=struct_name, extra=extra) }}
}
{{ union_enums(struct_name, variant.fields) }}
{% endfor %}

{#- Recursive variants are boxed, and those far larger than the others. -#}
{% macro payload(variant) -%}
{% if variant.type == "struct" and variant.fields and variant.name in boxed_variants -%}
Box<{{ type_name }}{{ variant.name | to_rust_variant }}Variant>
{%- elif variant.type == "struct" and variant.fields -%}
{{ type_name }}{{ variant.name | to_rust_variant }}Variant
{%- elif variant.schema_ref is defined and (variant.schema_ref | to_upper_camel_case in recursive or variant.name in boxed_variants) -%}
Box<{{ variant.schema_ref | to_upper_camel_case }}>
{%- elif variant.schema_ref is defined -%}
{{ variant.schema_ref | to_upper_camel_case }}
{%- endif %}
{%- endmacro %}

{% if not shared and doc_comment %}{{ doc_comment }}
///
{% endif -%}
/// Variants are told apart by `{{ tag }}`{% if adjacent %}, their fields sit under `{{ type.content_field }}`{% endif %}.
#[derive(Clone, Debug, PartialEq)]
#[non_exhaustive]
pub enum {{ enum_name }} {
    {% for variant in type.variants -%}
        {% set p = payload(variant) -%}
        {{ variant.name | to_rust_variant }}{% if p %}({{ p }}){% endif %},
    {% endfor -%}
    /// A variant this version of the SDK does not know yet, as received.
    {{ unknown }}(serde_json::Value),
}

impl {{ enum_name }} {
    /// The `{{ tag }}` value of this variant.
    #[must_use]
    pub fn tag(&self) -> Option<&str> {
        match self {
            {% for variant in type.variants -%}
                Self::{{ variant.name | to_rust_variant }}{% if payload(variant) %}(_){% endif %} => Some({{ wire.tags[loop.index0] | rust_str }}),
            {% endfor -%}
            Self::{{ unknown }}(value) => value.get({{ tag | rust_str }})?.as_str(),
        }
    }
}
{#- A variant's payload converts into the union, unless another variant holds the same type. -#}
{% set payloads = namespace(all=[]) -%}
{% for variant in type.variants -%}
{% set unboxed = payload(variant) | replace("Box<", "") | replace(">", "") -%}
{% set payloads.all = payloads.all + [alias_targets[unboxed] if unboxed in alias_targets else unboxed] -%}
{% endfor -%}
{% for variant in type.variants -%}
{% set p = payload(variant) -%}
{% set inner = payload(variant) | replace("Box<", "") | replace(">", "") -%}
{% if p and payloads.all | select("equalto", payloads.all[loop.index0]) | list | length == 1 %}

impl From<{{ inner }}> for {{ enum_name }} {
    fn from(value: {{ inner }}) -> Self {
        Self::{{ variant.name | to_rust_variant }}({% if p != inner %}Box::new(value){% else %}value{% endif %})
    }
}
{%- endif %}
{%- endfor %}


impl Serialize for {{ enum_name }} {
    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
        match self {
            {% for variant in type.variants -%}
            {% set variant_tag = wire.tags[loop.index0] -%}
            {% if payload(variant) -%}
            Self::{{ variant.name | to_rust_variant }}(value) => {
                {% if adjacent -%}
                codec::adjacently_tagged(serializer, {{ tag | rust_str }}, {{ variant.name | rust_str }}, {{ type.content_field | rust_str }}, Some(value))
                {% else -%}
                codec::internally_tagged(serializer, {{ tag | rust_str }}, {{ variant_tag | rust_str }}, value)
                {% endif -%}
            }
            {% else -%}
            Self::{{ variant.name | to_rust_variant }} => {
                codec::adjacently_tagged(serializer, {{ tag | rust_str }}, {{ variant.name | rust_str }}, {{ type.content_field | rust_str }}, None::<&()>)
            }
            {% endif -%}
            {% endfor -%}
            Self::{{ unknown }}(value) => value.serialize(serializer),
        }
    }
}

{% macro variant_value(variant, value) -%}
{% if adjacent %}codec::take(&mut value, {{ type.content_field | rust_str }}){% elif variant.type == "struct" and variant.fields %}codec::without({{ value }}, {{ tag | rust_str }}){% else %}{{ value }}{% endif -%}
{%- endmacro %}
impl<'de> Deserialize<'de> for {{ enum_name }} {
    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
        let (tag, {% if adjacent %}mut {% endif %}value) = codec::split_tag(deserializer, {{ tag | rust_str }})?;
        Ok(match tag.as_str() {
            {% for wire_tag in wire.tags | unique -%}
            {% set sharing = namespace(variants=[]) -%}
            {% for variant in type.variants -%}
            {% if wire.tags[loop.index0] == wire_tag and payload(variant) -%}
            {% set sharing.variants = sharing.variants + [variant] if variant.name in declared_tags else [variant] + sharing.variants -%}
            {% endif -%}
            {% endfor -%}
            {% set lead = sharing.variants | first if sharing.variants else none -%}
            {% if sharing.variants | length > 1 -%}
            {# The variant the tag names first, then those declaring it too, as the data allows. -#}
            {{ wire_tag | rust_str }} => match codec::from_value::<_, D::Error>({{ variant_value(lead, "value.clone()") }}) {
                Ok(decoded) => Self::{{ lead.name | to_rust_variant }}(decoded),
                Err(error) => {
                    {% for other in sharing.variants[1:] -%}
                    {% if not loop.first %}} else {% endif %}if let Ok(decoded) = codec::from_value::<_, D::Error>({{ variant_value(other, "value.clone()") }}) {
                        Self::{{ other.name | to_rust_variant }}(decoded)
                    {% endfor -%}
                    } else {
                        return Err(error);
                    }
                }
            },
            {% elif lead -%}
            {{ wire_tag | rust_str }} => Self::{{ lead.name | to_rust_variant }}(codec::from_value({{ variant_value(lead, "value") }})?),
            {% else -%}
            {% for variant in type.variants -%}
            {% if wire.tags[loop.index0] == wire_tag -%}
            {{ wire_tag | rust_str }} => Self::{{ variant.name | to_rust_variant }},
            {% endif -%}
            {% endfor -%}
            {% endif -%}
            {% endfor -%}
            _ => Self::{{ unknown }}(value),
        })
    }
}
