use std::fmt;

use serde::{Deserialize, Deserializer, Serialize, Serializer};

{% set name = type.name | to_upper_camel_case -%}
{% set names = type.values | enum_names -%}
{% set variants = names | map("to_rust_variant") | list -%}
{% set unknown = unknown_variant(variants) -%}
{{ doc_comment }}
#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
#[non_exhaustive]
pub enum {{ name }} {
    {% for value in type.values -%}
        {{ variants[loop.index0] }},
    {% endfor -%}
    /// A value this version of the SDK does not know yet.
    {{ unknown }}(String),
}

impl {{ name }} {
    /// The value as sent on the wire.
    #[must_use]
    pub fn as_str(&self) -> &str {
        match self {
            {% for value in type.values -%}
                Self::{{ variants[loop.index0] }} => {{ value | rust_str }},
            {% endfor -%}
            Self::{{ unknown }}(value) => value,
        }
    }
}

impl From<&str> for {{ name }} {
    fn from(value: &str) -> Self {
        match value {
            {% for value in type.values -%}
                {{ value | rust_str }} => Self::{{ variants[loop.index0] }},
            {% endfor -%}
            other => Self::{{ unknown }}(other.to_owned()),
        }
    }
}

impl fmt::Display for {{ name }} {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.write_str(self.as_str())
    }
}

impl Serialize for {{ name }} {
    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
        serializer.serialize_str(self.as_str())
    }
}

impl<'de> Deserialize<'de> for {{ name }} {
    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
        String::deserialize(deserializer).map(|value| Self::from(value.as_str()))
    }
}

impl crate::request::QueryParamValue for {{ name }} {
    fn encode(&self) -> String {
        self.to_string()
    }
}
