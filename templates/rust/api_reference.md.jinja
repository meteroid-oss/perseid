{% from "types/macros.rs.jinja" import rust_type -%}
{% import "docs.jinja" as docs -%}
{% set _ = set_summary_filename("api.md") -%}
{% macro model(name) -%}
    {%- if name in api.types %}[`{{ name | to_upper_camel_case }}`]({{ docs.model_path(name) }}){% else %}`{{ name | to_upper_camel_case }}`{% endif -%}
{%- endmacro -%}
{#- A Rust type without the `crate::models::` the resource files spell. -#}
{% macro short(ty) %}{{ ty | replace("crate::models::", "") | replace("std::collections::", "") }}{% endmacro -%}
{% macro option(text, optional) %}{% if optional %}Option<{{ text }}>{% else %}{{ text }}{% endif %}{% endmacro -%}
{% macro params(resource, op) -%}
    {%- set prefix = (resource.name | to_upper_camel_case) ~ (op.name | to_upper_camel_case) -%}
    {%- set args = namespace(list=[]) -%}
    {%- for p in op.path_params -%}
        {%- set typed = p in op.path_styles and op.path_styles[p].type is defined -%}
        {%- set args.list = args.list + [(p | to_rust_ident) ~ ": " ~ (short(rust_type(op.path_styles[p].type)) if typed else "&str")] -%}
    {%- endfor -%}
    {%- if op.request_body_kind == "binary" -%}
        {%- set args.list = args.list + ["body: " ~ option("Upload", op.request_body_optional)] -%}
    {%- elif op.request_body_kind == "multipart" -%}
        {%- set args.list = args.list + ["body: " ~ option(prefix ~ "Body", op.request_body_optional)] -%}
    {%- endif -%}
    {%- if op.request_body_schema_name is defined -%}
        {%- set body_ident = op.request_body_schema_name | to_rust_ident -%}
        {%- if body_ident in ["options", "cfg", "make_form", "form", "this", "call"] or body_ident in (op.path_params | map("to_rust_ident") | list) %}{% set body_ident = "body" %}{% endif -%}
        {%- set body_type = op.request_body_schema_name | to_upper_camel_case -%}
        {%- set args.list = args.list + [body_ident ~ ": " ~ option("Vec<" ~ body_type ~ ">" if op.request_body_is_list else body_type, op.request_body_optional)] -%}
    {%- elif op.request_body_json_type is defined -%}
        {%- set args.list = args.list + ["body: " ~ option(short(rust_type(op.request_body_json_type)), op.request_body_optional)] -%}
    {%- endif -%}
    {%- if op | has_query_or_header_params -%}
        {%- set args.list = args.list + ["options: " ~ (prefix ~ "Options" if op | has_required_query_or_header_params else "impl Into<Option<" ~ prefix ~ "Options>>")] -%}
    {%- endif -%}
    ({{ args.list | join(", ") }})
{%- endmacro -%}
{% macro returned(op) -%}
    {%- if op.response_is_event_stream %}EventStream{% if op.event_schema_name is defined %}<{{ op.event_schema_name | to_upper_camel_case }}>{% endif %}
    {%- elif op.response_is_binary %}Bytes
    {%- elif op.response_is_text %}String
    {%- else -%}
        {%- if op.response_body_json_type is defined %}{% set body = short(rust_type(op.response_body_json_type)) -%}
        {%- elif op.response_body_is_list %}{% set body = "Vec<" ~ (op.response_body_schema_name | to_upper_camel_case) ~ ">" -%}
        {%- elif op.response_body_schema_name is defined %}{% set body = op.response_body_schema_name | to_upper_camel_case -%}
        {%- else %}{% set body = "()" %}{% endif -%}
        {{ option(body, op.response_may_be_empty | default(false) and op.pagination is undefined and body != "()") }}
    {%- endif -%}
{%- endmacro -%}
{% macro returns(op) -%}
    {%- if op.response_is_event_stream %}{% if op.event_schema_name is defined %}stream of {{ model(op.event_schema_name) }}{% else %}event stream{% endif %}
    {%- elif op.response_is_binary %}bytes
    {%- elif op.response_is_text %}text
    {%- elif op.response_body_schema_name is defined %}{{ model(op.response_body_schema_name) }}{% if op.response_body_is_list %} list{% endif %}
    {%- elif op.response_body_json_type is defined %}`{{ short(rust_type(op.response_body_json_type)) }}`
    {%- else %}nothing{% endif -%}
{%- endmacro -%}
{% macro table(resource) -%}
| Method | Request | Returns |
| --- | --- | --- |
{% for op in resource.operations -%}
{% if op.pagination is defined -%}
| `{{ docs.resource(resource.name) }}.{{ docs.method(op) }}{{ params(resource, op) }} -> PageCall<{{ op.response_body_schema_name | to_upper_camel_case }}, {{ op.pagination.item_schema | to_upper_camel_case }}>`{% if op.deprecated %} (deprecated){% endif %} | `{{ op.method | upper }} {{ op.path }}` | {{ model(op.response_body_schema_name) }} page of {{ model(op.pagination.item_schema) }} |
{% else -%}
| `{{ docs.resource(resource.name) }}.{{ docs.method(op) }}{{ params(resource, op) }} -> Call<{{ returned(op) }}>`{% if op.deprecated %} (deprecated){% endif %} | `{{ op.method | upper }} {{ op.path }}` | {{ returns(op) }} |
{% endif -%}
{% endfor -%}
{%- endmacro -%}
