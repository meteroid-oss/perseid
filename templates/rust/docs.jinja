{#- The API as Rust names it, for api.md and the README's examples. An example is a
    `{resource, operation, path_args, body, result, item}` the README receives. -#}

{#- The heading of a resource in api.md, and links to every resource's. -#}
{% macro title(name) %}{{ name | to_snake_case | replace("_", " ") | capitalize }}{% endmacro %}

{% macro contents(resources) -%}
    {%- for r in resources %}[{{ title(r.name) }}](#{{ r.name | to_kebab_case }}){% if not loop.last %} · {% endif %}{% endfor -%}
{%- endmacro %}

{% macro resource(name) %}client.{{ name | to_snake_case }}(){% endmacro %}

{% macro method(op) %}{{ op.name | to_rust_ident }}{% endmacro %}

{#- The method iterating over every item of a paginated operation. -#}
{% macro iter_method(op) %}{{ op.name | to_snake_case }}_iter{% endmacro %}

{% macro model_path(name) %}src/models/{{ name | to_snake_case }}.rs{% endmacro %}

{% macro resource_path(name) %}src/api/{{ name | to_snake_case }}.rs{% endmacro %}

{#- A variable holding a value of schema `name`, `fallback` without one. -#}
{% macro var(name, fallback) -%}
    {%- set id = name | to_rust_ident if name else fallback -%}
    {{ fallback if id in ["client", "page", "stream", "response", "error"] or id is startingwith("r#") else id }}
{%- endmacro %}

{% macro literal(arg) %}{% if arg.kind == "string" %}{{ arg.value | rust_str }}{% else %}{{ arg.value | tojson }}{% endif %}{% endmacro %}

{#- The `use` of the model an example's body needs, with its line break. -#}
{% macro uses(ex) %}{% if ex.body %}use {{ sdk.rust_crate }}::models::{{ ex.body.schema | to_upper_camel_case }};
{% endif %}{% endmacro %}

{#- The call of an example, before `.await`; `iter` calls its `_iter` twin, and `options` are
    request options it is called with. -#}
{% macro call(ex, iter=false, options="") -%}
    {%- set out = namespace(args=[]) -%}
    {%- for a in ex.path_args %}{% set out.args = out.args + [literal(a)] %}{% endfor -%}
    {%- if ex.body -%}
        {%- set fields = namespace(list=[]) -%}
        {%- for f in ex.body.fields %}{% set fields.list = fields.list + [literal(f)] %}{% endfor -%}
        {%- set out.args = out.args + [(ex.body.schema | to_upper_camel_case) ~ "::new(" ~ (fields.list | join(", ")) ~ ")"] -%}
    {%- endif -%}
    {%- if ex.operation | has_query_or_header_params %}{% set out.args = out.args + ["None"] %}{% endif -%}
    {{ resource(ex.resource) }}{{ ".with_options(" ~ options ~ ")" if options }}.{{ iter_method(ex.operation) if iter else method(ex.operation) }}({{ out.args | join(", ") }})
{%- endmacro %}
