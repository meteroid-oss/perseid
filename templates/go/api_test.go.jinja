{% from "types/macros.go.jinja" import go_ident, go_export -%}
{% import "docs.jinja" as docs -%}
{% set _ = set_summary_filename((resource.name | go_file) ~ "_test.go") -%}
{#- A string literal, raw when it can be. -#}
{% macro text(s) %}{% if "`" in s or "\n" in s or "\r" in s %}{{ s | tojson }}{% else %}`{{ s }}`{% endif %}{% endmacro -%}
// Code generated by perseid. DO NOT EDIT.

package {{ sdk.package_name }}_test

import (
	"testing"
{%- set kinds = namespace(list=[]) %}
{%- for case in cases %}{% for a in case.path_args %}{% set kinds.list = kinds.list + [a.kind] %}{% endfor %}{% endfor %}
{%- if cases | selectattr("body") | list or "date" in kinds.list or "enum" in kinds.list %}

	"{{ sdk.go_module }}"
{%- endif %}
)
{{ docs.imports(cases) }}{% for case in cases %}
{%- set op = resource.operations[case.index] %}
{%- set args = namespace(list=[docs.resource(resource.path) ~ "." ~ docs.method(op)]) %}
{%- for arg in case.path_args %}{% set args.list = args.list + [docs.literal(arg)] %}{% endfor %}
{%- if case.body %}{% set args.list = args.list + ["decode[" ~ sdk.package_name ~ "." ~ go_ident(case.body.schema) ~ "](t, " ~ text(case.body.json) ~ ")"] %}{% endif %}
{%- if docs.has_options(op) %}{% set args.list = args.list + ["nil"] %}{% endif %}

func Test{{ go_ident(resource.name) }}_{{ go_export(op.name) }}(t *testing.T) {
	client, requests := mock({{ case.response.status }}, {{ (case.response.content_type or "") | tojson }}, {{ text(case.response.body) }})
	call(t, {{ args.list | join(", ") }})
	expect(t, requests, {{ (case.method ~ " " ~ case.path) | tojson }})
}
{%- endfor %}
