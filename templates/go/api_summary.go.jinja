type Client struct {
	cfg *config
}

// New builds a Client authenticated with the given API token, or with the
// {{ sdk.env_prefix }}_API_KEY environment variable when token is empty.
//
// Pass nil options to use the defaults: {{ sdk.env_prefix }}_BASE_URL{% if sdk.default_base_url %} or
