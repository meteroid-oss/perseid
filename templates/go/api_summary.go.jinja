{% from "types/macros.go.jinja" import go_ident, go_export, go_security, go_words, go_article -%}
{% set _ = set_summary_filename("client.go") -%}
{% set pkg = sdk.package_name -%}
{% set ns = namespace(example="") -%}
{#- The doc example calls a list operation, else any GET needing no arguments. -#}
{% for prefix in ["List", ""] -%}
{% for resource in api.resources -%}
{% for op in resource.operations if go_export(op.name) is startingwith(prefix) and op.method == "get" and not op.path_params and not (op | has_required_query_or_header_params) and op.request_body_kind == "none" -%}
{% if not ns.example %}{% set ns.example = "client." ~ go_ident(resource.name) ~ "()." ~ go_export(op.name) ~ "(ctx" ~ (", nil" if op | has_query_or_header_params else "") ~ ")" %}{% endif -%}
{% endfor -%}
{% endfor -%}
{% endfor -%}
