{% from "types/macros.go.jinja" import go_deprecated -%}
{% set type_name = type.name | to_upper_camel_case -%}
package {{ sdk.package_name }}

{{ doc_comment }}
{% if type.deprecated %}{{ go_deprecated("type") }}
{% endif %}type {{ type_name }} string

// Known values of {{ type_name }}.
//
// The API may add new values over time; unknown values round-trip unchanged.
const (
{% for value in type.values %}{{ type_name }}{{ value | to_upper_camel_case }} {{ type_name }} = "{{ value }}"
{% endfor %})

// All{{ type_name }}Values lists every {{ type_name }} value known to this SDK version.
var All{{ type_name }}Values = []{{ type_name }}{
{% for value in type.values %}{{ type_name }}{{ value | to_upper_camel_case }},
{% endfor %}}

// String returns the wire representation of the value.
func (e {{ type_name }}) String() string {
	return string(e)
}

// IsKnown reports whether the value is one this SDK version knows about.
func (e {{ type_name }}) IsKnown() bool {
	for _, known := range All{{ type_name }}Values {
		if e == known {
			return true
		}
	}
	return false
}
