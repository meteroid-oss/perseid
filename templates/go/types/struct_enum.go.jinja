//
// It is a tagged union discriminated by the {{ type.discriminator_field }} field.
{% else %}// {{ type_name }} is a tagged union discriminated by the {{ type.discriminator_field }} field.
{% if doc_comment %}//
{{ doc_comment }}
{% endif %}{% endif %}//
// When [{{ type_name }}.IsKnown] reports true, exactly one variant pointer is
// set, matching {{ disc_field }}. A variant added to the API after this SDK
// version was released still decodes without error, but with every variant
// pointer nil: always give a `switch` on {{ disc_field }} a `default:` branch (or
// check IsKnown first) instead of dereferencing a pointer unconditionally. The
// unknown variant's JSON is available from [{{ type_name }}.Raw].
{% if type.deprecated %}//
{{ go_deprecated("type") }}
{% endif %}type {{ type_name }} struct {
// {{ disc_field }} selects the active variant. Compare it against the
// {{ type_name }}* constants.
{{ disc_field }} {{ tag_type }} `json:"{{ type.discriminator_field }}"`
{% for field in shared %}
{% if field.description is defined %}{{ field.description | to_doc_comment(style="go") }}
{% endif %}{{ go_export(field.name) }} {{ shared_type(field) }} {{ go_json_tag(field) }}
{% endfor %}
{% for variant in known %}// {{ variant_field(variant) }} is set when {{ disc_field }} is {{ go_const(type.name, variant.name, type_names) }}.
{{ variant_field(variant) }} *{{ go_ident(variant.schema_ref) }} `json:"-"`
{% endfor %}
// raw keeps the payload of a variant this SDK version does not know about, so
// that decoding and re-encoding an unknown variant preserves every field and
// value. It is not byte-for-byte identical: `encoding/json` compacts the
// whitespace and escapes `<`, `>` and `&` as `\u003c`, `\u003e` and `\u0026`.
raw json.RawMessage
}

// {{ tag_type }} is the {{ type.discriminator_field }} of {{ go_article(type_name) }} [{{ type_name }}], one of the {{ type_name }}*
// constants for a variant this SDK version knows.
type {{ tag_type }} string

// Discriminator values for {{ type_name }}.
const (
{% for variant in type.variants %}{{ go_const(type.name, variant.name, type_names) }} {{ tag_type }} = {{ variant.name | tojson }}
{% endfor %})

{% for variant in known %}// New{{ type_name }}{{ go_export(variant.name) }} builds a {{ type_name }} holding the {{ variant.name }} variant.
func New{{ type_name }}{{ go_export(variant.name) }}(value {{ go_ident(variant.schema_ref) }}) {{ type_name }} {
	return {{ type_name }}{ {{ disc_field }}: {{ go_const(type.name, variant.name, type_names) }}, {{ variant_field(variant) }}: &value}
}

{% endfor %}
// IsKnown reports whether {{ disc_field }} is one of the variants this SDK version
// knows about, i.e. one of the {{ type_name }}* constants. It is false for a
// variant added to the API later, whose payload is then only available from
// [{{ type_name }}.Raw].
func (u {{ type_name }}) IsKnown() bool {
{% if known %}	switch u.{{ disc_field }} {
	case {% for variant in known %}{% if not loop.first %}, {% endif %}{{ go_const(type.name, variant.name, type_names) }}{% endfor %}:
		return true
	}
{% endif %}	return false
}

// Raw returns the JSON of a variant this SDK version does not know about, as
// decoded (see [{{ type_name }}.IsKnown]). It is nil for a known variant, and
// for a value that was not decoded from JSON. The returned slice is a copy.
func (u {{ type_name }}) Raw() json.RawMessage {
	if u.IsKnown() || len(u.raw) == 0 {
		return nil
	}
	return append(json.RawMessage(nil), u.raw...)
}

// MarshalJSON implements json.Marshaler.
func (u {{ type_name }}) MarshalJSON() ([]byte, error) {
{% if shared %}	shared := struct {
{% for field in shared %}		{{ go_export(field.name) }} {{ shared_type(field) }} {{ go_json_tag(field) }}
{% endfor %}	}{ {% for field in shared %}{% if not loop.first %}, {% endif %}{{ go_export(field.name) }}: u.{{ go_export(field.name) }}{% endfor %} }
{% endif %}	switch u.{{ disc_field }} {
{% for variant in known %}	case {{ go_const(type.name, variant.name, type_names) }}:
		if u.{{ variant_field(variant) }} == nil {
			return nil, &UnionError{Union: "{{ type_name }}", Discriminator: string(u.{{ disc_field }}), Reason: "variant payload is nil"}
		}
		return marshalUnionVariant("{{ type.discriminator_field }}", string(u.{{ disc_field }}), u.{{ variant_field(variant) }}{% if shared %}, shared{% endif %})
{% endfor %}	}

	if len(u.raw) > 0 {
		return u.raw, nil
	}
	if u.{{ disc_field }} == "" {
		return nil, &UnionError{Union: "{{ type_name }}", Discriminator: "", Reason: "no variant set"}
	}
	return nil, &UnionError{Union: "{{ type_name }}", Discriminator: string(u.{{ disc_field }}), Reason: "unknown discriminator"}
}

// UnmarshalJSON implements json.Unmarshaler.
//
// Payloads carrying an unrecognized discriminator are kept rather than rejected,
// so a newer API version does not break older SDK builds. Re-encoding such a
// value reproduces the same JSON document, though not necessarily the same
// bytes: `encoding/json` compacts whitespace and escapes `<`, `>` and `&`.
func (u *{{ type_name }}) UnmarshalJSON(data []byte) error {
	var tag struct {
		{{ disc_field }} {{ tag_type }} `json:"{{ type.discriminator_field }}"`
{% for field in shared %}		{{ go_export(field.name) }} {{ shared_type(field) }} {{ go_json_tag(field) }}
{% endfor %}	}
	if err := json.Unmarshal(data, &tag); err != nil {
		return err
	}

	*u = {{ type_name }}{ {{ disc_field }}: tag.{{ disc_field }}{% for field in shared %}, {{ go_export(field.name) }}: tag.{{ go_export(field.name) }}{% endfor %} }
	switch tag.{{ disc_field }} {
{% for variant in known %}	case {{ go_const(type.name, variant.name, type_names) }}:
		u.{{ variant_field(variant) }} = new({{ go_ident(variant.schema_ref) }})
		return json.Unmarshal(data, u.{{ variant_field(variant) }})
{% endfor %}	default:
		u.raw = append(json.RawMessage(nil), data...)
		return nil
	}
}
