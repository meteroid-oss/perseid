{% endif %}	switch u.{{ disc_field }} {
{% for variant in known %}	case {{ go_const(type.name, variant.name, type_names) }}:
		if u.{{ variant_field(variant) }} == nil {
			return nil, &UnionError{Union: "{{ type_name }}", Discriminator: string(u.{{ disc_field }}), Reason: "variant payload is nil"}
		}
		return {% if adjacent %}marshalAdjacentVariant({{ type.discriminator_field | tojson }}, string(u.{{ disc_field }}), {{ type.content_field | tojson }}, u.{{ variant_field(variant) }}{% else %}marshalUnionVariant({{ type.discriminator_field | tojson }}, {{ wire_tag(variant) }}, u.{{ variant_field(variant) }}{% endif %}{% if shared %}, shared{% endif %})
{% endfor %}{% for variant in bare %}	case {{ go_const(type.name, variant.name, type_names) }}:
		return marshalAdjacentVariant({{ type.discriminator_field | tojson }}, string(u.{{ disc_field }}), {{ type.content_field | tojson }}, nil{% if shared %}, shared{% endif %})
{% endfor %}	}

	if len(u.raw) > 0 {
		return u.raw, nil
	}
	if u.{{ disc_field }} == "" {
		return nil, &UnionError{Union: "{{ type_name }}", Discriminator: "", Reason: "no variant set"}
	}
	return nil, &UnionError{Union: "{{ type_name }}", Discriminator: string(u.{{ disc_field }}), Reason: "unknown discriminator"}
}

