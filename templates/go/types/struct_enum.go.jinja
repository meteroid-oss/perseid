{% from "types/macros.go.jinja" import go_deprecated, go_ident, go_export, go_const, go_field_type, go_json_tag, go_union_name, go_union, go_article -%}
{% set type_name = go_ident(type.name) -%}
{% set disc_field = go_export(type.discriminator_field) -%}
{% set ns_tag = namespace(consts=[]) -%}
{% for variant in type.variants %}{% set ns_tag.consts = ns_tag.consts + [go_const(type.name, variant.name, type_names)] %}{% endfor -%}
{% set tag_type = (type_name ~ disc_field) | go_name -%}
{% if tag_type in type_names or tag_type in ns_tag.consts %}{% set tag_type = (type_name ~ "Discriminator") | go_name %}{% endif -%}
{#- Go has no sum types: a tagged union is a struct holding the discriminator,
    the fields every variant shares and one pointer per variant. -#}
{% if type.repr != "internally_tagged" -%}
{{ panic("go codegen: struct enum `" ~ type.name ~ "` uses the `" ~ type.repr ~ "` representation, which the Go templates do not implement yet") }}
{%- endif -%}
{% for variant in type.variants -%}
{% if variant.type != "ref" -%}
{{ panic("go codegen: struct enum `" ~ type.name ~ "` has an inline-struct variant `" ~ variant.name ~ "`, which the Go templates do not implement yet") }}
{%- endif -%}
{% endfor -%}
{% set shared = type.fields | rejectattr("name", "equalto", type.discriminator_field) | list -%}
{% for field in shared if field.flatten -%}
{{ panic("go codegen: struct enum `" ~ type.name ~ "` flattens `" ~ field.name ~ "` into its shared fields, which the Go templates do not implement yet") }}
{%- endfor -%}
{% set known = type.variants | selectattr("schema_ref", "defined") | list -%}
{#- A variant field must not clash with the discriminator, a shared field or a method. -#}
{% set ns = namespace(reserved=[disc_field, "Raw", "IsKnown", "MarshalJSON", "UnmarshalJSON"]) -%}
{% for field in shared %}{% set ns.reserved = ns.reserved + [go_export(field.name)] %}{% endfor -%}
{% macro variant_field(variant) %}{% set name = go_export(variant.name) %}{{ name ~ "Variant" if name in ns.reserved else name }}{% endmacro -%}
{% macro shared_type(field) %}{{ go_field_type(field, false, go_union_name(type.name, field.name, field.type, type_names)) }}{% endmacro -%}
{% set unions %}{% for field in shared %}{% set union = go_union_name(type.name, field.name, field.type, type_names) %}{% if union %}
{{ go_union(union, field.type) }}
{% endif %}{% endfor %}{% endset -%}
{% set rendered_types %}{% for field in shared %}{{ shared_type(field) }} {% endfor %}{{ unions }}{% endset -%}
package {{ sdk.package_name }}

