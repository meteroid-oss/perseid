{% endif %}{% if type.deprecated %}//
{{ go_deprecated("type") }}
{% endif %}type {{ type_name }} struct {
{% for field in type.fields %}{% if field.description is defined %}{{ field.description | to_doc_comment(style="go") }}
{% endif %}{% if field in defaulted %}{% if field.description is defined %}//
{% endif %}// Encodes as {{ defaults[field.name] | tojson }} when left empty.
{% endif %}{% if field.type.is_datetime() %}// RFC 3339 timestamp.
{% endif %}{% if field.deprecated %}{% if field.description is defined or field in defaulted or field.type.is_datetime() %}//
{% endif %}{{ go_deprecated("field") }}
{% endif %}{{ go_export(field.name) }} {{ field_type(field) }} {{ go_json_tag(field) }}

{% endfor %}// {{ extra }} holds the properties this SDK version does not know, as
