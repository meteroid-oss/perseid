import (
	"encoding/json"
	"time"
)
{% elif "time.Time" in rendered_types %}
import "time"
{% elif "json." in rendered_types %}
import "encoding/json"
{% endif %}
{{ doc_comment }}
{% if type.deprecated %}{{ go_deprecated("type") }}
{% endif %}type {{ type_name }} struct {
{% for field in type.fields %}{% if not loop.first %}
{% endif %}{% if field.description is defined %}{{ field.description | to_doc_comment(style="go") }}
{% endif %}{% if field in defaulted %}{% if field.description is defined %}//
{% endif %}// Encodes as {{ defaults[field.name] | tojson }} when left empty.
{% endif %}{% if field.type.is_datetime() %}// RFC 3339 timestamp.
{% endif %}{% if field.deprecated %}{{ go_deprecated("field") }}
{% endif %}{% if field.flatten %}{{ go_type(field.type) }}{% else %}{{ go_export(field.name) }} {{ field_type(field) }} {{ go_json_tag(field) }}{% endif %}
{% endfor %}}
{% if defaulted %}
// MarshalJSON implements json.Marshaler, filling in the discriminator.
func (v {{ type_name }}) MarshalJSON() ([]byte, error) {
	type plain {{ type_name }}
{% for field in defaulted %}{% set value = defaults[field.name] | tojson if go_type(field.type) == "string" else go_type(field.type) ~ "(" ~ (defaults[field.name] | tojson) ~ ")" %}{% if field_type(field) is startingwith("*") %}	if v.{{ go_export(field.name) }} == nil {
		v.{{ go_export(field.name) }} = Ptr({{ value }})
	}
{% else %}	if v.{{ go_export(field.name) }} == "" {
		v.{{ go_export(field.name) }} = {{ value }}
	}
{% endif %}{% endfor %}	return json.Marshal(plain(v))
}
{% endif %}{{ unions }}
