{% endfor %}	})
{% else %}	return json.Marshal(plain(v))
{% endif %}}
{% endif %}{% if untagged %}
// UnmarshalJSON implements json.Unmarshaler.
func (v *{{ type_name }}) UnmarshalJSON(data []byte) error {
	type plain {{ type_name }}
	if err := json.Unmarshal(data, (*plain)(v)); err != nil {
		return err
	}
	return unmarshalFields(data, map[string]any{
{% for field in untagged %}		{{ field.name | tojson }}: &v.{{ go_export(field.name) }},
{% endfor %}	})
