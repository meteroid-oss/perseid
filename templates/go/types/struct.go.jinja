{% from "types/macros.go.jinja" import go_field_type, go_json_tag, go_deprecated, go_ident, go_export, go_type, go_union_name, go_union -%}
{% set type_name = go_ident(type.name) -%}
{% set patch = patch_body and sdk.patch_nullable -%}
{% macro field_type(field) %}{% if field.flatten %}{{ go_type(field.type) }}{% else %}{{ go_field_type(field, patch, go_union_name(type.name, field.name, field.type, type_names)) }}{% endif %}{% endmacro -%}
{% set unions %}{% for field in type.fields if not field.flatten %}{% set union = go_union_name(type.name, field.name, field.type, type_names) %}{% if union %}
{{ go_union(union, field.type) }}
{% endif %}{% endfor %}{% endset -%}
{% set defaults = type.discriminator_defaults | default({}) -%}
{#- A flattened type's promoted MarshalJSON would take over from plain(v). -#}
{% set ns = namespace(defaulted=[]) -%}
{% for field in type.fields if field.name in defaults and not (type.fields | selectattr("flatten") | list) %}{% set ns.defaulted = ns.defaulted + [field] %}{% endfor -%}
{% set defaulted = ns.defaulted -%}
{% set rendered_types %}{% for field in type.fields %}{{ field_type(field) }} {% endfor %}{{ unions }}{% if defaulted %} json.{% endif %}{% endset -%}
