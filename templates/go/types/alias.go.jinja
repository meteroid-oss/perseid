{% set union_name = go_ident(type.name) ~ ("" if type.target.is_union() else "Item") -%}
{% set target = go_type(type.target, union_name if union else none) -%}
{% set rendered = target ~ (go_union(union_name, type.target) if union else "") -%}
package {{ sdk.package_name }}

{{ go_imports(rendered, ["encoding/json"] if "json." in rendered else []) }}

{% if union and type.target.is_union() %}{{ go_union(union_name, type.target) | replace("// " ~ union_name ~ " is one of", doc_comment ~ "\n//\n// " ~ union_name ~ " is one of" if doc_comment else "// " ~ union_name ~ " is one of") }}
{% else %}{% if not named %}// {{ go_ident(type.name) }} is the {{ type.name }} schema of the {{ sdk.client_name }} API.
{% if doc_comment %}//
{% endif %}{% endif %}{% if doc_comment %}{{ doc_comment }}
{% endif %}type {{ go_ident(type.name) }} = {{ target }}
