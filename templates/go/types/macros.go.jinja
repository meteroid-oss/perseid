{#
    Shared helpers for the Go templates.

    Every macro here is intentionally strict: anything the templates do not know
    how to render calls `panic()` so the codegen fails loudly instead of quietly
    dropping a field, a parameter or a whole operation.
-#}

{#- Go keywords + the identifiers the generated method bodies use for their own
    locals. A parameter that would shadow one of them gets a trailing `_`. -#}
{% set GO_RESERVED = [
    "break", "case", "chan", "const", "continue", "default", "defer", "else",
    "fallthrough", "for", "func", "go", "goto", "if", "import", "interface",
    "map", "package", "range", "return", "select", "struct", "switch", "type",
    "var",
    "append", "cap", "clear", "close", "complex", "copy", "delete", "imag",
    "len", "make", "max", "min", "new", "panic", "print", "println", "real",
    "recover",
    "any", "bool", "byte", "complex64", "complex128", "error", "float32",
    "float64", "int", "int8", "int16", "int32", "int64", "rune", "string",
    "uint", "uint8", "uint16", "uint32", "uint64", "uintptr",
    "false", "iota", "nil", "true",
    "a", "ctx", "options", "opts", "req", "out", "err", "vals", "v",
] -%}

{#- A local (unexported) Go identifier that is safe to use as a parameter name. -#}
{% macro go_local(name) -%}
    {%- set ident = name | ident("camel", "go") | go_name -%}
    {%- if ident in GO_RESERVED -%}{{ ident }}_{%- else -%}{{ ident }}{%- endif -%}
{%- endmacro %}

{#- The Go type of a value. Any-JSON (`{}` in the spec) is `json.RawMessage` at
    any depth: `map[string]any` would reject arrays, scalars and null. A typed
    union, when `union` names its Go type, is that type. -#}
{% macro go_type(ty, union=none) -%}
    {%- if union and ty.is_union() -%}
        {{ union }}
    {%- elif union and (ty.is_list() or ty.is_set()) -%}
        []{{ go_type(ty.inner_type(), union) }}
    {%- elif union and ty.is_map() -%}
        map[string]{{ go_type(ty.value_type(), union) }}
    {%- else -%}
        {{ ty.to_go() | replace("map[string]any", "json.RawMessage") | go_name }}
    {%- endif -%}
{%- endmacro %}

{#- Non-empty when `ty` is a union, or a collection of one, rendered as a type. -#}
{% macro go_has_union(ty) -%}
    {%- if ty.is_union() -%}
        {{ sdk.typed_unions | default(false) }}
    {%- elif ty.is_list() or ty.is_set() -%}
        {{ go_has_union(ty.inner_type()) }}
    {%- elif ty.is_map() -%}
        {{ go_has_union(ty.value_type()) }}
    {%- endif -%}
{%- endmacro %}

{#- The Go type of the union in field `name` of `owner`: `{Owner}{Field}`, with
    `Item` for the items of a collection. Empty when the field has no typed union. -#}
{% macro go_union_name(owner, name, ty, type_names) -%}
    {%- if go_has_union(ty) == "true" -%}
        {%- set base = (owner | to_upper_camel_case) ~ (name | ident("pascal", "go")) ~ ("" if ty.is_union() else "Item") -%}
        {{ (base ~ ("Union" if base in type_names else "")) | go_name }}
    {%- endif -%}
{%- endmacro %}

{% macro go_union_field(variant) -%}
    {%- set field = variant.name | ident("pascal", "go") | go_name -%}
    {{ field ~ ("Variant" if field in ["Raw", "MarshalJSON", "UnmarshalJSON", "As", "ID", "Id"] else "") }}
{%- endmacro %}

{#- The declaration of the union `name` found in `ty`: one pointer per variant,
    decoded by the JSON type of the value. -#}
{% macro go_union(name, ty) -%}
{%- if ty.is_list() or ty.is_set() -%}
{{ go_union(name, ty.inner_type()) }}
{%- elif ty.is_map() -%}
{{ go_union(name, ty.value_type()) }}
{%- else -%}
{%- set variants = ty.union_variants() %}
{%- set objects = ty.union_mode() != "json" %}
// {{ name }} is one of {% for v in variants %}{% if not loop.first %}{{ " or " if loop.last else ", " }}{% endif %}{% if v.empty %}the empty string{% elif v.type.is_schema_ref() %}{{ go_article(go_type(v.type)) }} [{{ go_type(v.type) }}]{% else %}{{ "an" if v.name[0] in "aeiou" else "a" }} {{ v.name | replace("_", " ") }}{% endif %}{% endfor %}.
//
// At most one field is set, and the zero value encodes as null. A value of
// another JSON type, from a newer API version, is kept as [{{ name }}.Raw].
{%- if objects %}
{%- if ty.union_mode() == "rules" %}
// An object is the first variant whose conditions it meets:
{%- for v in ty.object_variants() %}
//   - {{ go_union_field(v) }}: {% for c in v.when %}{% if not loop.first %} and {% endif %}{{ c.property }} {% if c.value is defined %}is {{ c.value | tojson }}{% else %}is present{% endif %}{% else %}any object{% endfor %}
{%- endfor %}
{%- else %}
// An object is the variant whose required properties are all present and which
// has the most of its properties, the first one on ties.
{%- endif %}
// An object that no variant decodes is kept as Raw too.
{%- endif %}
type {{ name }} struct {
{% for v in variants %}{% if v.empty %}	// {{ go_union_field(v) }} reports the empty string.
	{{ go_union_field(v) }} bool
{% else %}	{{ go_union_field(v) }} {% if not (v.type.is_list() or v.type.is_set() or v.type.is_map() or v.type.is_json_object()) %}*{% endif %}{{ go_type(v.type) }}
{% endif %}{% endfor %}
	raw json.RawMessage
}
{% for v in variants %}
// New{{ name }}{% if v.empty %}Empty returns the empty string {{ name }}.
func New{{ name }}Empty() {{ name }} {
	return {{ name }}{ {{ go_union_field(v) }}: true}
}
{% else %}From{{ go_union_field(v) }} returns a {{ name }} holding value.
func New{{ name }}From{{ go_union_field(v) }}(value {{ go_type(v.type) }}) {{ name }} {
	return {{ name }}{ {{ go_union_field(v) }}: {% if not (v.type.is_list() or v.type.is_set() or v.type.is_map() or v.type.is_json_object()) %}&{% endif %}value}
}
{% endif %}{% endfor %}
// Raw returns the JSON of a value of a type this SDK version does not expect,
// as decoded, or nil.
func (u {{ name }}) Raw() json.RawMessage {
	return append(json.RawMessage(nil), u.raw...)
}

{% if objects %}
// As decodes the value into target, such as another variant than the one
// decoding picked.
func (u {{ name }}) As(target any) error {
	data, err := u.MarshalJSON()
	if err != nil {
		return err
	}
	return json.Unmarshal(data, target)
}
{% endif %}
{% set strings = variants | selectattr("name", "equalto", "string") | list -%}
{% set expanded = variants | selectattr("id") | list -%}
{% if strings and expanded %}
// ID returns the string, or the id of the expanded object; "" for other values.
func (u {{ name }}) ID() string {
	switch {
	case u.{{ go_union_field(strings[0]) }} != nil:
		return *u.{{ go_union_field(strings[0]) }}
{% for v in expanded %}{% set f = "u." ~ go_union_field(v) %}{% set id = f ~ "." ~ go_export("id") %}	case {{ f }} != nil{% if v.id == "optional" %} && {{ id }} != nil{% endif %}:
		return {% if v.id == "optional" %}*{% endif %}{{ id }}
{% endfor %}	}
	return ""
}
{% endif %}
// MarshalJSON implements json.Marshaler.
func (u {{ name }}) MarshalJSON() ([]byte, error) {
	switch {
{% for v in variants %}	case u.{{ go_union_field(v) }}{% if not v.empty %} != nil{% endif %}:
		return {% if v.empty %}[]byte(`""`), nil{% else %}json.Marshal(u.{{ go_union_field(v) }}){% endif %}
{% endfor %}	case len(u.raw) > 0:
		return u.raw, nil
	}
	return []byte("null"), nil
}

// UnmarshalJSON implements json.Unmarshaler.
func (u *{{ name }}) UnmarshalJSON(data []byte) error {
	*u = {{ name }}{}
	switch jsonKind(data) {
	case "null":
		return nil
{% if objects %}	case "object":
{% set candidates = ty.object_variants() %}{% if ty.union_mode() == "rules" %}		switch {
{% for v in candidates %}		case {% if v.when %}unionMatches(data{% for c in v.when %}, unionCondition{ {{ c.property | tojson }}, {{ (c.value | tojson | tojson) if c.value is defined else '""' }} }{% endfor %}){% else %}true{% endif %}:
			if json.Unmarshal(data, &u.{{ go_union_field(v) }}) == nil {
				return nil
			}
			u.{{ go_union_field(v) }} = nil
{% endfor %}		}
{% else %}		switch unionBestMatch(data{% for v in candidates %},
			[2][]string{ { {% for p in v.required %}{{ p | tojson }}{% if not loop.last %}, {% endif %}{% endfor %} }, { {% for p in v.properties %}{{ p | tojson }}{% if not loop.last %}, {% endif %}{% endfor %} } }{% endfor %},
		) {
{% for v in candidates %}		case {{ loop.index0 }}:
			if json.Unmarshal(data, &u.{{ go_union_field(v) }}) == nil {
				return nil
			}
			u.{{ go_union_field(v) }} = nil
{% endfor %}		}
{% endif %}{% endif %}{% for v in variants if not (objects and v.json_type == "object") %}	case "{{ "number" if v.json_type == "integer" else v.json_type }}":
{% if v.empty %}		if string(data) == `""` {
			u.{{ go_union_field(v) }} = true
			return nil
		}
{% else %}		return json.Unmarshal(data, &u.{{ go_union_field(v) }})
{% endif %}{% endfor %}	}
	u.raw = append(json.RawMessage(nil), data...)
	return nil
}
{%- endif -%}
{%- endmacro %}

{#- A type or schema name as a Go identifier. -#}
{% macro go_ident(name) -%}
    {{ name | to_upper_camel_case | go_name }}
{%- endmacro %}

{#- An exported identifier from a spec name, keywords escaped. -#}
{% macro go_export(name) -%}
    {{ name | ident("pascal", "go") | go_name }}
{%- endmacro %}

{#- The constant of an enum value or union variant, `{Type}{Value}`, suffixed with
    `Value` when that already names a schema. -#}
{% macro go_const(type_name, value, type_names) -%}
    {%- set name = (type_name | to_upper_camel_case) ~ (value | ident("pascal", "go")) -%}
    {{ (name ~ ("Value" if name in type_names else "")) | go_name }}
{%- endmacro %}

{#- The Go type of a struct field: optional fields are pointers (collections stay
    nil), required non-nullable collections marshal nil as `[]`/`{}` through
    RequiredSlice/RequiredMap, and optional nullable fields of a PATCH body are
    *Nullable[T] so they can be cleared. -#}
{% macro go_field_type(field, patch=false, union=none) -%}
    {%- if union -%}
        {%- if patch and field.nullable and not field.required -%}
            *Nullable[{{ go_type(field.type, union) }}]
        {%- elif field.required and not field.nullable and (field.type.is_list() or field.type.is_set()) -%}
            RequiredSlice[{{ go_type(field.type.inner_type(), union) }}]
        {%- elif field.required and not field.nullable and field.type.is_map() -%}
            RequiredMap[{{ go_type(field.type.value_type(), union) }}]
        {%- elif (field.required and not field.nullable) or not field.type.is_union() -%}
            {{ go_type(field.type, union) }}
        {%- else -%}
            *{{ union }}
        {%- endif -%}
    {%- elif field.type.is_json_object() -%}
        json.RawMessage
    {%- elif patch and field.nullable and not field.required -%}
        *Nullable[{{ go_type(field.type) }}]
    {%- elif field.required and not field.nullable -%}
        {%- if field.type.is_list() or field.type.is_set() -%}
            RequiredSlice[{{ go_type(field.type.inner_type()) }}]
        {%- elif field.type.is_map() -%}
            RequiredMap[{{ go_type(field.type.value_type()) }}]
        {%- else -%}
            {{ go_type(field.type) }}
        {%- endif -%}
    {%- elif field.type.is_list() or field.type.is_set() or field.type.is_map() -%}
        {{ go_type(field.type) }}
    {%- else -%}
        *{{ go_type(field.type) }}
    {%- endif -%}
{%- endmacro %}

{#- `omitempty` only for optional fields: a required nullable one sends `null`. -#}
{% macro go_json_tag(field) -%}
    `json:"{{ field.name }}{% if not field.required %},omitempty{% endif %}"`
{%- endmacro %}

{#- Render a `// Deprecated:` marker, which is the convention Go tooling
    understands. -#}
{% macro go_deprecated(what) -%}
// Deprecated: this {{ what }} is deprecated in the {{ sdk.client_name }} API.
{%- endmacro %}

{#- Convert a single (already dereferenced) query parameter value expression to
    a Go `string` expression.

    Everything that is not a scalar we know how to serialize is a hard error. -#}
{% macro go_query_scalar(ty, expr) -%}
    {%- set gt = ty.to_go() -%}
    {%- if gt == "string" -%}
        {{ expr }}
    {%- elif gt == "bool" -%}
        formatBool({{ expr }})
    {%- elif gt in ["int16", "int32", "int64"] -%}
        formatInt(int64({{ expr }}))
    {%- elif gt in ["uint16", "uint64"] -%}
        formatUint(uint64({{ expr }}))
    {%- elif gt in ["float32", "float64"] -%}
        formatFloat(float64({{ expr }}))
    {%- elif ty.is_datetime() -%}
        formatTime({{ expr }})
    {%- elif ty.is_schema_ref() -%}
        formatValue({{ expr }})
    {%- else -%}
        {{ panic("go codegen: unsupported query parameter type `" ~ gt ~ "` - add explicit support in codegen/templates/go/types/macros.go.jinja") }}
    {%- endif -%}
{%- endmacro %}

{#- The Go type of a header parameter. HTTP header values are strings, and the
    generated code hands them to `req.SetHeader` unconverted, so anything that is
    not already a Go `string` must fail rather than be silently retyped.

    `HeaderParam` (codegen/src/api/resources.rs) carries only `name` and
    `required`: unlike a query parameter it has no `type` at all, because
    `enforce_string_parameter` rejects every non-string header upstream. So when
    `p.type` is undefined, `string` is guaranteed correct rather than assumed.
    Should the codegen ever start passing a type through, this branch turns
    strict immediately instead of quietly rendering `string` for it.

    The spec currently declares no header parameters at all, so neither branch is
    reached today. -#}
{% macro go_header_type(p) -%}
    {%- if p.type is not defined -%}
        string
    {%- elif p.type.to_go() == "string" -%}
        string
    {%- else -%}
        {{ panic("go codegen: unsupported header parameter type `" ~ p.type.to_go() ~ "` for header `" ~ p.name ~ "` - add explicit support in codegen/templates/go/types/macros.go.jinja") }}
    {%- endif -%}
{%- endmacro %}

{% macro go_security(security) -%}
[][]string{ {%- for names in security %}{% if not loop.first %}, {% endif %}{ {%- for name in names %}{% if not loop.first %}, {% endif %}"{{ name }}"{% endfor -%} }{% endfor -%} }
{%- endmacro %}

{% macro go_strings(values) -%}
[]string{ {%- for v in values %}{% if not loop.first %}, {% endif %}"{{ v }}"{% endfor -%} }
{%- endmacro %}

{#- A resource name in prose, without a trailing "api" that the text adds. -#}
{% macro go_words(name) -%}
    {%- set words = name | to_snake_case | replace("_", " ") -%}
    {{ words[:-4] if words is endingwith(" api") else words }}
{%- endmacro %}

{% macro go_article(word) -%}
    {{ "an" if word[0] in "AEIOU" else "a" }}
{%- endmacro %}
