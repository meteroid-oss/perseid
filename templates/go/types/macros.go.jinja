{#- Shared helpers for the Go templates. What they cannot render calls `panic()`, so the
    codegen fails loudly instead of dropping a field, a parameter or an operation. -#}

{#- Go keywords + the identifiers the generated method bodies use for their own
    locals. A parameter that would shadow one of them gets a trailing `_`. -#}
{% set GO_RESERVED = [
    "break", "case", "chan", "const", "continue", "default", "defer", "else",
    "fallthrough", "for", "func", "go", "goto", "if", "import", "interface",
    "map", "package", "range", "return", "select", "struct", "switch", "type",
    "var",
    "append", "cap", "clear", "close", "complex", "copy", "delete", "imag",
    "len", "make", "max", "min", "new", "panic", "print", "println", "real",
    "recover",
    "any", "bool", "byte", "complex64", "complex128", "error", "float32",
    "float64", "int", "int8", "int16", "int32", "int64", "rune", "string",
    "uint", "uint8", "uint16", "uint32", "uint64", "uintptr",
    "false", "iota", "nil", "true",
    "a", "ctx", "options", "opts", "req", "out", "err", "vals", "v",
] -%}

{#- A local (unexported) Go identifier that is safe to use as a parameter name. -#}
{% macro go_local(name) -%}
    {%- set ident = name | ident("camel", "go") | go_name -%}
    {%- if ident in GO_RESERVED -%}{{ ident }}_{%- else -%}{{ ident }}{%- endif -%}
{%- endmacro %}

{#- A method argument: a local, suffixed with `Param` when the method bodies use the name. -#}
{% macro go_arg(name) -%}
    {%- set ident = go_local(name) -%}
    {{ ident ~ "Param" if ident in ["params", "resp", "page", "next", "current", "last", "item", "body"] else ident }}
{%- endmacro %}

{#- The nil checks reaching the end of `path` from `root` need, given which of its
    properties may be absent (`flags`); with `leaf` false, the last one is a slice. With
    `missing`, the checks that one is nil instead. -#}
{% macro go_path_guard(root, path, flags, leaf=true, missing=false) -%}
    {%- set ns = namespace(expr=root, checks=[]) -%}
    {%- for segment in path -%}
        {%- set ns.expr = ns.expr ~ "." ~ go_export(segment) -%}
        {%- if flags[loop.index0] and (leaf or not loop.last) %}{% set ns.checks = ns.checks + [ns.expr ~ (" == nil" if missing else " != nil")] %}{% endif -%}
    {%- endfor -%}
    {{ ns.checks | join(" || " if missing else " && ") }}
{%- endmacro %}

{#- The value at the end of `path` from `root`, once go_path_guard holds. -#}
{% macro go_path_value(root, path, flags, leaf=true) -%}
    {%- set ns = namespace(expr=root) -%}
    {%- for segment in path %}{% set ns.expr = ns.expr ~ "." ~ go_export(segment) %}{% endfor -%}
    {{ ("*" if leaf and flags[path | length - 1] else "") ~ ns.expr }}
{%- endmacro %}

{#- The Go type of a value. Any-JSON (`{}` in the spec) is `json.RawMessage` at
    any depth: `map[string]any` would reject arrays, scalars and null. A typed
    union, when `union` names its Go type, is that type. -#}
{% macro go_type(ty, union=none) -%}
    {%- if union and ty.is_union() -%}
        {{ union }}
    {%- elif union and ty.is_nullable() -%}
        {%- set inner = ty.inner_type() -%}
        {%- if inner.is_list() or inner.is_set() or inner.is_map() or inner.is_json_object() and not inner.is_union() -%}
            {{ go_type(inner, union) }}
        {%- else -%}
            *{{ go_type(inner, union) }}
        {%- endif -%}
    {%- elif union and (ty.is_list() or ty.is_set()) -%}
        []{{ go_type(ty.inner_type(), union) }}
    {%- elif union and ty.is_map() -%}
        map[string]{{ go_type(ty.value_type(), union) }}
    {%- else -%}
        {{ ty.to_go() | replace("map[string]any", "json.RawMessage") | go_name }}
    {%- endif -%}
{%- endmacro %}

{#- Non-empty when `ty` is a union, or a collection of one, rendered as a type. -#}
{% macro go_has_union(ty) -%}
    {%- if ty.is_union() -%}
        true
    {%- elif ty.is_list() or ty.is_set() or ty.is_nullable() -%}
        {{ go_has_union(ty.inner_type()) }}
    {%- elif ty.is_map() -%}
        {{ go_has_union(ty.value_type()) }}
    {%- endif -%}
{%- endmacro %}

{#- The Go type of the union in field `name` of `owner`: `{Owner}{Field}`, with
    `Item` for the items of a collection. Empty when the field has no typed union. -#}
{% macro go_union_name(owner, name, ty, type_names) -%}
    {%- if go_has_union(ty) == "true" -%}
        {%- set base = (owner | to_upper_camel_case) ~ (name | ident("pascal", "go")) ~ ("" if ty.is_union() else "Item") -%}
        {{ (base ~ ("Union" if base in type_names else "")) | go_name }}
    {%- endif -%}
{%- endmacro %}

{#- The Go field of a union variant, `Of{Variant}` as in openai-go. -#}
{% macro go_union_field(variant) -%}
    {{ "Of" ~ (variant.name | ident("pascal", "go") | go_name) }}
{%- endmacro %}

{#- The `{Variant}` of the `New...From{Variant}` constructors and `As{Variant}` accessors. -#}
{% macro go_union_variant(variant) -%}
    {{ variant.name | ident("pascal", "go") | go_name }}
{%- endmacro %}

{#- `*` when the field of a union variant is a pointer, nothing for slices, maps and raw JSON,
    which are nil when unset. -#}
{% macro go_union_pointer(v) -%}
    {%- if not (v.type.is_list() or v.type.is_set() or v.type.is_map() or v.type.is_json_object()) -%}*{%- endif -%}
{%- endmacro %}

{#- The shape of the items of an array variant, as the runtime checks the first one. -#}
{% macro go_shape(shape) -%}
    {%- if shape.items is defined and shape.items -%}
        &unionShape{ {{ shape.json_type | tojson }}, {{ go_shape(shape.items) }} }
    {%- else -%}
        &unionShape{ {{ shape.json_type | tojson }}, nil }
    {%- endif -%}
{%- endmacro %}

{#- The Go condition a JSON value of the variant's JSON type must also meet, `true` when its JSON
    type is enough. -#}
{% macro go_predicate(v) -%}
    {%- if v.empty -%}
        string(data) == `""`
    {%- elif v.json_type == "integer" -%}
        unionIsInteger(data)
    {%- elif v.json_type == "array" and v.items is defined and v.items -%}
        unionArrayOf(data, {{ go_shape(v.items) }})
    {%- else -%}
        true
    {%- endif -%}
{%- endmacro %}

{#- Tries to decode `data` as the variant, moving on to the next one when it does not fit. -#}
{% macro go_attempt(v) -%}
    {%- if v.empty -%}
        u.{{ go_union_field(v) }} = true
        return nil
    {%- else -%}
        if json.Unmarshal(data, &u.{{ go_union_field(v) }}) == nil {
            return nil
        }
        u.{{ go_union_field(v) }} = nil
    {%- endif -%}
{%- endmacro %}

{#- The declaration of the union `name` found in `ty`: one field per variant, of which at
    most one is set. -#}
{% macro go_union(name, ty) -%}
{%- if ty.is_list() or ty.is_set() or ty.is_nullable() -%}
{{ go_union(name, ty.inner_type()) }}
{%- elif ty.is_map() -%}
{{ go_union(name, ty.value_type()) }}
{%- else -%}
{%- set variants = ty.union_variants() %}
{%- set tried = ty.try_variants() %}
{%- set objects = ty.union_mode() != "json" %}
{%- set ns = namespace(kinds=[]) %}
{%- for v in tried %}{% set kind = "number" if v.json_type == "integer" else v.json_type %}{% if kind not in ns.kinds %}{% set ns.kinds = ns.kinds + [kind] %}{% endif %}{% endfor %}
// {{ name }} is one of {% for v in variants %}{% if not loop.first %}{{ " or " if loop.last else ", " }}{% endif %}{% if v.empty %}the empty string{% elif v.type.is_schema_ref() %}{{ go_article(go_type(v.type)) }} [{{ go_type(v.type) }}]{% else %}{{ "an" if v.name[0] in "aeiou" else "a" }} {{ v.name | replace("_", " ") }}{% endif %}{% endfor %}.
//
// At most one field is set, and the zero value encodes as null. A value of
// another JSON type, from a newer API version, is kept as [{{ name }}.Raw].
{%- if ty.union_decode() == "try" %}
// Variants sharing a JSON type are tried in turn: the first one the value fits
// and decodes into is set.
{%- endif %}
{%- if objects %}
{%- if ty.union_mode() == "rules" %}
// An object is the first variant whose conditions it meets:
{%- for v in ty.object_variants() %}
//   - {{ go_union_field(v) }}: {% for c in v.when %}{% if not loop.first %} and {% endif %}{{ c.property }} {% if c.value is defined %}is {{ c.value | tojson }}{% else %}is present{% endif %}{% else %}any object{% endfor %}
{%- endfor %}
{%- else %}
// An object is the variant whose required properties are all present and which
// has the most of its properties, the first one on ties.
{%- endif %}
// An object that no variant decodes is kept as Raw too.
{%- endif %}
type {{ name }} struct {
{% for v in variants %}{% if v.empty %}	// {{ go_union_field(v) }} reports the empty string.
	{{ go_union_field(v) }} bool
{% else %}	{{ go_union_field(v) }} {{ go_union_pointer(v) }}{{ go_type(v.type) }}
{% endif %}{% endfor %}
	raw json.RawMessage
}
{% for v in variants %}
{% if v.empty %}// New{{ name }}Empty returns the empty string {{ name }}.
func New{{ name }}Empty() {{ name }} {
	return {{ name }}{ {{ go_union_field(v) }}: true}
}
{% else %}// New{{ name }}From{{ go_union_variant(v) }} returns a {{ name }} holding value.
func New{{ name }}From{{ go_union_variant(v) }}(value {{ go_type(v.type) }}) {{ name }} {
	return {{ name }}{ {{ go_union_field(v) }}: {{ "&" if go_union_pointer(v) == "*" else "" }}value}
}

// As{{ go_union_variant(v) }} returns the value when it is {{ go_article(go_union_variant(v)) }} {{ go_union_variant(v) }}, as set or as
// decoded from the JSON of a value kept in [{{ name }}.Raw].
func (u {{ name }}) As{{ go_union_variant(v) }}() ({{ go_type(v.type) }}, bool) {
	if u.{{ go_union_field(v) }} != nil {
		return {{ "*" if go_union_pointer(v) == "*" else "" }}u.{{ go_union_field(v) }}, true
	}
	var value {{ go_type(v.type) }}
	if len(u.raw) > 0 && json.Unmarshal(u.raw, &value) == nil {
		return value, true
	}
	return value, false
}
{% endif %}{% endfor %}
// Kind names the variant that is set, as the spec's schema would ("string",
// "array_of_strings"...), or is empty when none is.
func (u {{ name }}) Kind() string {
	switch {
{% for v in variants %}	case u.{{ go_union_field(v) }}{% if not v.empty %} != nil{% endif %}:
		return {{ v.name | tojson }}
{% endfor %}	}
	return ""
}

// Raw returns the JSON of a value of a type this SDK version does not expect,
// as decoded, or nil.
func (u {{ name }}) Raw() json.RawMessage {
	return append(json.RawMessage(nil), u.raw...)
}

{% if objects %}
// As decodes the value into target, such as another variant than the one
// decoding picked.
func (u {{ name }}) As(target any) error {
	data, err := u.MarshalJSON()
	if err != nil {
		return err
	}
	return json.Unmarshal(data, target)
}
{% endif %}
{% set strings = variants | selectattr("name", "equalto", "string") | list -%}
{% set expanded = variants | selectattr("id") | list -%}
{% if strings and expanded %}
// ID returns the string, or the id of the expanded object; "" for other values.
func (u {{ name }}) ID() string {
	switch {
	case u.{{ go_union_field(strings[0]) }} != nil:
		return *u.{{ go_union_field(strings[0]) }}
{% for v in expanded %}{% set f = "u." ~ go_union_field(v) %}{% set id = f ~ "." ~ go_export("id") %}	case {{ f }} != nil{% if v.id == "optional" %} && {{ id }} != nil{% endif %}:
		return {% if v.id == "optional" %}*{% endif %}{{ id }}
{% endfor %}	}
	return ""
}
{% endif %}
// MarshalJSON implements json.Marshaler.
func (u {{ name }}) MarshalJSON() ([]byte, error) {
	switch {
{% for v in variants %}	case u.{{ go_union_field(v) }}{% if not v.empty %} != nil{% endif %}:
		return {% if v.empty %}[]byte(`""`), nil{% else %}json.Marshal(u.{{ go_union_field(v) }}){% endif %}
{% endfor %}	case len(u.raw) > 0:
		return u.raw, nil
	}
	return []byte("null"), nil
}

// UnmarshalJSON implements json.Unmarshaler.
func (u *{{ name }}) UnmarshalJSON(data []byte) error {
	*u = {{ name }}{}
	switch jsonKind(data) {
	case "null":
		return nil
{% for kind in ns.kinds %}	case "{{ kind }}":
{% if kind == "object" and objects %}{% set candidates = ty.object_variants() %}{% if ty.union_mode() == "rules" %}{% for v in candidates %}{% if v.when %}		if unionMatches(data{% for c in v.when %}, unionCondition{ {{ c.property | tojson }}, {{ (c.value | tojson | tojson) if c.value is defined else '""' }} }{% endfor %}) {
			{{ go_attempt(v) }}
		}
{% else %}		{{ go_attempt(v) }}
{% endif %}{% endfor %}{% else %}		for _, i := range unionBestOrder(data{% for v in candidates %},
			[2][]string{ { {% for p in v.required %}{{ p | tojson }}{% if not loop.last %}, {% endif %}{% endfor %} }, { {% for p in v.properties %}{{ p | tojson }}{% if not loop.last %}, {% endif %}{% endfor %} } }{% endfor %},
		) {
			switch i {
{% for v in candidates %}			case {{ loop.index0 }}:
				{{ go_attempt(v) }}
{% endfor %}			}
		}
{% endif %}{% else %}{% for v in tried if ("number" if v.json_type == "integer" else v.json_type) == kind %}{% set predicate = go_predicate(v) | trim %}{% if predicate == "true" %}		{{ go_attempt(v) }}
{% else %}		if {{ predicate }} {
			{{ go_attempt(v) }}
		}
{% endif %}{% endfor %}{% endif %}{% endfor %}	}
	u.raw = append(json.RawMessage(nil), data...)
	return nil
}
{%- endif -%}
{%- endmacro %}

{#- A type or schema name as a Go identifier. -#}
{% macro go_ident(name) -%}
    {{ name | to_upper_camel_case | go_name }}
{%- endmacro %}

{#- An exported identifier from a spec name, keywords escaped. -#}
{% macro go_export(name) -%}
    {{ name | ident("pascal", "go") | go_name }}
{%- endmacro %}

{#- The constant of an enum value or union variant, `{Type}{Value}`, suffixed with
    `Value` when that already names a schema. -#}
{% macro go_const(type_name, value, type_names) -%}
    {%- set name = (type_name | to_upper_camel_case) ~ (value | ident("pascal", "go")) -%}
    {{ (name ~ ("Value" if name in type_names else "")) | go_name }}
{%- endmacro %}

{#- The Go type of a struct field: optional fields are pointers (collections stay nil),
    required collections RequiredSlice/RequiredMap, optional nullable PATCH fields *Nullable[T]. -#}
{% macro go_field_type(field, patch=false, union=none) -%}
    {%- if union -%}
        {%- if patch and field.nullable and not field.required -%}
            *Nullable[{{ go_type(field.type, union) }}]
        {%- elif field.required and not field.nullable and (field.type.is_list() or field.type.is_set()) -%}
            RequiredSlice[{{ go_type(field.type.inner_type(), union) }}]
        {%- elif field.required and not field.nullable and field.type.is_map() -%}
            RequiredMap[{{ go_type(field.type.value_type(), union) }}]
        {%- elif (field.required and not field.nullable) or not field.type.is_union() -%}
            {{ go_type(field.type, union) }}
        {%- else -%}
            *{{ union }}
        {%- endif -%}
    {%- elif field.type.is_json_object() -%}
        json.RawMessage
    {%- elif patch and field.nullable and not field.required -%}
        *Nullable[{{ go_type(field.type) }}]
    {%- elif field.required and not field.nullable -%}
        {%- if field.type.is_list() or field.type.is_set() -%}
            RequiredSlice[{{ go_type(field.type.inner_type()) }}]
        {%- elif field.type.is_map() -%}
            RequiredMap[{{ go_type(field.type.value_type()) }}]
        {%- else -%}
            {{ go_type(field.type) }}
        {%- endif -%}
    {%- elif field.type.is_list() or field.type.is_set() or field.type.is_map() -%}
        {{ go_type(field.type) }}
    {%- else -%}
        *{{ go_type(field.type) }}
    {%- endif -%}
{%- endmacro %}

{#- `omitempty` only for optional fields: a required nullable one sends `null`. -#}
{% macro go_json_tag(field) -%}
    `json:"{{ field.name | go_tag }}{% if not field.required %},omitempty{% endif %}"`
{%- endmacro %}

{#- Render a `// Deprecated:` marker, which is the convention Go tooling
    understands. -#}
{% macro go_deprecated(what) -%}
// Deprecated: this {{ what }} is deprecated in the {{ sdk.client_name }} API.
{%- endmacro %}

{#- A Go `string` expression of one (dereferenced) query parameter scalar. -#}
{% macro go_query_scalar(ty, expr) -%}
    {%- set gt = ty.to_go() -%}
    {%- if gt == "string" -%}
        {{ expr }}
    {%- elif gt == "bool" -%}
        formatBool({{ expr }})
    {%- elif gt == "int64" -%}
        formatInt({{ expr }})
    {%- elif gt in ["int16", "int32"] -%}
        formatInt(int64({{ expr }}))
    {%- elif gt == "uint64" -%}
        formatUint({{ expr }})
    {%- elif gt == "uint16" -%}
        formatUint(uint64({{ expr }}))
    {%- elif gt == "float64" -%}
        formatFloat({{ expr }})
    {%- elif gt == "float32" -%}
        formatFloat(float64({{ expr }}))
    {%- elif ty.is_datetime() -%}
        formatTime({{ expr }})
    {%- elif ty.is_schema_ref() -%}
        formatValue({{ expr }})
    {%- else -%}
        {{ panic("go codegen: unsupported query parameter type `" ~ gt ~ "` - add explicit support in templates/go/types/macros.go.jinja") }}
    {%- endif -%}
{%- endmacro %}

{#- The Go type of a header parameter: headers are strings, and anything else must fail
    rather than be silently retyped. -#}
{% macro go_header_type(p) -%}
    {%- if p.json -%}
        {{ go_type(p.type) }}
    {%- elif p.type is not defined -%}
        string
    {%- elif p.type.to_go() == "string" -%}
        string
    {%- else -%}
        {{ panic("go codegen: unsupported header parameter type `" ~ p.type.to_go() ~ "` for header `" ~ p.name ~ "` - add explicit support in templates/go/types/macros.go.jinja") }}
    {%- endif -%}
{%- endmacro %}

{% macro go_security(security) -%}
[][]string{ {%- for names in security %}{% if not loop.first %}, {% endif %}{ {%- for name in names %}{% if not loop.first %}, {% endif %}{{ name | tojson }}{% endfor -%} }{% endfor -%} }
{%- endmacro %}

{% macro go_strings(values) -%}
[]string{ {%- for v in values %}{% if not loop.first %}, {% endif %}{{ v | tojson }}{% endfor -%} }
{%- endmacro %}

{#- A resource name in prose, without a trailing "api" that the text adds. -#}
{% macro go_words(name) -%}
    {%- set words = name | to_snake_case | replace("_", " ") -%}
    {{ words[:-4] if words is endingwith(" api") else words }}
{%- endmacro %}

{% macro go_article(word) -%}
    {{ "an" if word[0] in "AEIOU" else "a" }}
{%- endmacro %}
