{#
    Shared helpers for the Go templates.

    Every macro here is intentionally strict: anything the templates do not know
    how to render calls `panic()` so the codegen fails loudly instead of quietly
    dropping a field, a parameter or a whole operation.
-#}

{#- Go keywords + the identifiers the generated method bodies use for their own
    locals. A parameter that would shadow one of them gets a trailing `_`. -#}
{% set GO_RESERVED = [
    "break", "case", "chan", "const", "continue", "default", "defer", "else",
    "fallthrough", "for", "func", "go", "goto", "if", "import", "interface",
    "map", "package", "range", "return", "select", "struct", "switch", "type",
    "var",
    "append", "cap", "clear", "close", "complex", "copy", "delete", "imag",
    "len", "make", "max", "min", "new", "panic", "print", "println", "real",
    "recover",
    "any", "bool", "byte", "complex64", "complex128", "error", "float32",
    "float64", "int", "int8", "int16", "int32", "int64", "rune", "string",
    "uint", "uint8", "uint16", "uint32", "uint64", "uintptr",
    "false", "iota", "nil", "true",
    "a", "ctx", "options", "req", "out", "err", "vals", "v",
] -%}

{#- A local (unexported) Go identifier that is safe to use as a parameter name. -#}
{% macro go_local(name) -%}
    {%- set ident = name | to_lower_camel_case -%}
    {%- if ident in GO_RESERVED -%}{{ ident }}_{%- else -%}{{ ident }}{%- endif -%}
{%- endmacro %}

{#- The Go type of a value, with any-JSON (`{}` in the spec, `JsonObject` in the
    codegen) rendered as `json.RawMessage`.

    `FieldType::to_go()` renders `JsonObject` as `map[string]any`, which only
    decodes JSON *objects*: an array, a scalar or `null` would fail to decode
    and take the whole enclosing response with it. The spec uses `{}` to mean
    "any JSON value", so the Go SDK hands it over losslessly as
    `json.RawMessage`, and callers decode it into whatever type they expect.
    Genuine maps (`additionalProperties: <schema>`) are `FieldType::Map` and are
    not affected.

    Containers of any-JSON one level deep are supported; anything deeper would
    still carry a `map[string]any` and is a hard error. -#}
{% macro go_type(ty) -%}
    {%- if ty.is_json_object() -%}
        json.RawMessage
    {%- elif (ty.is_list() or ty.is_set()) and ty.inner_type().is_json_object() -%}
        []json.RawMessage
    {%- elif ty.is_map() and ty.value_type().is_json_object() -%}
        map[string]json.RawMessage
    {%- elif "map[string]any" in ty.to_go() -%}
        {{ panic("go codegen: unsupported nested any-JSON type `" ~ ty.to_go() ~ "` - add explicit support in codegen/templates/go/types/macros.go.jinja") }}
    {%- else -%}
        {{ ty.to_go() }}
    {%- endif -%}
{%- endmacro %}

{#- The Go type of a struct field, including the pointer indirection used to
    model "absent" for optional fields.

    * any-JSON -> `json.RawMessage`, never a pointer and never wrapped (see below)
    * required and non-nullable collections -> `RequiredSlice[T]` / `RequiredMap[V]`
    * required and non-nullable, anything else -> plain `T`
    * slices / maps -> never a pointer, `nil` already means absent
    * anything else -> `*T`

    The `Required*` wrappers exist because the zero value of a Go slice or map is
    `nil`, which `encoding/json` writes as `null`. The spec declares these fields
    required *and* non-nullable, so `null` is schema-invalid: the wrappers give
    them a `MarshalJSON` that writes `[]` / `{}` instead. They are defined types
    over `[]T` / `map[string]V`, so a plain slice or map literal still assigns to
    them and they still range, index and append like the underlying type.

    A required *nullable* collection deliberately keeps the bare `[]T` / `map`
    type: for those, `nil` -> `null` is the correct wire representation. (The
    current spec has none, but the distinction is load-bearing.)

    Any-JSON needs no wrapper: `null` is itself a valid "any JSON" value, and a
    nil `json.RawMessage` marshals as `null`, so a required any-JSON field left
    unset still produces valid JSON. An optional one uses `omitempty`, which
    drops a nil (empty) `json.RawMessage` from the payload; set it to
    `json.RawMessage("null")` to send an explicit `null`.

    The wrappers are attached to the field type rather than to the struct on
    purpose. A generated `MarshalJSON` on the struct would be promoted through
    the `flatten` embeds -- e.g. `CustomerEvent` embeds `CustomerEventData`,
    which has required collections -- and would silently hijack the outer
    struct's marshaling, dropping every field declared outside the embed.
-#}
{% macro go_field_type(field) -%}
    {%- if field.type.is_json_object() -%}
        json.RawMessage
    {%- elif field.required and not field.nullable -%}
        {%- if field.type.is_list() or field.type.is_set() -%}
            RequiredSlice[{{ go_type(field.type.inner_type()) }}]
        {%- elif field.type.is_map() -%}
            RequiredMap[{{ go_type(field.type.value_type()) }}]
        {%- else -%}
            {{ go_type(field.type) }}
        {%- endif -%}
    {%- elif field.type.is_list() or field.type.is_set() or field.type.is_map() -%}
        {{ go_type(field.type) }}
    {%- else -%}
        *{{ go_type(field.type) }}
    {%- endif -%}
{%- endmacro %}

{#- The struct tag of a field. `omitempty` is only used for fields that the API
    treats as optional; a required-but-nullable field must still be serialized
    as an explicit `null`. -#}
{% macro go_json_tag(field) -%}
    `json:"{{ field.name }}{% if not field.required %},omitempty{% endif %}"`
{%- endmacro %}

{#- Render a `// Deprecated:` marker, which is the convention Go tooling
    understands. -#}
{% macro go_deprecated(what) -%}
// Deprecated: this {{ what }} is deprecated in the {{ sdk.client_name }} API.
{%- endmacro %}

{#- Convert a single (already dereferenced) query parameter value expression to
    a Go `string` expression.

    Everything that is not a scalar we know how to serialize is a hard error. -#}
{% macro go_query_scalar(ty, expr) -%}
    {%- set gt = ty.to_go() -%}
    {%- if gt == "string" -%}
        {{ expr }}
    {%- elif gt == "bool" -%}
        formatBool({{ expr }})
    {%- elif gt in ["int16", "int32", "int64"] -%}
        formatInt(int64({{ expr }}))
    {%- elif gt in ["uint16", "uint64"] -%}
        formatUint(uint64({{ expr }}))
    {%- elif gt in ["float32", "float64"] -%}
        formatFloat(float64({{ expr }}))
    {%- elif ty.is_datetime() -%}
        formatTime({{ expr }})
    {%- elif ty.is_schema_ref() -%}
        {#- string aliases and string enums are both `string` underneath -#}
        string({{ expr }})
    {%- else -%}
        {{ panic("go codegen: unsupported query parameter type `" ~ gt ~ "` - add explicit support in codegen/templates/go/types/macros.go.jinja") }}
    {%- endif -%}
{%- endmacro %}

{#- The Go type of a header parameter. HTTP header values are strings, and the
    generated code hands them to `req.SetHeader` unconverted, so anything that is
    not already a Go `string` must fail rather than be silently retyped.

    `HeaderParam` (codegen/src/api/resources.rs) carries only `name` and
    `required`: unlike a query parameter it has no `type` at all, because
    `enforce_string_parameter` rejects every non-string header upstream. So when
    `p.type` is undefined, `string` is guaranteed correct rather than assumed.
    Should the codegen ever start passing a type through, this branch turns
    strict immediately instead of quietly rendering `string` for it.

    The spec currently declares no header parameters at all, so neither branch is
    reached today. -#}
{% macro go_header_type(p) -%}
    {%- if p.type is not defined -%}
        string
    {%- elif p.type.to_go() == "string" -%}
        string
    {%- else -%}
        {{ panic("go codegen: unsupported header parameter type `" ~ p.type.to_go() ~ "` for header `" ~ p.name ~ "` - add explicit support in codegen/templates/go/types/macros.go.jinja") }}
    {%- endif -%}
{%- endmacro %}
