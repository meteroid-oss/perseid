{#- The API as Go names it, for api.md and the README's examples. An example is a
    `{resource, operation, path_args, body, result, item}` the README receives. -#}
{% from "types/macros.go.jinja" import go_export, go_ident, go_local %}

{#- The heading of a resource in api.md, and links to every resource's. -#}
{% macro title(name) %}{{ name | to_snake_case | replace("_", " ") | capitalize }}{% endmacro %}

{% macro contents(resources) -%}
    {%- for r in resources %}[{{ title(r.name) }}](#{{ r.name | to_kebab_case }}){% if not loop.last %} · {% endif %}{% endfor -%}
{%- endmacro %}

{% macro resource(name) %}client.{{ go_ident(name) }}(){% endmacro %}

{% macro method(op) %}{{ go_export(op.name) }}{% endmacro %}

{% macro model_path(name) %}{{ name | go_file }}.go{% endmacro %}

{% macro resource_path(name) %}{{ name | go_file }}.go{% endmacro %}

{#- A variable holding a value of schema `name`, `fallback` without one. -#}
{% macro var(name, fallback) -%}
    {%- set id = go_local(name) if name else fallback -%}
    {{ fallback if id in ["client", "page", "stream", "resp", "err", "ctx"] or id is endingwith("_") else id }}
{%- endmacro %}

{#- The page type of a paginated example, `WidgetsListPage`. -#}
{% macro page_type(ex) %}{{ (go_ident(ex.resource) ~ (ex.operation.name | ident("pascal", "go")) ~ "Page") | go_name }}{% endmacro %}

{#- The response type a paginated example's page embeds. -#}
{% macro body_type(ex) %}{{ go_ident(ex.result) }}{% endmacro %}

{#- A response field the page of a paginated example promotes, `page.Meta.TotalPages`. -#}
{% macro page_field(ex) -%}
    {%- set pg = ex.operation.pagination -%}
    {%- set path = pg.total or pg.total_pages or pg.next_cursor or pg.has_more or pg["items"] -%}
    page{% for segment in path %}.{{ go_export(segment) }}{% endfor -%}
{%- endmacro %}

{#- A literal, without its type when `typed` is false, as the items of a list leave it out. -#}
{% macro literal(arg, typed=true) -%}
    {%- if arg.kind == "uuid" %}uuid.MustParse({{ arg.value | tojson }})
    {%- elif arg.kind == "date" %}{% set parts = arg.value | split("-") | list %}{{ sdk.package_name ~ ".Date" if typed }}{Year: {{ parts[0] | int }}, Month: {{ parts[1] | int }}, Day: {{ parts[2] | int }}}
    {%- elif arg.kind == "enum" %}{{ sdk.package_name }}.{{ go_ident(arg.schema) }}({{ arg.value | tojson }})
    {%- elif arg.kind == "list" %}{{ type_of(arg) if typed }}{{ "{" }}{% for item in arg["items"] %}{{ literal(item, item.kind not in ["list", "object", "date"]) }}{% if not loop.last %}, {% endif %}{% endfor %}}
    {%- elif arg.kind == "object" %}{{ type_of(arg) if typed }}{{ "{" }}{% for f in arg.fields %}{{ go_export(f.name) }}: {{ literal(f) }}{% if not loop.last %}, {% endif %}{% endfor %}}
    {%- else %}{{ arg.value | tojson }}{% endif -%}
{%- endmacro %}

{#- The Go type of a literal, or of the `item` of a list literal. -#}
{% macro type_of(arg) -%}
    {%- if arg.kind == "list" %}[]{{ type_of(arg.item) }}
    {%- elif arg.kind in ["object", "enum"] %}{{ sdk.package_name }}.{{ go_ident(arg.schema) }}
    {%- elif arg.kind == "uuid" %}uuid.UUID
    {%- elif arg.kind == "date" %}{{ sdk.package_name }}.Date
    {%- else %}{{ {"Int16": "int16", "UInt16": "uint16", "Int32": "int32", "Int64": "int64", "UInt64": "uint64", "Float": "float32", "Double": "float64", "Bool": "bool"}[arg.type] or "string" }}{% endif -%}
{%- endmacro %}

{#- The kinds of the literals `args` and of those they nest, space-separated. -#}
{% macro kinds(args) -%}
    {%- for a in args %} {{ a.kind }}{% if a.kind == "object" %}{{ kinds(a.fields) }}{% elif a.kind == "list" %}{{ kinds(a["items"]) }}{% endif %}{% endfor -%}
{%- endmacro %}

{#- The imports the literals of the examples `exs` need, each on its line. -#}
{% macro imports(exs) -%}
    {%- set ns = namespace(uuid=false) -%}
    {%- for ex in exs if ex and "uuid" in (kinds(ex.path_args + (ex.body.fields if ex.body and ex.body.fields else [])) | split | list) %}{% set ns.uuid = true %}{% endfor -%}
    {%- if ns.uuid %}import "github.com/google/uuid"
{% endif -%}
{%- endmacro %}

{#- Whether `op` takes an options struct, of its optional query and header parameters. -#}
{% macro has_options(op) -%}
    {%- if (op.query_params | rejectattr("required") | list) or (op.header_params | rejectattr("required") | list) %}yes{% endif -%}
{%- endmacro %}

{#- The call of an example, `suffix` ("AutoPaging") naming a twin, `opts` its request options. -#}
{% macro call(ex, opts="", suffix="") -%}
    {%- set out = namespace(args=["ctx"]) -%}
    {%- for a in ex.path_args %}{% set out.args = out.args + [literal(a)] %}{% endfor -%}
    {%- if ex.body %}{% set out.args = out.args + [literal({"kind": "object", "schema": ex.body.schema, "fields": ex.body.fields})] %}{% endif -%}
    {%- if has_options(ex.operation) %}{% set out.args = out.args + ["nil"] %}{% endif -%}
    {%- if opts %}{% set out.args = out.args + [opts] %}{% endif -%}
    {{ resource(ex.resource) }}.{{ method(ex.operation) }}{{ suffix }}({{ out.args | join(", ") }})
{%- endmacro %}
