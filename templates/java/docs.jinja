{#- The API as Java names it, for api.md and the README's examples. An example is a
    `{resource, operation, path_args, body, result, item}` the README receives. -#}
{% import "types/macros.java.jinja" as m %}

{#- The heading of a resource in api.md, and links to every resource's. -#}
{% macro title(name) %}{{ name | to_snake_case | replace("_", " ") | capitalize }}{% endmacro %}

{% macro contents(resources) -%}
    {%- for r in resources %}[{{ title(r.name) }}](#{{ r.name | to_kebab_case }}){% if not loop.last %} · {% endif %}{% endfor -%}
{%- endmacro %}

{#- The heading of a resource in api.md, one level deeper for each resource holding it. -#}
{% macro heading(resource) %}{{ "######"[:resource.path | length + 1] }} {{ title(resource.name) }}{% endmacro %}

{#- The accessors from `root` to the resource at `path`: `client.workspaces().peers()`. -#}
{% macro accessors(path, root="client") %}{{ root }}{% for a in path %}.{{ m.accessor(a) }}(){% endfor %}{% endmacro %}

{% macro resource(path) %}{{ accessors(path) }}{% endmacro %}

{% macro method(op) %}{{ op.name | ident("camel", "java") }}{% endmacro %}

{% macro package_path() %}src/main/java/{{ sdk.java_package | replace(".", "/") }}{% endmacro %}

{% macro model_path(name) %}{{ package_path() }}/models/{{ name | to_upper_camel_case }}.java{% endmacro %}

{% macro resource_path(name) %}{{ package_path() }}/api/{{ name | to_upper_camel_case }}.java{% endmacro %}

{#- A variable holding a value of schema `name`, `fallback` without one. -#}
{% macro var(name, fallback) -%}
    {%- set id = name | ident("camel", "java") if name else fallback -%}
    {{ fallback if id in ["client", "page", "stream", "response", "error", "e"] or id is endingwith("_") else id }}
{%- endmacro %}

{% macro literal(arg) -%}
    {%- if arg.unsigned64 -%}java.math.BigInteger.valueOf({{ arg.value | tojson }}L)
    {%- elif arg.type == "Int16" -%}(short) {{ arg.value | tojson }}
    {%- elif arg.kind == "uuid" -%}java.util.UUID.fromString({{ arg.value | tojson }})
    {%- elif arg.kind == "date" -%}java.time.LocalDate.parse({{ arg.value | tojson }})
    {%- elif arg.kind == "enum" -%}{{ sdk.java_package }}.models.{{ arg.schema | to_upper_camel_case }}.of({{ arg.value | tojson }})
    {%- elif arg.kind == "list" -%}java.util.List.of({% for item in arg["items"] %}{{ literal(item) }}{% if not loop.last %}, {% endif %}{% endfor %})
    {%- elif arg.kind == "object" -%}
        {%- set names = m.member_names(arg.fields, "schema `" ~ arg.schema ~ "`") | split(" ") | reject("equalto", "") | list -%}
        {{ arg.schema | to_upper_camel_case }}.builder(){% for f in arg.fields %}.{{ names[loop.index0] }}({{ literal(f) }}){% endfor %}.build()
    {%- else -%}{{ arg.value | tojson }}{% if arg.type in ["Int64", "UInt16"] %}L{% elif arg.type == "Float" %}f{% endif %}{% endif %}
{%- endmacro %}

{#- The schemas of the structs among the literals `args` and those they nest, space-separated. -#}
{% macro structs(args) %}{% for a in args %}{% if a.kind == "object" %} {{ a.schema | to_upper_camel_case }}{{ structs(a.fields) }}{% elif a.kind == "list" %}{{ structs(a["items"]) }}{% endif %}{% endfor %}{% endmacro %}

{#- The `import`s of the models an example's body needs, each with its line break. -#}
{% macro uses(ex) %}{% if ex.body %}{% for name in ([ex.body.schema | to_upper_camel_case] + (structs(ex.body.fields) | split | list)) | unique | sort %}import {{ sdk.java_package }}.models.{{ name }};
{% endfor %}{% endif %}{% endmacro %}

{#- The call of an example: through `withRawResponse()` with `raw`, and with `request_options` as
    its last argument when given. -#}
{% macro call(ex, raw=false, request_options="") -%}
    {%- set out = namespace(args=[]) -%}
    {%- for a in ex.path_args %}{% set out.args = out.args + [literal(a)] %}{% endfor -%}
    {%- if ex.body %}{% set out.args = out.args + [literal({"kind": "object", "schema": ex.body.schema, "fields": ex.body.fields})] %}{% endif -%}
    {%- if request_options %}{% set out.args = out.args + [request_options] %}{% endif -%}
    {{ accessors(ex.resource_path, "client.withRawResponse()" if raw else "client") }}.{{ method(ex.operation) }}({{ out.args | join(", ") }})
{%- endmacro %}
