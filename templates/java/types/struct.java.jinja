{% set extra_union = m.union_name(extra_field, class_ty, "AdditionalProperties") if has_extra else "" -%}
{% set extra_value = m.java_type(type.additional_properties.value_type(), extra_union) if has_extra else "" -%}
{% set extra_type = m.java_type(type.additional_properties, extra_union) if has_extra else "" -%}
{% set all_vars = vars + ["additionalProperties"] if has_extra else vars -%}
{% set defaults = type.discriminator_defaults | default({}) -%}
