{% set vars = m.field_idents(type.fields, "camel", owner) | split(" ") | reject("equalto", "") | list -%}
{% set pascals = m.field_idents(type.fields, "pascal", owner) | split(" ") | reject("equalto", "") | list -%}
{% set ns = namespace(unions=[]) -%}
{% for field in type.fields -%}
{% set ns.unions = ns.unions + [m.union_name(field, class_ty, pascals[loop.index0])] -%}
