{%- if p.typed_union is defined and not p.required -%}
{%- set ns = namespace(plain=true) -%}
{%- for v in p.typed_union.union_variants() -%}
{%- set item = v.type.inner_type() if v.type.is_list() else v.type -%}
{%- set item = item.inner_type() if item.is_nullable() else item -%}
{%- if (item.is_schema_ref() and v.type.is_list()) or item.is_union() or item.is_json_object() or item.is_list() -%}
{%- set ns.plain = false -%}
{%- endif -%}
{%- endfor -%}
{{ "true" if ns.plain }}
{%- endif -%}
{%- endmacro %}

{#- Whether `ty` holds a typed union, rendered as a class. -#}
