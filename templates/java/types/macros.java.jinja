{#- Identifiers of `fields`, `case` for `owner`; flattened parts are named after their type. -#}
{% macro field_idents(fields, case, owner) -%}
{%- set ns = namespace(names=[]) -%}
{%- for field in fields -%}
{%- set ns.names = ns.names + [field.type.to_java() if field.flatten else field.name] -%}
{%- endfor -%}
{{ ns.names | idents(case, "java", owner) | join(" ") }}
{%- endmacro %}

{#- A nullable field that is not required is kept as an Optional: unset is omitted, empty is
    sent as null. -#}
{% macro is_optional(field) -%}
{{ "true" if field.nullable and not field.required and not field.flatten }}
{%- endmacro %}

{#- Java type of `ty`, its unions rendered as the `union_cls` class. -#}
{% macro java_type(ty, union_cls="") -%}
{%- if ty.is_union() and union_cls -%}{{ union_cls }}
{%- elif ty.is_list() -%}List<{{ java_type(ty.inner_type(), union_cls) }}>
{%- elif ty.is_set() -%}Set<{{ java_type(ty.inner_type(), union_cls) }}>
{%- elif ty.is_map() -%}Map<String,{{ java_type(ty.value_type(), union_cls) }}>
{%- else -%}{{ ty.to_java() }}
{%- endif -%}
{%- endmacro %}

{#- Whether `ty` holds a typed union, which edition 2 renders as a class. -#}
{% macro has_union(ty) -%}
{%- if sdk.edition >= 2 -%}
{%- if ty.is_union() -%}true
{%- elif ty.is_list() or ty.is_set() -%}{{ has_union(ty.inner_type()) }}
{%- elif ty.is_map() -%}{{ has_union(ty.value_type()) }}
{%- endif -%}
{%- endif -%}
{%- endmacro %}

{#- Name of the class of the union in `field` of `owner`, empty without one. -#}
{% macro union_name(field, owner, pascal) -%}
{%- if has_union(field.type) and not field.flatten -%}
{%- set name = owner ~ (pascal | replace("_", "")) -%}
{{ name ~ "Value" if name in type_names else name }}
{%- endif -%}
{%- endmacro %}

{#- Markdown `text` as Javadoc HTML: escaped, with its code spans in `<code>`. -#}
{% macro html(text) -%}
{%- set text = text | replace("&", "&amp;") | replace("<", "&lt;") | replace(">", "&gt;") | replace("@", "&#64;") -%}
{%- set parts = text | split("`") | list -%}
{%- if "```" in text or parts | length is even -%}{{ text }}
{%- else -%}{% for part in parts %}{% if loop.index0 is odd %}<code>{{ part }}</code>{% else %}{{ part }}{% endif %}{% endfor -%}
{%- endif -%}
{%- endmacro %}

{#- Markdown `text` as a Javadoc comment. -#}
{% macro javadoc(text) -%}
{{ html(text) | to_doc_comment(style="java") }}
{%- endmacro %}

{#- Declaration of `field`, named `var`, initialized to its discriminator value if any. -#}
{% macro declaration(field, var, union_cls="", default=none) -%}
{% set ty = java_type(field.type, union_cls) -%}
{% if field.flatten -%}
@JsonUnwrapped
private {{ ty }} {{ var }};
{% else -%}
{% if default is not none -%}
{% set value = default | tojson if ty == "String" else ty ~ (".of(" if sdk.edition >= 2 else ".fromValue(") ~ (default | tojson) ~ ")" -%}
{% set init = " = " ~ ("Optional.of(" ~ value ~ ")" if is_optional(field) else value) -%}
{% endif -%}
@JsonProperty({{ field.name | tojson }})
{% if field.required and field.nullable %}@JsonInclude(JsonInclude.Include.ALWAYS){% endif %}
private {% if is_optional(field) %}Optional<{{ ty }}>{% else %}{{ ty }}{% endif %} {{ var }}{{ init | default("") }};
{% endif -%}
{%- endmacro %}

{#- Fluent setter, getter, bean setter and collection helpers of `field` in `cls`. -#}
{% macro accessors(field, var, pascal, cls, union_cls="") -%}
{% set m = {
    "var": var,
    "accessor": pascal ~ "_" if pascal == "Class" else pascal,
    "type": java_type(field.type, union_cls),
    "optional": is_optional(field) == "true",
} -%}
{% set deprecated = "@Deprecated " if field.deprecated else "" -%}
{% set wrap = "Optional.ofNullable(" ~ m.var ~ ")" if m.optional else m.var -%}
{% if field.description is defined -%}
{{ javadoc(field.description) }}
{% endif -%}
{{ deprecated }}public {{ cls }} {{ m.var }}({{ m.type }} {{ m.var }}) {
    this.{{ m.var }} = {{ wrap }};
    return this;
}

{% if field.type.is_list() or field.type.is_set() or field.type.is_map() -%}
{% set is_map = field.type.is_map() -%}
{% set item_ty = java_type(field.type.value_type() if is_map else field.type.inner_type(), union_cls) -%}
{% set empty = "new HashMap<>()" if is_map else ("new LinkedHashSet<>()" if field.type.is_set() else "new ArrayList<>()") -%}
{% set current = "this." ~ m.var ~ (".get()" if m.optional else "") -%}
{{ deprecated }}public {{ cls }} {{ "put" if is_map else "add" }}{{ pascal }}Item({% if is_map %}String key, {% endif %}{{ item_ty }} item) {
    if (this.{{ m.var }} == null{% if m.optional %} || this.{{ m.var }}.isEmpty(){% endif %}) {
        this.{{ m.var }} = {% if m.optional %}Optional.of({{ empty }}){% else %}{{ empty }}{% endif %};
    }
    {{ current }}.{{ "put(key, item)" if is_map else "add(item)" }};
    return this;
}

{% endif -%}
{% if field.required and not field.nullable -%}
@javax.annotation.Nonnull
{% else -%}
@javax.annotation.Nullable
{% endif -%}
{{ deprecated }}public {{ m.type }} get{{ m.accessor }}() {
    {% if m.optional -%}
    return {{ m.var }} == null ? null : {{ m.var }}.orElse(null);
    {% else -%}
    return {{ m.var }};
    {% endif -%}
}

{{ deprecated }}public void set{{ m.accessor }}({{ m.type }} {{ m.var }}) {
    this.{{ m.var }} = {{ wrap }};
}
{%- endmacro %}

{#- equals, hashCode and toString over `vars`, for `cls`; `base` compares the superclass too. -#}
{% macro value_methods(cls, vars, base=false) -%}
@Override
public boolean equals(Object o) {
    if (this == o) {
        return true;
    }
    if (o == null || getClass() != o.getClass(){% if base %} || !super.equals(o){% endif %}) {
        return false;
    }
    {% if vars | length > 0 -%}
    {{ cls }} that = ({{ cls }}) o;
    return {% for v in vars %}Objects.equals({{ v }}, that.{{ v }}){% if not loop.last %} && {% endif %}{% endfor %};
    {% else -%}
    return true;
    {% endif -%}
}

@Override
public int hashCode() {
    return Objects.hash({% if base %}super.hashCode(){% if vars %}, {% endif %}{% endif %}{{ vars | join(", ") }});
}

@Override
public String toString() {
    return "{{ cls }}{"
        {% if base %}+ super.toString(){% if vars %} + ", "{% endif %}{% endif %}
        {% for v in vars -%}
        + "{% if not loop.first %}, {% endif %}{{ v }}=" + {{ v }}
        {% endfor -%}
        + "}";
}
{%- endmacro %}

{#- Model names that would shadow a type the generated code uses. -#}
{% macro check_name(name) -%}
{% if name in ["Object", "String", "Boolean", "Short", "Integer", "Long", "Float", "Double", "Void",
    "Override", "Deprecated", "List", "Map", "Set", "Optional", "Objects", "ArrayList", "HashMap",
    "LinkedHashSet", "LinkedHashMap", "BigDecimal", "OffsetDateTime", "URI", "Utils"] -%}
{{ panic("java codegen: schema `" ~ name ~ "` would shadow java's own `" ~ name ~ "`, rename it in the spec") }}
{%- endif %}
{%- endmacro %}

{#- The `cls` class of the union in `ty`: one subclass per variant, told apart by JSON type. -#}
{% macro union_class(ty, cls, shadowed=[]) -%}
{% if ty.is_list() or ty.is_set() -%}
{{ union_class(ty.inner_type(), cls, shadowed) }}
{%- elif ty.is_map() -%}
{{ union_class(ty.value_type(), cls, shadowed) }}
{%- else -%}
{% set variants = ty.union_variants() -%}
{% set objects = ty.union_mode() != "json" -%}
{% set full = variants | map(attribute="name") | list | idents("pascal", "java", "union `" ~ cls ~ "`") -%}
{#- A variant named after its union drops that prefix (`OfObject`), keeping nested class files
    under the 255-byte file name limit. -#}
{% set short = namespace(list=[]) -%}
{% for p in full -%}
{% set rest = p[cls | length:] if p is startingwith(cls) and p | length > cls | length else p -%}
{% set short.list = short.list + [rest] -%}
{% endfor -%}
{% set pascals = short.list if short.list | unique | list | length == full | length else full -%}
{% set pascal_of = namespace(list=[]) -%}
{% for v in variants -%}
{% set pascal_of.list = pascal_of.list + [{"name": v.name, "pascal": pascals[loop.index0]}] -%}
{% endfor -%}
{% set ns = namespace(types=[]) -%}
{% for v in variants -%}
{% set t = v.type.to_java() -%}
{% set ns.types = ns.types + [sdk.java_package ~ ".models." ~ t if t in shadowed + ["Empty", "Deserializer"] else t] -%}
{% endfor -%}
{% set checks = {
    "string": "node.isTextual()",
    "integer": "node.isIntegralNumber()",
    "number": "node.isNumber()",
    "boolean": "node.isBoolean()",
    "array": "node.isArray()",
    "object": "node.isObject()",
} -%}
/**
 * One of {% for v in variants %}{% if not loop.first %}{{ ", " if not loop.last else " or " }}{% endif %}{% if v.empty %}{@code ""}{% elif v.type.is_schema_ref() %}{@link {{ ns.types[loop.index0] }}}{% else %}a JSON {{ v.json_type }}{% endif %}{% endfor %}, told apart
 * by JSON type: {@code of...} builds one, {@code is...} and {@code as...} read it.
{%- if objects %}
 *
{%- if ty.union_mode() == "rules" %}
 * <p>An object is the first variant whose conditions it meets:
 * <ul>
{%- for v in ty.object_variants() %}
 *   <li>{@link Of{{ (pascal_of.list | selectattr("name", "equalto", v.name) | first).pascal }}}: {% for c in v.when %}{% if not loop.first %} and {% endif %}{@code {{ c.property }}} {% if c.value is defined %}is {@code {{ c.value | tojson | replace("@", "&#64;") }}}{% else %}is present{% endif %}{% else %}any object{% endfor %}
{%- endfor %}
 * </ul>
{%- else %}
 * <p>An object is the variant whose required properties are all present and which has the
 * most of its properties, the first one on ties.
{%- endif %}
 * An object no variant decodes is {@link Unrecognized}, kept as received; {@link #decodeAs}
 * reads the value as another variant.
{%- endif %}
 */
@JsonDeserialize(using = {{ cls }}.Deserializer.class)
public abstract static class {{ cls }} {
    private {{ cls }}() {}

    /** The value, as sent. */
    @JsonValue
    public abstract Object getValue();
    {% for v in variants -%}
    {% set p = pascals[loop.index0] -%}
    {% set t = ns.types[loop.index0] -%}
    {% if v.empty %}

    /** The empty string, which clears the value. */
    public static {{ cls }} empty() {
        return Empty.INSTANCE;
    }

    public boolean isEmpty() {
        return this instanceof Empty;
    }
    {% else %}

    public static {{ cls }} of{{ p }}({{ t }} value) {
        return new Of{{ p }}(Objects.requireNonNull(value, "value"));
    }

    public boolean is{{ p }}() {
        return this instanceof Of{{ p }};
    }

    /** @throws IllegalStateException if this is another variant */
    public {{ t }} as{{ p }}() {
        if (this instanceof Of{{ p }}) {
            return ((Of{{ p }}) this).value;
        }
        throw new IllegalStateException("not the {{ v.name }} variant: " + this);
    }
    {% endif -%}
    {% endfor %}
    {% set strings = variants | selectattr("name", "equalto", "string") | list -%}
    {% set expanded = variants | selectattr("id") | list -%}
    {% if strings and expanded %}

    /** The id: the string, or the {@code id} of the expanded object; null for other values. */
    public String id() {
        {% for v in variants -%}
        {% if v.name == "string" or v.id -%}
        if (this instanceof Of{{ pascals[loop.index0] }}) {
            return ((Of{{ pascals[loop.index0] }}) this).value{% if v.id %}.getId(){% endif %};
        }
        {% endif -%}
        {% endfor -%}
        return null;
    }
    {% endif %}
    {% if objects %}

    /** Whether no variant matched the value, kept as received. */
    public boolean isUnrecognized() {
        return this instanceof Unrecognized;
    }

    /** The value read as {@code type}, such as another variant than the one decoding picked. */
    public <T> T decodeAs(Class<T> type) {
        return {{ sdk.java_internal_package }}.Unions.convert(this, type);
    }

    /** A value no variant matches, kept as received. */
    public static final class Unrecognized extends {{ cls }} {
        private final JsonNode value;

        private Unrecognized(JsonNode value) {
            this.value = value;
        }

        @Override
        @JsonValue
        public JsonNode getValue() {
            return value;
        }

        @Override
        public boolean equals(Object o) {
            return o instanceof Unrecognized && value.equals(((Unrecognized) o).value);
        }

        @Override
        public int hashCode() {
            return value.hashCode();
        }

        @Override
        public String toString() {
            return "{{ cls }}.Unrecognized{" + value + "}";
        }
    }
    {% endif %}
    {% for v in variants -%}
    {% set p = pascals[loop.index0] -%}
    {% set t = ns.types[loop.index0] -%}
    {% if v.empty %}

    public static final class Empty extends {{ cls }} {
        private static final Empty INSTANCE = new Empty();

        private Empty() {}

        @Override
        @JsonValue
        public String getValue() {
            return "";
        }

        @Override
        public boolean equals(Object o) {
            return o instanceof Empty;
        }

        @Override
        public int hashCode() {
            return 0;
        }

        @Override
        public String toString() {
            return "{{ cls }}.Empty";
        }
    }
    {% else %}

    public static final class Of{{ p }} extends {{ cls }} {
        private final {{ t }} value;

        private Of{{ p }}({{ t }} value) {
            this.value = value;
        }

        @Override
        @JsonValue
        public {{ t }} getValue() {
            return value;
        }

        @Override
        public boolean equals(Object o) {
            return o instanceof Of{{ p }} && value.equals(((Of{{ p }}) o).value);
        }

        @Override
        public int hashCode() {
            return value.hashCode();
        }

        @Override
        public String toString() {
            return "{{ cls }}.Of{{ p }}{" + value + "}";
        }
    }
    {% endif -%}
    {% endfor %}

    static final class Deserializer extends Utils.UnionDeserializer<{{ cls }}> {
        private static final long serialVersionUID = 1L;

        Deserializer() {
            super({{ cls }}.class);
        }

        @Override
        protected {{ cls }} decode(JsonNode node, DeserializationContext ctxt) throws IOException {
            {% if objects -%}
            if (node.isObject()) {
                {% set candidates = ty.object_variants() -%}
                {% if ty.union_mode() == "rules" -%}
                {% for v in candidates -%}
                if ({% for c in v.when %}{{ sdk.java_internal_package }}.Unions.has(node, {{ c.property | tojson }}, {{ (c.value | tojson | tojson) if c.value is defined else "null" }}){% if not loop.last %} && {% endif %}{% else %}true{% endfor %}) {
                    return objectVariant(node, ctxt, {{ v.name | tojson }});
                }
                {% endfor -%}
                return new Unrecognized(node);
                {% else -%}
                switch ({{ sdk.java_internal_package }}.Unions.bestMatch(node{% for v in candidates %},
                        new String[][] { { {% for p in v.required %}{{ p | tojson }}{% if not loop.last %}, {% endif %}{% endfor %} }, { {% for p in v.properties %}{{ p | tojson }}{% if not loop.last %}, {% endif %}{% endfor %} } }{% endfor %})) {
                    {% for v in candidates -%}
                    case {{ loop.index0 }}:
                        return objectVariant(node, ctxt, {{ v.name | tojson }});
                    {% endfor -%}
                    default:
                        return new Unrecognized(node);
                }
                {% endif -%}
            }
            {% endif -%}
            {% for v in variants -%}
            {% set p = pascals[loop.index0] -%}
            {% if objects and v.json_type == "object" -%}
            {% elif v.empty -%}
            if (node.isTextual() && node.textValue().isEmpty()) {
                return Empty.INSTANCE;
            }
            {% else -%}
            {% set json_type = v.json_type or "object" -%}
            if ({{ checks[json_type] }}) {
                return new Of{{ p }}(read(node, ctxt, new TypeReference<{{ ns.types[loop.index0] }}>() {}));
            }
            {% endif -%}
            {% endfor -%}
            return {{ "new Unrecognized(node)" if objects else "null" }};
        }
        {% if objects %}

        private static {{ cls }} objectVariant(JsonNode node, DeserializationContext ctxt, String variant) {
            try {
                switch (variant) {
                    {% for v in variants -%}
                    {% if v.json_type == "object" -%}
                    case {{ v.name | tojson }}:
                        return new Of{{ pascals[loop.index0] }}(read(node, ctxt, new TypeReference<{{ ns.types[loop.index0] }}>() {}));
                    {% endif -%}
                    {% endfor -%}
                    default:
                        return new Unrecognized(node);
                }
            } catch (IOException e) {
                return new Unrecognized(node);
            }
        }
        {% endif %}
    }
}
{% endif -%}
{%- endmacro %}

{#- fromJson and toJson of `cls`, unchecked from edition 2. -#}
{% macro json_methods(cls) -%}
{% if sdk.edition >= 2 -%}
/**
 * Parse {@code json} as {@code {{ cls }}}.
 *
 * @throws java.io.UncheckedIOException if it is not valid JSON of this shape
 */
public static {{ cls }} fromJson(String json) {
    return Utils.parse(json, {{ cls }}.class);
}

/** This {{ cls }} as JSON. */
public String toJson() {
    return Utils.json(this);
}
{%- else -%}
/**
 * Parse {@code json} as {@code {{ cls }}}.
 *
 * @throws JsonProcessingException if it is not valid JSON of this shape
 */
public static {{ cls }} fromJson(String json) throws JsonProcessingException {
    return Utils.fromJson(json, {{ cls }}.class);
}

/** This {{ cls }} as JSON. */
public String toJson() throws JsonProcessingException {
    return Utils.toJson(this);
}
{%- endif %}
{%- endmacro %}
