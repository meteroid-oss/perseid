        {% set fvars = m.field_idents(variant.fields, "camel", variant_owner) | split(" ") | reject("equalto", "") | list -%}
        {% set fpascals = m.field_idents(variant.fields, "pascal", variant_owner) | split(" ") | reject("equalto", "") | list -%}
        {% set holder = "Content" if content else cls -%}
        {% if content -%}
