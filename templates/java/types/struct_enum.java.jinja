{% import "types/macros.java.jinja" as m -%}
{% set type_name = type.name | to_upper_camel_case -%}
{{- m.check_name(type_name) -}}
{% set owner = "schema `" ~ type.name ~ "`" -%}
{% set disc = type.discriminator_field -%}
{% set disc_getter = "get" ~ (disc | ident("pascal", "java")) -%}
{% set ns = namespace(names=[]) -%}
{% for variant in type.variants %}{% set ns.names = ns.names + [variant.name] %}{% endfor -%}
{% set ns.classes = [] -%}
{#- A nested class shadows the types of the same name that the union itself uses. -#}
{% for cls in (ns.names + ["unrecognized"]) | idents("pascal", "java", owner) -%}
{% set shadowed = cls in ["String", "Object", "Override", "Deprecated", "Utils", "Objects", "List",
    "Map", "Set", "Optional", "ArrayList", "HashMap", "LinkedHashMap", "LinkedHashSet", "BigDecimal",
    "OffsetDateTime", "URI", "Visibility", "JsonAnyGetter", "JsonAnySetter", "JsonAutoDetect",
    "JsonIgnoreProperties", "JsonInclude", "JsonProperty", "JsonSubTypes", "JsonTypeInfo",
    "JsonTypeName", "JsonUnwrapped", "JsonProcessingException"] -%}
{% set ns.classes = ns.classes + [cls ~ "Variant" if shadowed else cls] -%}
{% endfor -%}
{% set classes = ns.classes -%}
{% set vars = m.field_idents(type.fields, "camel", owner) | split(" ") | reject("equalto", "") | list -%}
{% set pascals = m.field_idents(type.fields, "pascal", owner) | split(" ") | reject("equalto", "") | list -%}
{% set adjacent = type.repr == "adjacently_tagged" -%}
{% set shared = type.fields | length > 0 -%}
