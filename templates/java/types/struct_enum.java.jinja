)
@JsonSubTypes({
    {% for variant in type.variants -%}
    @JsonSubTypes.Type(value = {{ type_name }}.{{ classes[loop.index0] }}.class, name = {{ variant.name | tojson }}){% if not loop.last %},{% endif %}

    {% endfor -%}
})
@JsonInclude(JsonInclude.Include.NON_NULL)
