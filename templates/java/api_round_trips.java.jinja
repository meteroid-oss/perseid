    private static boolean sameInstant(String expected, String actual) {
        try {
            return OffsetDateTime.parse(expected).isEqual(OffsetDateTime.parse(actual));
        } catch (DateTimeParseException e) {
            return false;
        }
    }

    private static boolean sameDecimal(String expected, String actual) {
        return DECIMAL.matcher(expected).matches()
                && DECIMAL.matcher(actual).matches()
                && new BigDecimal(expected).compareTo(new BigDecimal(actual)) == 0;
    }

    /** Where {@code actual} differs from {@code expected}, beyond the normalizations above. */
    private static List<String> differences(JsonNode expected, JsonNode actual, String path) {
        List<String> out = new ArrayList<>();
        String mismatch = path + ": " + expected + " became " + actual;
        if (expected.isNumber() && actual.isNumber()) {
            boolean same = expected.isIntegralNumber() && actual.isIntegralNumber()
                    ? expected.bigIntegerValue().equals(actual.bigIntegerValue())
                    : expected.decimalValue().compareTo(actual.decimalValue()) == 0;
            if (!same) {
                out.add(mismatch);
            }
        } else if (expected.isTextual() && actual.isTextual()) {
            String a = expected.textValue();
            String b = actual.textValue();
            if (!a.equals(b) && !sameInstant(a, b) && !sameDecimal(a, b)) {
                out.add(mismatch);
            }
        } else if (expected.isObject() && actual.isObject()) {
            Set<String> keys = new TreeSet<>();
            expected.fieldNames().forEachRemaining(keys::add);
            actual.fieldNames().forEachRemaining(keys::add);
            for (String key : keys) {
                if (!actual.has(key)) {
                    out.add(path + "/" + key + ": lost, was " + expected.get(key));
                } else if (!expected.has(key)) {
                    out.add(path + "/" + key + ": added, is " + actual.get(key));
                } else {
                    out.addAll(differences(expected.get(key), actual.get(key), path + "/" + key));
                }
            }
        } else if (expected.isArray() && actual.isArray()) {
            if (expected.size() != actual.size()) {
                out.add(path + ": " + expected.size() + " items became " + actual.size());
            } else {
                for (int i = 0; i < expected.size(); i++) {
                    out.addAll(differences(expected.get(i), actual.get(i), path + "/" + i));
                }
            }
        } else if (!expected.equals(actual)) {
            out.add(mismatch);
        }
        return out;
    }

    private static void roundTrip(String label, Class<?> type, JsonNode json) throws Exception {
        ObjectMapper mapper = Utils.getObjectMapper();
        String input = json.toString();
        Object decoded;
        try {
            decoded = mapper.readValue(input, type);
        } catch (Exception e) {
            throw new AssertionError(label + ": decode failed: " + e + "\n    input: " + input, e);
        }
        assertNotNull(decoded, label + ": decoded as null\n    input: " + input);
        String output = mapper.writeValueAsString(decoded);
        List<String> found = differences(json, EXACT.readTree(output), "");
        if (!found.isEmpty()) {
            throw new AssertionError(label + ": " + String.join("\n    ", found) + "\n    input: " + input + "\n    output: " + output);
        }
        Object again;
        try {
            again = mapper.readValue(output, type);
        } catch (Exception e) {
            throw new AssertionError(label + ": own output: " + e + "\n    input: " + input + "\n    output: " + output, e);
        }
        if (!decoded.equals(again)) {
            throw new AssertionError(label + ": not stable, re-encoded as " + mapper.writeValueAsString(again)
                    + "\n    input: " + input + "\n    output: " + output);
        }
    }

    @TestFactory
    Stream<DynamicTest> everySampleOfEveryModelRoundTrips() throws Exception {
        JsonNode data;
        try (InputStream in = RoundTripsTest.class.getResourceAsStream("round_trips.json")) {
            assertNotNull(in, "round_trips.json is not on the test classpath");
            data = EXACT.readTree(in).get("models");
        }
        List<DynamicTest> tests = new ArrayList<>();
        for (Map.Entry<String, Class<?>> model : MODELS.entrySet()) {
            String schema = model.getKey();
            JsonNode samples = data.get(schema);
            if (samples == null || samples.isEmpty()) {
                tests.add(dynamicTest(schema, () -> {
                    throw new AssertionError(schema + ": no samples");
                }));
                continue;
            }
            for (Iterator<JsonNode> it = samples.elements(); it.hasNext(); ) {
                JsonNode sample = it.next();
                String label = schema + " sample `" + sample.get("name").asText() + "`";
                tests.add(dynamicTest(label, () -> roundTrip(label, model.getValue(), sample.get("json"))));
            }
        }
        return tests.stream();
    }
}
