/**
 * Decodes sample JSON of every model and encodes it back, from round_trips.json.
 *
 * <p>Date-times compare as instants, decimal strings and numbers by value. Everything else must
 * come back exactly.
 */
class RoundTripsTest {
    private static final Pattern DECIMAL = Pattern.compile("-?\\d+(?:\\.\\d+)?");
    /** Reads JSON with exact numbers: no float rounds an integer or a decimal. */
    private static final ObjectMapper EXACT = new ObjectMapper().enable(DeserializationFeature.USE_BIG_DECIMAL_FOR_FLOATS);
    private static final Map<String, Class<?>> MODELS = new TreeMap<>();

