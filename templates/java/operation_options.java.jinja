{% import "types/macros.java.jinja" as m -%}
{% set resource_type_name = resource.name | to_upper_camel_case -%}
{% set class_name = resource_type_name ~ (operation.name | to_upper_camel_case) ~ "Options" -%}
{% set all_params = operation.query_params + operation.header_params -%}
{% set accessors = all_params | map(attribute="name") | list | idents("camel", "java", "operation `" ~ operation.id ~ "`") -%}
{% set pascals = all_params | map(attribute="name") | list | idents("pascal", "java", "operation `" ~ operation.id ~ "`") -%}
{% set ns = namespace(params=[], fields=[], pascals=[], types=[], unions=[]) -%}
{% for p in all_params -%}
{% if not p.required -%}
{% set name = accessors[loop.index0] -%}
{% set ns.params = ns.params + [p] -%}
{% set ns.fields = ns.fields + [name ~ "_" if name in ["builder", "toBuilder", "hashCode", "toString", "getClass", "build"] else name] -%}
{% set ns.pascals = ns.pascals + [pascals[loop.index0]] -%}
{% if m.typed_param_union(p) -%}
{% set union_cls = pascals[loop.index0] ~ ("Value" if pascals[loop.index0] in ["Builder", class_name] else "") -%}
{% set ns.types = ns.types + [union_cls] -%}
{% set ns.unions = ns.unions + [[p.typed_union, union_cls]] -%}
{% else -%}
{% set ns.types = ns.types + [p.type.to_java() if loop.index0 < operation.query_params | length else "String"] -%}
{% endif -%}
{% endif -%}
{% endfor -%}
