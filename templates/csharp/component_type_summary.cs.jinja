{% import "macros.cs.jinja" as m -%}
{% set _ = set_summary_filename(sdk.client_name ~ "JsonContext.cs") -%}
{% set all = namespace(resources=api.resources) -%}
{#- The unions of JSON bodies and events that name a schema alias, declared here with the models; the others are declared with their resource. -#}
{% set bodies = namespace(names=[], aliases=[]) -%}
{% for resource in all.resources -%}
{% for op in resource.operations -%}
{% for union, ty in [(op.request_body_union | default(""), op.request_body_json_type | default(none)), (op.response_body_union | default(""), op.response_body_json_type | default(none)), (m.event_union(op), op.event_json_type | default(none))] -%}
{% if union and ty is not none and union in api.types and (union | to_upper_camel_case) not in bodies.names -%}
{% set bodies.names = bodies.names + [union | to_upper_camel_case] -%}
{% set bodies.aliases = bodies.aliases + [{"name": union, "union_name": union | to_upper_camel_case, "type": ty, "required": true, "nullable": false}] -%}
{% endif -%}
{% endfor -%}
{% endfor -%}
{% endfor -%}
{#- The attributes and declaration of the context, rendered first: its usings depend on the types it registers. -#}
{% set generic = namespace(types=[]) -%}
{% set expandables = namespace(list=[]) -%}
{% set context_class -%}
[JsonSourceGenerationOptions(DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull)]
{#- Always registered: a context without any `JsonSerializable` gets no generated members and fails to compile. #}
[JsonSerializable(typeof(JsonNode))]
{% for _, type in api.types | items -%}
{% if type.kind not in ["string_alias", "alias"] -%}
{% set type_name = type.name | to_upper_camel_case -%}
[JsonSerializable(typeof({{ type_name }}))]
{% if type.kind == "struct_enum" -%}
{% for variant in type.variants -%}
{% if variant.type == "struct" and variant.fields | default([]) | length > 0 -%}
{% set class = variant.name | to_rust_variant -%}
{% if class == type_name %}{% set class = class ~ "Value" %}{% endif -%}
{% if class in [type.discriminator_field | to_rust_variant, "Unrecognized"] %}{% set class = class ~ "Variant" %}{% endif -%}
[JsonSerializable(typeof({{ type_name }}.{{ class }}Data), TypeInfoPropertyName = "{{ type_name }}{{ class }}Data")]
{% endif -%}
{% endfor -%}
{% endif -%}
{% endif -%}
{% endfor -%}
{#- `List<X>` and `X?` would take the context names of models named `ListX` and `NullableX`. -#}
{% set names = namespace(models=[], structs=[]) -%}
{% for _, type in api.types | items if type.kind not in ["string_alias", "alias"] -%}
{% set names.models = names.models + [type.name | to_upper_camel_case] -%}
{% if type.kind in ["string_enum", "integer_enum"] -%}
{% set names.structs = names.structs + [type.name | to_upper_camel_case] -%}
{% endif -%}
{% endfor -%}
{% for name in names.models -%}
{% if name is startingwith("List") and name[4:] in names.models -%}
{% set ty = "List<" ~ name[4:] ~ ">" -%}
{% set generic.types = generic.types + [ty] -%}
[JsonSerializable(typeof({{ ty }}), TypeInfoPropertyName = "{{ m.type_info(ty) }}")]
{% elif name is startingwith("Nullable") and name[8:] in names.structs -%}
[JsonSerializable(typeof({{ name[8:] }}?), TypeInfoPropertyName = "Json{{ name }}")]
{% endif -%}
{% endfor -%}
{% set taken = api.types | list | map("to_upper_camel_case") | list -%}
{% for _, type in api.types | items if type.kind in ["struct", "struct_enum"] -%}
{% set type_name = type.name | to_upper_camel_case -%}
{% set owners = namespace(list=[(type.fields, type_name)]) -%}
{% for variant in type.variants | default([]) if variant.type == "struct" -%}
{% set class = variant.name | to_rust_variant -%}
{% if class == type_name %}{% set class = class ~ "Value" %}{% endif -%}
{% if class in [type.discriminator_field | to_rust_variant, "Unrecognized"] %}{% set class = class ~ "Variant" %}{% endif -%}
{% set owners.list = owners.list + [(variant.fields | default([]), type_name ~ class)] -%}
{% endfor -%}
{% for fields, owner in owners.list -%}
{% for field in fields -%}
{% set union = m.union_class(field, owner, taken) -%}
{% if union -%}
[JsonSerializable(typeof({{ union }}))]
{% set t = namespace(ty=field.type) -%}
{% for _ in range(8) -%}
{% if t.ty.is_list() or t.ty.is_set() or t.ty.is_nullable() %}{% set t.ty = t.ty.inner_type() %}{% elif t.ty.is_map() %}{% set t.ty = t.ty.value_type() %}{% endif -%}
{% endfor -%}
{% set ids = namespace(cases=[], strings=0) -%}
{% for v in t.ty.union_variants() -%}
{% set class = m.union_variant_class(v, union) -%}
{#- Schema keys are usually the variant's snake_case name or its class name. -#}
{% set target = (api.types[v.name] or api.types[v.type.to_csharp()]) if v.type.is_schema_ref() else none -%}
{% set id_field = (target.fields | default([]) | selectattr("name", "equalto", "id") | first) if target and target.kind == "struct" else none -%}
{% if v.type.to_csharp() == "string" and not v.empty -%}
{% set ids.strings = ids.strings + 1 -%}
{% set ids.cases = ids.cases + [union ~ "." ~ class ~ " variant => variant.Value"] -%}
{% elif id_field and id_field.type.to_csharp() == "string" -%}
{% set ids.cases = ids.cases + [union ~ "." ~ class ~ " variant => variant.Value." ~ m.member("id", v.type.to_csharp())] -%}
{% endif -%}
{% endfor -%}
{% if ids.strings == 1 and ids.cases | length > 1 %}{% set expandables.list = expandables.list + [(union, ids.cases)] %}{% endif -%}
{% for v in t.ty.union_variants() if "<" in v.type.to_csharp() and v.type.to_csharp() not in generic.types -%}
{% set generic.types = generic.types + [v.type.to_csharp()] -%}
[JsonSerializable(typeof({{ v.type.to_csharp() }}), TypeInfoPropertyName = "{{ m.type_info(v.type.to_csharp()) }}")]
{% endfor -%}
{% endif -%}
{% endfor -%}
{% endfor -%}
{% endfor -%}
{% for _, type in api.types | items if type.kind == "struct" and type.additional_properties is defined and not type.additional_properties.value_type().is_json_object() -%}
{% set ty = type.additional_properties.value_type().to_csharp() -%}
{% if ("<" in ty or ty in ["string", "bool", "int", "long", "short", "ushort", "ulong", "float", "double", "decimal", "DateTimeOffset", "DateOnly", "Guid"]) and ty not in generic.types -%}
{% set generic.types = generic.types + [ty] -%}
[JsonSerializable(typeof({{ ty }}), TypeInfoPropertyName = "{{ m.type_info(ty) }}")]
{% endif -%}
{% endfor -%}
{% set registered = namespace(unions=[]) -%}
{% for resource in all.resources -%}
{% for op in resource.operations -%}
{% set op_types = namespace(list=[m.body_type(op, api.types), m.response_type(op, api.types)]) -%}
{% if op.event_json_type is defined %}{% set op_types.list = op_types.list + [m.event_type(op, api.types)] %}{% endif -%}
{% for field in op.multipart_fields if not field.is_file -%}
{% set op_types.list = op_types.list + [field.type.to_csharp()] -%}
{% endfor -%}
{% for p in op.query_params if p.structured -%}
{% set op_types.list = op_types.list + [p.type.to_csharp()] -%}
{% endfor -%}
{% for p in op.header_params if p.json -%}
{% set op_types.list = op_types.list + [p.type.to_csharp()] -%}
{% endfor -%}
{% for name, ps in op.path_styles | default({}) | items if ps.type is defined -%}
{% set op_types.list = op_types.list + [ps.type.to_csharp()] -%}
{% endfor -%}
{% for union, body in [(op.request_body_union | default(""), op.request_body_json_type | default(none)), (op.response_body_union | default(""), op.response_body_json_type | default(none)), (m.event_union(op), op.event_json_type | default(none))] -%}
{% if union and body is not none and (union | to_upper_camel_case) not in registered.unions -%}
{% set registered.unions = registered.unions + [union | to_upper_camel_case] -%}
{% if union in api.types -%}
[JsonSerializable(typeof({{ m.model(union) }}), TypeInfoPropertyName = "{{ union | to_upper_camel_case }}")]
{% else -%}
[JsonSerializable(typeof(global::{{ sdk.package_name }}.{{ union | to_upper_camel_case }}), TypeInfoPropertyName = "{{ union | to_upper_camel_case }}")]
{% endif -%}
{% set t = namespace(ty=body) -%}
{% for _ in range(8) -%}
{% if t.ty.is_list() or t.ty.is_set() or t.ty.is_nullable() %}{% set t.ty = t.ty.inner_type() %}{% elif t.ty.is_map() %}{% set t.ty = t.ty.value_type() %}{% endif -%}
{% endfor -%}
{% for v in t.ty.union_variants() if "<" in v.type.to_csharp() -%}
{% set op_types.list = op_types.list + [v.type.to_csharp()] -%}
{% endfor -%}
{% endif -%}
{% endfor -%}
{% for p in op.query_params if p.typed_union is defined -%}
{% set union = (resource.name | to_upper_camel_case) ~ (op.name | to_upper_camel_case) ~ "Options" ~ (p.ident | to_rust_variant) -%}
[JsonSerializable(typeof(global::{{ sdk.package_name }}.{{ union }}), TypeInfoPropertyName = "{{ union }}")]
{% for v in p.typed_union.union_variants() if "<" in v.type.to_csharp() -%}
{% set op_types.list = op_types.list + [v.type.to_csharp()] -%}
{% endfor -%}
{% endfor -%}
{% set scalars = ["string", "bool", "int", "long", "short", "ushort", "ulong", "float", "double", "decimal", "DateTimeOffset", "DateOnly", "Guid"] -%}
{% for ty in op_types.list if ("<" in ty or ty in scalars) and ty not in generic.types -%}
{% set generic.types = generic.types + [ty] -%}
[JsonSerializable(typeof({{ ty }}), TypeInfoPropertyName = "{{ m.type_info(ty) }}")]
{% endfor -%}
{% endfor -%}
{% endfor -%}
public sealed partial class {{ sdk.client_name }}JsonContext : JsonSerializerContext { }
{%- endset -%}
// this file is @generated
#pragma warning disable CS0612, CS0618 // generated code may use deprecated API
#pragma warning disable CA1707, CA1711, CA1716, CA1720 // identifiers follow the API's own names
{% if bodies.aliases or "DateTimeOffset" in context_class or "DateOnly" in context_class or "Guid" in context_class -%}
using System;
{% endif -%}
using System.Collections.Generic;
{% if bodies.aliases -%}
using System.Text.Json;
{% endif -%}
using System.Text.Json.Nodes;
using System.Text.Json.Serialization;

namespace {{ sdk.package_name }}.Models;

/// <summary>
/// Source-generated JSON metadata for every model: trimming and native AOT safe. Pass
/// <c>{{ sdk.client_name }}JsonContext.Default.Options</c> to <c>JsonSerializer</c> to (de)serialize models yourself.
/// </summary>
{{ context_class }}
{%- for union, cases in expandables.list %}

public abstract partial record {{ union }}
{
    /// <summary>The ID: the string, or the <c>id</c> of the expanded object.</summary>
    public string? Id =>
        this switch
        {
{%- for case in cases %}
            {{ case }},
{%- endfor %}
            _ => null,
        };
}
{%- endfor %}
{%- with fields = bodies.aliases, union_owner = "", type_names = {} %}{% include "types/unions.cs.jinja" %}{% endwith %}
