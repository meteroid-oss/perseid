{#- The API as C# names it, for api.md and the README's examples. An example is a
    `{resource, operation, path_args, body, result, item}` the README receives. -#}
{% import "macros.cs.jinja" as m %}

{#- The heading of a resource in api.md, and links to every resource's. -#}
{% macro title(name) %}{{ name | to_snake_case | replace("_", " ") | capitalize }}{% endmacro %}

{% macro contents(resources) -%}
    {%- for r in resources %}[{{ title(r.name) }}](#{{ r.name | to_kebab_case }}){% if not loop.last %} · {% endif %}{% endfor -%}
{%- endmacro %}

{% macro resource(name) %}client.{{ name | to_upper_camel_case }}{% endmacro %}

{% macro method(op) %}{{ op.name | to_upper_camel_case }}Async{% endmacro %}

{#- The page class of a paginated operation of the resource `resource`. -#}
{% macro page_class(resource, op) %}{{ resource | to_upper_camel_case }}{{ op.name | to_upper_camel_case }}Page{% endmacro %}

{#- A body property of the page of `ex`, as `page.Property`: the cursor, total or has-more, else
    the items, else `page.Body`. -#}
{% macro page_property(ex) -%}
    {%- set pg = ex.operation.pagination -%}
    {%- set owner = ex.operation.response_body_schema_name | to_upper_camel_case -%}
    {%- set out = namespace(name="") -%}
    {%- for path in [pg.next_cursor, pg.total, pg.total_pages, pg.has_more, pg.items] if path is defined and path is not none -%}
        {%- set name = m.member(path[0], owner) -%}
        {%- if not out.name and not m.shadowed(name, page_class(ex.resource, ex.operation)) %}{% set out.name = name %}{% endif -%}
    {%- endfor -%}
    page.{{ out.name or "Body" }}
{%- endmacro %}

{% macro model_name(name) %}{{ m.model(name) | replace("Models.", "") }}{% endmacro %}

{% macro model_path(name) %}{{ sdk.package_name }}/Models/{{ name | to_upper_camel_case }}.cs{% endmacro %}

{% macro resource_path(name) %}{{ sdk.package_name }}/Api/{{ m.resource_class(name) }}.cs{% endmacro %}

{#- A variable holding a value of schema `name`, `fallback` without one. -#}
{% macro var(name, fallback) -%}
    {%- set id = m.param(name) if name else fallback -%}
    {{ fallback if id in ["client", "page", "stream", "response", "e"] or id is startingwith("@") or id is endingwith("Param") else id }}
{%- endmacro %}

{% macro literal(arg) -%}
    {%- if arg.kind == "boolean" %}{{ "true" if arg.value else "false" }}
    {%- elif arg.kind == "uuid" %}Guid.Parse({{ arg.value | tojson }})
    {%- elif arg.kind == "date" %}{% set parts = arg.value | split("-") | list %}new DateOnly({{ parts[0] | int }}, {{ parts[1] | int }}, {{ parts[2] | int }})
    {%- elif arg.kind == "list" %}[{% for item in arg["items"] %}{{ literal(item) }}{% if not loop.last %}, {% endif %}{% endfor %}]
    {%- elif arg.kind == "object" %}{% set owner = arg.schema | to_upper_camel_case %}new {{ model_name(arg.schema) }}
        {%- if arg.fields %} { {% for f in arg.fields %}{{ m.member(f.name, owner) }} = {{ literal(f) }}{% if not loop.last %}, {% endif %}{% endfor %} }{% else %}(){% endif %}
    {%- else %}{{ arg.value | tojson }}{% if arg.type == "Float" %}f{% endif %}{% endif -%}
{%- endmacro %}

{#- The call of an example, through `WithRawResponse` with `raw`, with `request_options` as a named
    argument when given. -#}
{% macro call(ex, raw=false, request_options="") -%}
    {%- set out = namespace(args=[]) -%}
    {%- for a in ex.path_args %}{% set out.args = out.args + [literal(a)] %}{% endfor -%}
    {%- if ex.body %}{% set out.args = out.args + [literal({"kind": "object", "schema": ex.body.schema, "fields": ex.body.fields})] %}{% endif -%}
    {%- if request_options %}{% set out.args = out.args + ["requestOptions: " ~ request_options] %}{% endif -%}
    {{ resource(ex.resource) }}{{ ".WithRawResponse" if raw }}.{{ method(ex.operation) }}({{ out.args | join(", ") }})
{%- endmacro %}
