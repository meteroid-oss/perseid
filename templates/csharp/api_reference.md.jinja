{% macro params(resource, op) -%}
    {%- set prefix = (resource.name | to_upper_camel_case) ~ (op.name | to_upper_camel_case) -%}
    {%- set args = namespace(list=[]) -%}
    {%- for p in op.path_params %}{% set args.list = args.list + ["string " ~ m.param(p)] %}{% endfor -%}
    {%- set body_type = m.body_type(op) | replace("Models.", "") -%}
    {%- if op.request_body_kind == "binary" %}{% set body_type = "Upload" %}{% elif op.request_body_kind == "multipart" %}{% set body_type = prefix ~ "Body" %}{% endif -%}
    {%- if body_type -%}
        {%- set body = m.param(op.request_body_schema_name | default("body")) -%}
        {%- if body in ["options", "requestOptions", "cancellationToken", "request", "form"] or body in (op.path_params | map("to_lower_camel_case") | list) %}{% set body = "body" %}{% endif -%}
        {%- set args.list = args.list + [body_type ~ ("?" if op.request_body_optional) ~ " " ~ body] -%}
    {%- endif -%}
    {%- if op | has_query_or_header_params -%}
        {%- set args.list = args.list + [prefix ~ "Options" ~ ("" if op | has_required_query_or_header_params else "?") ~ " options"] -%}
    {%- endif -%}
    ({{ args.list | join(", ") }})
{%- endmacro -%}
{% macro returned(op) -%}
    {%- if op.response_is_event_stream %}EventStream{% if op.event_schema_name is defined %}<{{ docs.model_name(op.event_schema_name) }}>{% endif %}
    {%- elif op.response_is_binary %}byte[]
    {%- elif op.response_is_text %}string
    {%- else -%}
        {%- set body = m.response_type(op) | replace("Models.", "") -%}
        {{ body ~ ("?" if body and op.response_may_be_empty | default(false) and op.pagination is not defined) }}
    {%- endif -%}
{%- endmacro -%}
{% macro returns(op) -%}
    {%- if op.response_is_event_stream %}{% if op.event_schema_name is defined %}stream of {{ model(op.event_schema_name) }}{% else %}event stream{% endif %}
    {%- elif op.response_is_binary %}bytes
    {%- elif op.response_is_text %}text
    {%- elif op.response_body_schema_name is defined %}{{ model(op.response_body_schema_name) }}{% if op.response_body_is_list %} list{% endif %}
    {%- elif op.response_body_json_type is defined %}`{{ op.response_body_json_type.to_csharp() }}`
    {%- else %}nothing{% endif -%}
{%- endmacro -%}
