{#- The typed unions of `fields`, named after `union_owner`. #}
{%- set models = "global::" ~ sdk.package_name ~ ".Models." %}
{%- for field in fields %}
{%- set name = field.union_name if field.union_name is defined else m.union_class(field, union_owner, type_names) %}
{%- if name %}
{%- set t = namespace(ty=field.type) %}
{%- for _ in range(8) %}
{%- if t.ty.is_list() or t.ty.is_set() or t.ty.is_nullable() %}{% set t.ty = t.ty.inner_type() %}{% elif t.ty.is_map() %}{% set t.ty = t.ty.value_type() %}{% endif %}
{%- endfor %}
{%- set variants = namespace(list=[], seen=[]) %}
{%- set objects = t.ty.union_mode() != "json" %}
{%- for v in t.ty.union_variants() %}
{%- set class = m.union_variant_class(v, name) %}
{%- set leaf = namespace(ty=v.type) %}
{%- for _ in range(8) %}
{%- if leaf.ty.is_list() or leaf.ty.is_set() or leaf.ty.is_nullable() %}{% set leaf.ty = leaf.ty.inner_type() %}{% elif leaf.ty.is_map() %}{% set leaf.ty = leaf.ty.value_type() %}{% endif %}
{%- endfor %}
{%- set ty = v.type.to_csharp() %}
{%- if leaf.ty.is_schema_ref() and leaf.ty.to_csharp() not in ["string", "JsonNode"] %}
{%- set ty = ty | replace(leaf.ty.to_csharp(), models ~ leaf.ty.to_csharp()) %}
{%- endif %}
{%- set ty = ty | replace("List<", "global::System.Collections.Generic.List<") | replace("Dictionary<", "global::System.Collections.Generic.Dictionary<") %}
{#- Two variants of one C# type (`string` and an alias of it) cannot both be a variant: the first stays. -#}
{%- set key = "empty" if v.empty else ty %}
{%- if key not in variants.seen %}
{%- set variants.seen = variants.seen + [key] %}
{%- set kind = "empty" if v.empty
    else "string" if ty == "string"
    else "bool" if ty == "bool"
    else "date_time" if ty == "DateTimeOffset"
    else "date" if ty == "DateOnly"
    else "guid" if ty == "Guid"
    else "decimal" if ty == "decimal"
    else "number" if ty in ["short", "int", "long", "ushort", "ulong", "float", "double"]
    else "node" if ty == "JsonNode"
    else "json" %}
{%- set accessor = (v.name | to_rust_variant) if class == (v.name | to_rust_variant) ~ "Value" else class %}
{#- The shape `UnionRules.Is` checks: the JSON type, then `[]` for each level of arrays whose items are known. -#}
{%- set first_items = v.items if v.items is defined else none %}
{%- set sh = namespace(base=v.json_type, depth=0, it=first_items) %}
{%- for _ in range(6) %}
{%- if sh.it %}{% set sh.depth = sh.depth + 1 %}{% set sh.base = sh.it.json_type %}{% set sh.it = sh.it.items if sh.it.items is defined else none %}{% endif %}
{%- endfor %}
{%- set variants.list = variants.list + [{"class": class, "accessor": accessor, "type": ty, "kind": kind, "json_type": v.json_type, "shape": sh.base ~ ("[]" * sh.depth), "doc": v.type.to_csharp() if not v.empty else "\"\"", "name": v.name}] %}
{%- endif %}
{%- endfor %}

/// <summary>
/// The <c>{{ field.name | replace("&", "&amp;") | replace("<", "&lt;") }}</c> value, one of {% for v in variants.list %}<see cref="{{ v.class }}"/>{% if not loop.last %}, {% endif %}{% endfor %}.
/// </summary>
/// <remarks>
/// Match on the nested variant records, or assign a variant's value directly. <see cref="Unrecognized"/>
/// holds any other JSON value, as sent by a newer API version.
{%- if t.ty.union_decode() == "try" %}
/// Some variants share a JSON type: a value is read as the first variant it fits, the more specific ones first.
{%- endif %}
{%- if objects %}
{%- if t.ty.union_mode() == "rules" %}
/// An object is the first variant whose conditions it meets:
/// <list type="bullet">
{%- for o in t.ty.object_variants() %}
{%- set c = (variants.list | selectattr("name", "equalto", o.name) | first) %}
{%- if c %}
/// <item><see cref="{{ c.class }}"/>: {% for w in o.when %}{% if not loop.first %} and {% endif %}<c>{{ w.property }}</c> {% if w.value is defined %}is <c>{{ w.value | tojson | replace("&", "&amp;") | replace("<", "&lt;") }}</c>{% else %}is present{% endif %}{% else %}any object{% endfor %}</item>
{%- endif %}
{%- endfor %}
/// </list>
{%- else %}
/// An object is the variant whose required properties are all present and which has the most of its
/// properties, the first one on ties.
{%- endif %}
/// An object no variant decodes is <see cref="Unrecognized"/> too; <see cref="DecodeAs{T}"/> reads the value as
/// another variant.
{%- endif %}
/// </remarks>
[JsonConverter(typeof({{ name }}Converter))]
public abstract partial record {{ name }}
{
    private {{ name }}() { }
{%- for v in variants.list %}
{%- if v.kind == "empty" %}

    /// <summary>The empty string, which unsets the value.</summary>
    public sealed record {{ v.class }}() : {{ name }};

    /// <summary>Whether this is <see cref="{{ v.class }}"/>, the empty string.</summary>
    public bool IsEmpty => this is {{ v.class }};
{%- else %}

    /// <summary>A <c>{{ v.doc | replace("<", "&lt;") | replace(">", "&gt;") }}</c> value.</summary>
    /// <param name="Value">The value.</param>
{%- if "<" in v.type %}
    public sealed record {{ v.class }}({{ v.type }} Value) : {{ name }}
    {
        /// <inheritdoc/>
        {{ m.arrow("public bool Equals(" ~ v.class ~ "? other)", "other is not null && global::" ~ sdk.package_name ~ ".Equality.Equal(Value, other.Value)", 8) }}

        /// <inheritdoc/>
        public override int GetHashCode() => global::{{ sdk.package_name }}.Equality.Hash(Value);
    }
{%- else %}
    public sealed record {{ v.class }}({{ v.type }} Value) : {{ name }};
{%- endif %}

    /// <summary>Wraps <paramref name="value"/> in <see cref="{{ v.class }}"/>.</summary>
    /// <param name="value">The value.</param>
    {{ m.arrow("public static implicit operator " ~ name ~ "(" ~ v.type ~ " value)", "new " ~ v.class ~ "(value)", 4) }}

    /// <summary>The value if this is <see cref="{{ v.class }}"/>, else <c>null</c>.</summary>
    {{ m.arrow("public " ~ v.type ~ "? As" ~ v.accessor, "this is " ~ v.class ~ " variant ? variant.Value : default(" ~ v.type ~ "?)", 4) }}
{%- endif %}
{%- endfor %}

    /// <summary>A value of none of the known variants, kept as raw JSON.</summary>
    /// <param name="Raw">The JSON value.</param>
    public sealed record Unrecognized(JsonElement Raw) : {{ name }}
    {
        /// <inheritdoc/>
        {{ m.arrow("public bool Equals(Unrecognized? other)", "other is not null && global::" ~ sdk.package_name ~ ".Equality.Equal(Raw, other.Raw)", 8) }}

        /// <inheritdoc/>
        public override int GetHashCode() => global::{{ sdk.package_name }}.Equality.Hash(Raw);
    }
{%- if objects %}

    /// <summary>The value read as another type, such as another variant than the one decoding picked.</summary>
    public T DecodeAs<T>(global::System.Text.Json.Serialization.Metadata.JsonTypeInfo<T> typeInfo) =>
        JsonSerializer
            .SerializeToElement(
                this,
                (global::System.Text.Json.Serialization.Metadata.JsonTypeInfo<{{ name }}>)
                    typeInfo.Options.GetTypeInfo(typeof({{ name }}))
            )
            .Deserialize(typeInfo)!;
{%- endif %}
}

internal sealed class {{ name }}Converter : JsonConverter<{{ name }}>
{
    {{ m.wrap("public override " ~ name ~ " Read", ["ref Utf8JsonReader reader", "Type typeToConvert", "JsonSerializerOptions options"], 4) }}
    {
        using var document = JsonDocument.ParseValue(ref reader);
        var root = document.RootElement;
{%- if objects %}
{%- set candidates = namespace(list=[]) %}
{%- for o in t.ty.object_variants() %}
{%- set v = variants.list | selectattr("name", "equalto", o.name) | first %}
{%- if v %}{% set candidates.list = candidates.list + [{"v": v, "o": o}] %}{% endif %}
{%- endfor %}
{%- if candidates.list %}
        if (root.ValueKind == JsonValueKind.Object)
        {
{%- if t.ty.union_mode() == "rules" %}
{%- set open = namespace(done=false) %}
{%- for c in candidates.list %}
{%- if not open.done %}
{%- set v = c.v %}
{%- set o = c.o %}
{%- if v.kind == "node" %}
{%- set ret = "return new " ~ name ~ "." ~ v.class ~ "(JsonNode.Parse(root.GetRawText())!);" %}
{%- else %}
{%- set ret = "return new " ~ name ~ "." ~ v.class ~ "(object" ~ loop.index0 ~ ");" %}
{%- endif %}
{%- if o.when %}
{%- set conditions = namespace(list=[]) %}
{%- for w in o.when %}{% set conditions.list = conditions.list + ["global::" ~ sdk.package_name ~ ".UnionRules.Has(root, " ~ (w.property | tojson) ~ ", " ~ ((w.value | tojson | tojson) if w.value is defined else "null") ~ ")"] %}{% endfor %}
{%- if v.kind != "node" %}{% set conditions.list = conditions.list + ["Json.TryDeserialize<" ~ v.type ~ ">(root, options, out var object" ~ loop.index0 ~ ")"] %}{% endif %}
            if ({{ conditions.list | join(" && ") }})
            {
                {{ ret }}
            }
{%- elif v.kind == "node" %}
            {{ ret }}
{%- set open.done = true %}
{%- else %}
            if (Json.TryDeserialize<{{ v.type }}>(root, options, out var object{{ loop.index0 }}))
            {
                {{ ret }}
            }
{%- endif %}
{%- endif %}
{%- endfor %}
{%- else %}
            foreach (var index in global::{{ sdk.package_name }}.UnionRules.Rank(root{% for c in candidates.list %}, [[{% for p in c.o.required %}{{ p | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}], [{% for p in c.o.properties %}{{ p | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}]]{% endfor %}))
            {
                switch (index)
                {
{%- for c in candidates.list %}
                    case {{ loop.index0 }}:
{%- if c.v.kind == "node" %}
                        return new {{ name }}.{{ c.v.class }}(JsonNode.Parse(root.GetRawText())!);
{%- else %}
                        if (Json.TryDeserialize<{{ c.v.type }}>(root, options, out var object{{ loop.index0 }}))
                        {
                            return new {{ name }}.{{ c.v.class }}(object{{ loop.index0 }});
                        }
                        break;
{%- endif %}
{%- endfor %}
                }
            }
{%- endif %}
        }
{%- endif %}
{%- endif %}
{%- set tried = namespace(done=false) %}
{%- for tv in t.ty.try_variants() if not (objects and tv.json_type == "object") %}
{%- set v = variants.list | selectattr("name", "equalto", tv.name) | first %}
{%- if v and not tried.done %}
{%- set create = "new " ~ name ~ "." ~ v.class %}
{%- set n = loop.index0 %}
{%- if v.kind == "empty" %}
        if (root.ValueKind == JsonValueKind.String && root.ValueEquals(""))
        {
            return {{ create }}();
        }
{%- elif v.kind == "string" %}
        if (root.ValueKind == JsonValueKind.String)
        {
            return {{ create }}(root.GetString()!);
        }
{%- set tried.done = true %}
{%- elif v.kind == "date_time" %}
        if (root.ValueKind == JsonValueKind.String && root.TryGetDateTimeOffset(out var dateTime{{ n }}))
        {
            return {{ create }}(dateTime{{ n }});
        }
{%- elif v.kind == "guid" %}
        if (root.ValueKind == JsonValueKind.String && root.TryGetGuid(out var guid{{ n }}))
        {
            return {{ create }}(guid{{ n }});
        }
{%- elif v.kind == "date" %}
        if (
            root.ValueKind == JsonValueKind.String
            && DateOnly.TryParseExact(root.GetString(), "yyyy-MM-dd", global::System.Globalization.CultureInfo.InvariantCulture, global::System.Globalization.DateTimeStyles.None, out var date{{ n }})
        )
        {
            return {{ create }}(date{{ n }});
        }
{%- elif v.kind == "decimal" %}
        if (
            root.ValueKind == JsonValueKind.String
            && decimal.TryParse(root.GetString(), global::System.Globalization.NumberStyles.Float, global::System.Globalization.CultureInfo.InvariantCulture, out var decimal{{ n }})
        )
        {
            return {{ create }}(decimal{{ n }});
        }
{%- elif v.kind == "bool" %}
        if (root.ValueKind is JsonValueKind.True or JsonValueKind.False)
        {
            return {{ create }}(root.GetBoolean());
        }
{%- elif v.kind == "number" %}
{%- set getter = {"short": "Int16", "int": "Int32", "long": "Int64", "ushort": "UInt16", "ulong": "UInt64", "float": "Single", "double": "Double"}[v.type] %}
        if (root.ValueKind == JsonValueKind.Number && root.TryGet{{ getter }}(out var number{{ n }}))
        {
            return {{ create }}(number{{ n }});
        }
{%- elif v.kind == "node" %}
        if (root.ValueKind == JsonValueKind.Object)
        {
            return {{ create }}(JsonNode.Parse(root.GetRawText())!);
        }
{%- else %}
        if (
            global::{{ sdk.package_name }}.UnionRules.Is(root, {{ v.shape | tojson }})
            && Json.TryDeserialize<{{ v.type }}>(root, options, out var value{{ n }})
        )
        {
            return {{ create }}(value{{ n }});
        }
{%- endif %}
{%- endif %}
{%- endfor %}
        return new {{ name }}.Unrecognized(root.Clone());
    }

    {{ m.wrap("public override void Write", ["Utf8JsonWriter writer", name ~ " value", "JsonSerializerOptions options"], 4) }}
    {
        switch (value)
        {
{%- for v in variants.list %}
{%- if v.kind == "empty" %}
            case {{ name }}.{{ v.class }}:
                writer.WriteStringValue("");
                break;
{%- else %}
            case {{ name }}.{{ v.class }} variant:
{%- if v.kind in ["string", "date_time", "guid"] %}
                writer.WriteStringValue(variant.Value);
{%- elif v.kind == "date" %}
                writer.WriteStringValue(variant.Value.ToString("yyyy-MM-dd", global::System.Globalization.CultureInfo.InvariantCulture));
{%- elif v.kind == "decimal" %}
                writer.WriteStringValue(variant.Value.ToString(global::System.Globalization.CultureInfo.InvariantCulture));
{%- elif v.kind == "bool" %}
                writer.WriteBooleanValue(variant.Value);
{%- elif v.kind == "number" %}
                writer.WriteNumberValue(variant.Value);
{%- elif v.kind == "node" %}
                variant.Value.WriteTo(writer, options);
{%- else %}
                {{ m.wrap("JsonSerializer.Serialize", ["writer", "variant.Value", "Json.TypeInfo<" ~ v.type ~ ">(options)"], 16, ";") }}
{%- endif %}
                break;
{%- endif %}
{%- endfor %}
            case {{ name }}.Unrecognized unrecognized:
                unrecognized.Raw.WriteTo(writer);
                break;
        }
    }
}
{%- endif %}
{%- endfor %}
