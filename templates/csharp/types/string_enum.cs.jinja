{% import "macros.cs.jinja" as m -%}
{% set type_name = type.name | to_upper_camel_case -%}
{#- Unique names of the values, from `enum_names`: `a-b` and `a_b` do not both become `AB`. -#}
{% set names = type.values | enum_names -%}
{% set values_class = "KnownValues" if type_name == "Values" else "Values" -%}
{% macro name(value_name) -%}
{% set id = m.member(value_name, type_name) -%}
{{ id }}{% if id in ["Value", values_class, "IsKnown", "Equals", "GetHashCode", "ToString"] %}Variant{% endif %}
{%- endmacro -%}
{% macro text(value) %}{{ value | replace("&", "&amp;") | replace("<", "&lt;") | replace(">", "&gt;") }}{% endmacro -%}
// this file is @generated
#pragma warning disable CA1707, CA1711, CA1716, CA1720 // identifiers follow the API's own names
using System.Text.Json.Serialization;

namespace {{ sdk.package_name }}.Models;
{% if type.description | default("") | trim %}
{{ m.doc(type.description) }}
{%- else %}
/// <summary>
/// One of the known values below, or any other string a newer API version sends.
/// </summary>
{%- endif %}
/// <param name="Value">The JSON value.</param>
[JsonConverter(typeof(StringEnumConverter<{{ type_name }}>))]
public readonly partial record struct {{ type_name }}(string Value) : IStringEnum<{{ type_name }}>
{
{%- for value in type.values %}
{%- if not loop.first %}{{ "\n" }}{% endif %}
    /// <summary><c>{{ text(value) }}</c></summary>
    public static {{ type_name }} {{ name(names[loop.index0]) }} { get; } = new({{ value | tojson }});
{%- endfor %}

    /// <summary>Whether this SDK version knows the value.</summary>
{%- set known %}Value is {% for value in type.values %}{{ value | tojson }}{% if not loop.last %} or {% endif %}{% endfor %}{% endset %}
    {{ m.arrow("public bool IsKnown", known, 4) }}

    /// <summary>The known values as constants, to <c>switch</c> on <see cref="Value"/>.</summary>
    public static class {{ values_class }}
    {
{%- for value in type.values %}
{%- if not loop.first %}{{ "\n" }}{% endif %}
        /// <summary><c>{{ text(value) }}</c></summary>
        public const string {{ name(names[loop.index0]) }} = {{ value | tojson }};
{%- endfor %}
    }

    static {{ type_name }} IStringEnum<{{ type_name }}>.FromValue(string value) => new(value);

    /// <summary>The value <paramref name="value"/>, known or not.</summary>
    /// <param name="value">The JSON value.</param>
    public static implicit operator {{ type_name }}(string value) => new(value);

    /// <inheritdoc/>
    public override string ToString() => Value ?? string.Empty;
}

