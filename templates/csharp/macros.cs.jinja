{% macro doc(text) -%}
/// <summary>
{{ text | replace("&", "&amp;") | replace("<", "&lt;") | replace(">", "&gt;") | to_doc_comment(style="csharp") }}
/// </summary>
{%- endmacro %}

{# A lowerCamelCase parameter name, `@`-escaped when it is a C# keyword. -#}
{% macro param(name) -%}
{% set id = name | to_lower_camel_case -%}
{% if id in ["abstract", "as", "base", "bool", "break", "byte", "case", "catch", "char", "checked",
    "class", "const", "continue", "decimal", "default", "delegate", "do", "double", "else", "enum",
    "event", "explicit", "extern", "false", "finally", "fixed", "float", "for", "foreach", "goto",
    "if", "implicit", "in", "int", "interface", "internal", "is", "lock", "long", "namespace", "new",
    "null", "object", "operator", "out", "override", "params", "private", "protected", "public",
    "readonly", "ref", "return", "sbyte", "sealed", "short", "sizeof", "stackalloc", "static",
    "string", "struct", "switch", "this", "throw", "true", "try", "typeof", "uint", "ulong",
    "unchecked", "unsafe", "ushort", "using", "virtual", "void", "volatile", "while"] -%}
@{{ id }}
{%- elif id in ["request", "options", "requestOptions", "cancellationToken", "form", "param", "ct", "pagination"] -%}
{{ id }}Param
{%- else -%}
{{ id }}
{%- endif %}
{%- endmacro %}

{# A PascalCase member name, which C# forbids to equal its enclosing type's. -#}
{% macro member(name, owner) -%}
{% set id = name | to_rust_variant -%}
{% if id == owner %}{{ id }}Value{% else %}{{ id }}{% endif %}
{%- endmacro %}

{# The class of a resource: `ActivityApi` for both `activity` and a renamed `activity_api`. -#}
{% macro resource_class(name) -%}
{% set id = name | to_upper_camel_case -%}
{{ id }}{% if not id is endingwith "Api" %}Api{% endif %}
{%- endmacro %}

{# A model name, qualified when a runtime type of the root namespace would shadow it. -#}
{% macro model(name) -%}
{% set id = name | to_upper_camel_case -%}
{% if id in ["ApiRequest", "ApiTransport", "ApiException", "ApiAuth", "RequestOptions", "Upload",
    "MultipartBody", "EventStream", "SseEvent", "Pagination", "Paginator", "Credentials",
    "BasicCredentials", "SecurityScheme", "SchemeKind", "Webhook"] %}Models.{% endif %}{{ id }}
{%- endmacro %}

{# The property type of a model field or query parameter. -#}
{% macro field_type(field) -%}
{{ field.type.to_csharp() }}{% if field.nullable or not field.required %}?{% endif %}
{%- endmacro %}


{# The C# type of an operation's JSON request body, empty without one. -#}
{% macro body_type(op) -%}
{% if op.request_body_schema_name is defined -%}
{% if op.request_body_is_list %}List<{% endif %}{{ model(op.request_body_schema_name) }}{% if op.request_body_is_list %}>{% endif %}
{%- elif op.request_body_json_type is defined -%}
{{ op.request_body_json_type.to_csharp() }}
{%- endif %}
{%- endmacro %}

{# The C# type of an operation's JSON response, empty without one. -#}
{% macro response_type(op) -%}
{% if op.response_body_json_type is defined -%}
{{ op.response_body_json_type.to_csharp() }}
{%- elif op.response_body_schema_name is defined -%}
{% if op.response_body_is_list %}List<{% endif %}{{ model(op.response_body_schema_name) }}{% if op.response_body_is_list %}>{% endif %}
{%- endif %}
{%- endmacro %}

{# The `JsonContext` property of a body type: its name, or a flattened name for generics. -#}
{% macro type_info(type) -%}
{% set type = type | replace("Models.", "") -%}
{% set clr = {"string": "String", "bool": "Boolean", "int": "Int32", "long": "Int64", "short": "Int16",
    "ushort": "UInt16", "ulong": "UInt64", "float": "Single", "double": "Double", "decimal": "Decimal"} -%}
{% if "<" in type %}Json{{ type | to_upper_camel_case }}{% else %}{{ clr[type] | default(type) }}{% endif %}
{%- endmacro %}
