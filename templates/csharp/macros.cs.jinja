{# Markdown inline text as XML doc text: escaped, with `code` spans as <c>. -#}
{% macro xml(text) -%}
{% set escaped = text | replace("&", "&amp;") | replace("<", "&lt;") | replace(">", "&gt;") -%}
{% set parts = escaped | split("`") | list -%}
{% if parts | length is odd and "```" not in escaped -%}
{% for part in parts %}{% if loop.index is even %}<c>{{ part }}</c>{% else %}{{ part }}{% endif %}{% endfor %}
{%- else -%}
{{ escaped }}
{%- endif %}
{%- endmacro %}

{# One Markdown paragraph, or a `-` list, as XML doc lines. -#}
{% macro block(text) -%}
{% set lines = text | lines | list -%}
{% if lines | reject("startingwith", "- ") | list | length == 0 -%}
<list type="bullet">
{% for line in lines %}<item><description>{{ xml(line[2:]) }}</description></item>
{% endfor %}</list>
{%- else -%}
{{ xml(text) }}
{%- endif %}
{%- endmacro %}

{# The XML doc of a Markdown description: its first paragraph as the summary, others and
   `remarks` (XML) as remarks. -#}
{% macro doc(text, remarks="") -%}
{% set text = text | default("") | trim -%}
{% set blocks = (text | split("\n\n") | list if "```" not in text else [text]) if text else [] -%}
{% set out = namespace(lines=[]) -%}
{% if blocks %}{% set out.lines = ["<summary>", block(blocks[0]), "</summary>"] %}{% endif -%}
{% if blocks | length > 1 or remarks -%}
{% set out.lines = out.lines + ["<remarks>"] -%}
{% if blocks | length == 2 and not remarks -%}
{% set out.lines = out.lines + [block(blocks[1])] -%}
{% else -%}
{% for b in blocks[1:] %}{% set out.lines = out.lines + ["<para>", block(b), "</para>"] %}{% endfor -%}
{% endif -%}
{% if remarks %}{% set out.lines = out.lines + [remarks] %}{% endif -%}
{% set out.lines = out.lines + ["</remarks>"] -%}
{% endif -%}
{{ out.lines | join("\n") | to_doc_comment(style="csharp") }}
{%- endmacro %}

{# A lowerCamelCase parameter name, `@`-escaped when it is a C# keyword. -#}
{% macro param(name) -%}
{% set id = name | to_lower_camel_case -%}
{% if id in ["abstract", "as", "base", "bool", "break", "byte", "case", "catch", "char", "checked",
    "class", "const", "continue", "decimal", "default", "delegate", "do", "double", "else", "enum",
    "event", "explicit", "extern", "false", "finally", "fixed", "float", "for", "foreach", "goto",
    "if", "implicit", "in", "int", "interface", "internal", "is", "lock", "long", "namespace", "new",
    "null", "object", "operator", "out", "override", "params", "private", "protected", "public",
    "readonly", "ref", "return", "sbyte", "sealed", "short", "sizeof", "stackalloc", "static",
    "string", "struct", "switch", "this", "throw", "true", "try", "typeof", "uint", "ulong",
    "unchecked", "unsafe", "ushort", "using", "virtual", "void", "volatile", "while"] -%}
@{{ id }}
{%- elif id in ["request", "options", "requestOptions", "cancellationToken", "form", "param", "ct", "pagination"] -%}
{{ id }}Param
{%- else -%}
{{ id }}
{%- endif %}
{%- endmacro %}

{# A PascalCase member name, which C# forbids to equal its enclosing type's or to redeclare a
   member every record inherits or synthesizes. -#}
{% macro member(name, owner) -%}
{% set id = name | to_rust_variant -%}
{% if id == owner or id in ["Equals", "GetHashCode", "ToString", "GetType", "MemberwiseClone", "ReferenceEquals", "Finalize", "EqualityContract", "PrintMembers", "Deconstruct"] %}{{ id }}Value{% else %}{{ id }}{% endif %}
{%- endmacro %}

{# The class of a resource: `ActivityApi` for both `activity` and a renamed `activity_api`. -#}
{% macro resource_class(name) -%}
{% set id = name | to_upper_camel_case -%}
{{ id }}{% if not id is endingwith "Api" %}Api{% endif %}
{%- endmacro %}

{# A model name, qualified when a runtime type of the root namespace would shadow it. -#}
{% macro model(name) -%}
{% set id = name | to_upper_camel_case -%}
{% if id in ["ApiRequest", "ApiTransport", "ApiException", "ApiAuth", "RequestOptions", "Upload",
    "MultipartBody", "EventStream", "SseEvent", "Pagination", "Paginator", "Credentials",
    "BasicCredentials", "SecurityScheme", "SchemeKind", "Webhook", "BadRequestException",
    "UnauthorizedException", "ForbiddenException", "NotFoundException", "ConflictException",
    "UnprocessableEntityException", "RateLimitException", "ServerErrorException",
    "ApiExceptionExtensions", "ApiConnectionException", "ApiTimeoutException", "ApiDecodeException",
    "ApiResponse", "Page", "AsyncPager", "Paging", "Equality", "IStringEnum", "IIntegerEnum",
    "UnionRules", "Json", "MaybeUnset", "WebhookVerificationException"] %}Models.{% endif %}{{ id }}
{%- endmacro %}

{# The property type of a model field or query parameter, `union` naming its typed union, its
   collections read-only interfaces with `readonly`. -#}
{% macro field_type(field, union="", readonly=false) -%}
{% set ty = field.type.to_csharp() -%}
{% if union %}{% set ty = ty | replace("JsonNode", union) %}{% endif -%}
{% if readonly %}{% set ty = ty | replace("List<", "IReadOnlyList<") | replace("Dictionary<", "IReadOnlyDictionary<") %}{% endif -%}
{{ ty }}{% if field.nullable or not field.required %}?{% endif %}
{%- endmacro %}

{# The class of the union a field of `owner` holds, directly or in collections; empty without. -#}
{% macro union_class(field, owner, taken) -%}
{% set t = namespace(ty=field.type) -%}
{% for _ in range(8) -%}
{% if t.ty.is_list() or t.ty.is_set() or t.ty.is_nullable() %}{% set t.ty = t.ty.inner_type() %}{% elif t.ty.is_map() %}{% set t.ty = t.ty.value_type() %}{% endif -%}
{% endfor -%}
{% if t.ty.is_union() -%}
{% set id = owner ~ (field.name | to_rust_variant) -%}
{{ id }}{% if id in taken %}Union{% endif %}
{%- endif %}
{%- endmacro %}


{# The class of the union named `name` by an operation body: a model of `types` when it is a named
   alias (declared with the models), else declared with the resource. -#}
{% macro union_ref(name, types) -%}
{% if name in types %}{{ model(name) }}{% else %}{{ name | to_upper_camel_case }}{% endif %}
{%- endmacro %}

{# The C# type of a JSON body of the type `ty`, its union (named `union`, if any) typed. A union is a
   reference type: `typeof` cannot take a nullable one, so it is never written with `?`. -#}
{% macro json_body_type(ty, union, types) -%}
{% if union %}{{ ty.to_csharp() | replace("JsonNode", union_ref(union, types)) | trim("?") }}{% else %}{{ ty.to_csharp() }}{% endif %}
{%- endmacro %}

{# The C# type of an operation's JSON request body, empty without one. -#}
{% macro body_type(op, types={}) -%}
{% if op.request_body_schema_name is defined -%}
{% if op.request_body_is_list %}List<{% endif %}{{ model(op.request_body_schema_name) }}{% if op.request_body_is_list %}>{% endif %}
{%- elif op.request_body_json_type is defined -%}
{{ json_body_type(op.request_body_json_type, op.request_body_union | default(""), types) }}
{%- endif %}
{%- endmacro %}

{# The union named after the event schema of an event stream, when that schema is an alias whose
   target holds a union: declared like the union of a JSON body. Empty otherwise. -#}
{% macro event_union(op) -%}
{% if op.event_json_type is defined -%}
{% set t = namespace(ty=op.event_json_type) -%}
{% for _ in range(8) -%}
{% if t.ty.is_list() or t.ty.is_set() or t.ty.is_nullable() %}{% set t.ty = t.ty.inner_type() %}{% elif t.ty.is_map() %}{% set t.ty = t.ty.value_type() %}{% endif -%}
{% endfor -%}
{% if t.ty.is_union() %}{{ op.event_schema_name }}{% endif -%}
{% endif -%}
{%- endmacro %}

{# The C# type of each event of an event stream naming its schema: the model, or the target of an alias. -#}
{% macro event_type(op, types={}) -%}
{% if op.event_json_type is defined -%}
{{ json_body_type(op.event_json_type, event_union(op), types) }}
{%- else -%}
{{ model(op.event_schema_name) }}
{%- endif %}
{%- endmacro %}

{# The C# type of an operation's JSON response, empty without one. -#}
{% macro response_type(op, types={}) -%}
{% if op.response_body_json_type is defined -%}
{{ json_body_type(op.response_body_json_type, op.response_body_union | default(""), types) }}
{%- elif op.response_body_schema_name is defined -%}
{% if op.response_body_is_list %}List<{% endif %}{{ model(op.response_body_schema_name) }}{% if op.response_body_is_list %}>{% endif %}
{%- endif %}
{%- endmacro %}

{# Whether the C# type `ty` is a value type, which `?` makes a `Nullable<T>` of. -#}
{% macro is_value_type(ty) -%}
{% if ty in ["bool", "int", "long", "short", "ushort", "ulong", "float", "double", "decimal", "DateTimeOffset"] %}yes{% endif %}
{%- endmacro %}

{# The kind of the schema the JSON type `ty` names (`struct`, `string_enum`...), empty for other types. -#}
{% macro schema_kind(ty, types={}) -%}
{% if ty.is_schema_ref() -%}
{% set inner = ty.inner_schema_ref_ty() -%}
{% set target = inner or types[ty.to_csharp()] -%}
{{ target.kind if target else "" }}
{%- endif %}
{%- endmacro %}

{# `yes` when a required argument of the C# type `ty`, naming a schema of the kind `kind` (if any),
   takes an `ArgumentNullException.ThrowIfNull` check: a non-nullable reference type. A value type
   (number, boolean, date, enum record struct) is never null, so checking it is a no-op (CA2264),
   and a nullable type accepts `null`. -#}
{% macro needs_null_check(ty, kind="") -%}
{% if ty[-1:] != "?" and not is_value_type(ty) and kind not in ["string_enum", "integer_enum"] %}yes{% endif %}
{%- endmacro %}

{# The `JsonContext` property of a body type: its name, or a flattened name for generics. -#}
{% macro type_info(type) -%}
{% set type = type | replace("Models.", "") | replace("?", "OrNull") -%}
{% set clr = {"string": "String", "bool": "Boolean", "int": "Int32", "long": "Int64", "short": "Int16",
    "ushort": "UInt16", "ulong": "UInt64", "float": "Single", "double": "Double", "decimal": "Decimal"} -%}
{% if "<" in type %}Json{{ type | to_upper_camel_case }}{% else %}{{ clr[type] | default(type) }}{% endif %}
{%- endmacro %}

{# The nested record of union variant `v` in the union class `union`: JSON type names get a
   `Value` suffix, not to shadow the BCL types (CA1720). -#}
{% macro union_variant_class(v, union) -%}
{% set class = v.name | to_rust_variant -%}
{% if v.name in ["string", "integer", "number", "boolean", "list", "array", "object", "map"] %}{{ class }}Value
{%- else %}{{ class }}{% if class in [union, "Unrecognized", "Value", "Raw", "Id", "EqualityContract", "Deconstruct", "PrintMembers", "Equals", "GetHashCode", "ToString", "IsEmpty"] %}Variant{% endif %}
{%- endif %}
{%- endmacro %}

{# The exception class thrown for an error response status: `404`, `4XX` or `default`. -#}
{% macro status_exception(status) -%}
{% set classes = {"400": "BadRequestException", "401": "UnauthorizedException", "403": "ForbiddenException",
    "404": "NotFoundException", "409": "ConflictException", "422": "UnprocessableEntityException",
    "429": "RateLimitException", "5XX": "ServerErrorException"} -%}
{{ classes[status] | default("ServerErrorException" if status is startingwith("5") else "ApiException") }}
{%- endmacro %}

{# A declaration or call `head(args)` then `tail`, on one line when it fits in 120 columns at
   `depth`, else one argument per line as CSharpier lays it out. -#}
{% macro wrap(head, args, depth, tail="") -%}
{% set flat = head ~ "(" ~ (args | join(", ")) ~ ")" ~ tail -%}
{% if depth + (flat | length) <= 120 or not args %}{{ flat }}{% else %}{{ head }}(
{%- for a in args %}
{{ " " * (depth + 4) }}{{ a }}{% if not loop.last %},{% endif %}
{%- endfor %}
{{ " " * depth }}){{ tail }}{% endif %}
{%- endmacro %}

{# An expression-bodied member `head => body;`, broken after `=>` when longer than 120 columns. -#}
{% macro arrow(head, body, depth) -%}
{{ head }} =>{% if depth + (head | length) + (body | length) + 5 <= 120 %} {% else %}
{{ " " * (depth + 4) }}{% endif %}{{ body }};
{%- endmacro %}
