{% import "sdk/docs.jinja" as docs -%}
{% import "sdk/api_reference.md.jinja" as ref -%}
{% set _ = set_summary_filename("package.json") -%}
{% set bin = (sdk.npm_package | split("/") | last) ~ "-mcp" -%}
{#- The types an operation takes and returns, as `[name, SDK source]` pairs. -#}
{% macro types(resource, op) -%}
{% set ns = namespace(pairs=[]) -%}
{% if op | has_query_or_header_params %}{% set ns.pairs = ns.pairs + [[(resource.name | to_upper_camel_case) ~ (op.name | to_upper_camel_case) ~ "Options", docs.resource_path(resource.name)]] %}{% endif -%}
{% for name in [op.request_body_schema_name, op.pagination.item_schema if op.pagination is defined else none, op.response_body_schema_name] if name is not none and name is defined and name in api.types -%}
{% set pair = [name | to_upper_camel_case, docs.model_path(name)] -%}
{% if pair not in ns.pairs %}{% set ns.pairs = ns.pairs + [pair] %}{% endif -%}
{% endfor -%}
{{ ns.pairs | tojson }}
{%- endmacro -%}
{% set generated -%}
// This file is @generated by perseid, from the mcp pack: the client of the SDK, and the index
// of its operations and models that `search` reads.
import { {{ sdk.client_name }} } from "{{ sdk.npm_package }}";

import type { Api } from "perseid-mcp";

export const api: Api = {
  name: {{ sdk.client_name | tojson }},
  server: {{ (sdk.npm_package ~ "-mcp") | tojson }},
  version: {{ pack.sdk.version | tojson }},
  envPrefix: {{ sdk.env_prefix | tojson }},
  instructions: {{ (sdk.mcp_instructions | default("")) | tojson }},
  client: (options) => new {{ sdk.client_name }}(options),
  corpus: {
    package: {{ sdk.npm_package | tojson }},
    operations: [
{%- for resource in api.resources %}{% for op in resource.operations if not op.response_is_event_stream %}
      {
        accessor: {{ (docs.resource(resource.path)[7:] ~ "." ~ docs.method(op)) | tojson }},
        signature: {{ ref.signature(resource, op)[7:] | tojson }},
        method: {{ (op.method | upper) | tojson }},
        path: {{ op.path | tojson }},
        summary: {{ ((op.description | trim | split("\n") | first) if op.description is defined else "") | tojson }},
        description: {{ ((op.description | trim) if op.description is defined else "") | tojson }},
        deprecated: {{ (op.deprecated | default(false)) | tojson }},
        paginated: {{ (op.pagination is defined) | tojson }},
        types: {{ types(resource, op) }},
      },
{%- endfor %}{% endfor %}
    ],
    models: {
{%- for name, t in api.types | dictsort %}
      {{ (name | to_upper_camel_case) | tojson }}: {{ docs.model_path(name) | tojson }},
{%- endfor %}
    },
  },
};
{% endset -%}
{% set _ = generate_extra_file(output_dir ~ "/src/generated/api.ts", generated) -%}
{% set package -%}
{
  "//": "this file is @generated by perseid, from the mcp pack: its version is the SDK's",
  "name": {{ (sdk.npm_package ~ "-mcp") | tojson }},
  "version": {{ pack.sdk.version | tojson }},
  "description": {{ ("An MCP server for the " ~ sdk.client_name ~ " API, in code mode") | tojson }},
  "type": "module",
  "bin": { {{ bin | tojson }}: "dist/main.js" },
  "main": "dist/main.js",
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "build:worker": "tsc && perseid-mcp sources dist/generated/api.js --out src/generated/sources.json",
    "deploy": "wrangler deploy",
    "mcpb": "npm run build && npm prune --omit=dev --omit=optional && perseid-mcp mcpb dist/generated/api.js --out manifest.json && npx -y @anthropic-ai/mcpb@2 pack . {{ bin }}.mcpb"
  },
  "dependencies": {
    {{ sdk.npm_package | tojson }}: {{ pack.sdk.version | tojson }},
    "perseid-mcp": "^0.1.0"
  },
  "optionalDependencies": {
    "deno": "^2.9.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.40.0"
  },
  "publishConfig": { "access": "public" }
}
{% endset -%}
{{ package }}