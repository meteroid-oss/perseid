/// The root command and the generated commands, without the runtime's global options and
/// built-ins, which `runtime::app::command` adds.
pub fn command() -> Command {
    Command::new(NAME)
        .about("The {{ sdk.client_name }} API from the command line")
        {% for resource in api.resources | rejectattr("parent") -%}
        .subcommand(commands::{{ resource.name | to_rust_ident }}::command())
        {% endfor -%}
}

/// Runs the generated command `matches` names.
pub async fn dispatch(ctx: &mut Ctx, matches: &ArgMatches) -> Result<(), CliError> {
    match matches.subcommand() {
        {% for resource in api.resources | rejectattr("parent") -%}
        Some(("{{ resource_command(resource, api.types) }}", matches)) => commands::{{ resource.name | to_rust_ident }}::dispatch(ctx, matches).await,
        {% endfor -%}
        Some((name, _)) => Err(CliError::internal(format!(
            "`{name}` is not a generated command: dispatch it in main.rs"
        ))),
        None => unreachable!("clap requires a subcommand"),
    }
}

/// The SDK's client, with the credential and base URL of the flags, environment or profile.
pub async fn client(ctx: &mut Ctx) -> Result<sdk::api::{{ sdk.client_name }}, CliError> {
    let token = ctx.token().await?;
    build(ctx, sdk::api::{{ sdk.client_name }}::builder().token(token))
}

/// The SDK's client without a credential, for operations needing none.
pub fn anonymous_client(ctx: &Ctx) -> Result<sdk::api::{{ sdk.client_name }}, CliError> {
    build(ctx, sdk::api::{{ sdk.client_name }}::builder())
}

fn build(
    ctx: &Ctx,
    builder: sdk::api::{{ sdk.client_name }}Builder,
) -> Result<sdk::api::{{ sdk.client_name }}, CliError> {
    let builder = match ctx.base_url() {
        Some(url) => builder.base_url(url),
        None => builder,
    };
    let builder = match ctx.max_retries() {
        Some(retries) => builder.max_retries(retries),
        None => builder,
    };
    let builder = match ctx.timeout() {
        Some(timeout) => builder.timeout(timeout),
        None => builder,
    };
    let builder = match ctx.attempts() {
        Some(log) => builder.middleware(Attempts(log)),
        None => builder,
    };
    let builder = match ctx.dry_run() {
        Some(recorder) => builder
            .max_retries(0)
            .http_client(std::sync::Arc::new(DryRun(recorder.clone()))),
        None => builder,
    };
    Ok(builder.build()?)
}

/// The HTTP client of `--dry-run`: records the request instead of sending it.
struct DryRun(runtime::dry_run::Recorder);

impl sdk::api::HttpClient for DryRun {
    fn send(
        &self,
        request: sdk::api::http::Request<sdk::api::RequestBody>,
    ) -> sdk::api::middleware::BoxFuture<
        '_,
        Result<sdk::api::http::Response<runtime::dry_run::Incoming>, sdk::api::middleware::BoxError>,
    > {
        Box::pin(self.0.record(request))
    }
}

/// `--debug`'s line per HTTP attempt, retries included.
struct Attempts(runtime::retry::Attempts);

impl sdk::api::middleware::Middleware for Attempts {
    fn handle<'a>(
        &'a self,
        request: sdk::api::middleware::Request,
        next: sdk::api::middleware::Next<'a>,
    ) -> sdk::api::middleware::BoxFuture<
        'a,
        Result<sdk::api::middleware::Response, sdk::api::middleware::BoxError>,
    > {
        Box::pin(async move {
            let method = request.method().to_string();
            let url = request.uri().to_string();
            let retry = request
                .headers()
                .iter()
                .find(|(name, _)| name.as_str().ends_with("-retry-count"))
                .and_then(|(_, value)| value.to_str().ok())
                .map(str::to_owned);
            let started = std::time::Instant::now();
            let response = next.run(request).await;
            let outcome = match &response {
                Ok(response) => Ok(response.status().as_u16()),
                Err(error) => Err(error.to_string()),
            };
            let outcome = outcome.as_ref().copied().map_err(String::as_str);
            self.0.log(&method, &url, retry.as_deref(), outcome, started.elapsed());
            response
        })
    }
}

/// A file to upload, as the SDK takes it.
pub fn upload(file: args::File) -> sdk::api::Upload {
    let upload = sdk::api::Upload::bytes(file.bytes);
    match file.name {
        Some(name) => upload.with_filename(name),
        None => upload,
    }
}

/// An event of an untyped stream, its data decoded when it is JSON.
pub fn sse_event(event: sdk::api::SseEvent) -> serde_json::Value {
    let data = serde_json::from_str(&event.data).unwrap_or(serde_json::Value::String(event.data));
    serde_json::json!({"event": event.event, "data": data, "id": event.id})
}

impl From<sdk::error::Error> for CliError {
    fn from(error: sdk::error::Error) -> Self {
        use sdk::error::Error;
        match error {
            Error::Api(api) => {
                let retry_after = api
                    .headers
                    .get("retry-after")
                    .and_then(|value| value.to_str().ok())
                    .and_then(|value| value.trim().parse().ok());
                CliError::api(api.status.as_u16(), &api.body)
                    .with_request_id(api.request_id())
                    .with_retry_after(retry_after)
            }
            Error::Timeout => CliError::timeout(),
            Error::Connection(source) => CliError::network(&source).with_source(source),
            Error::Decode(source) => CliError::decode(&source).with_source(source),
            Error::Request(source) => CliError::invalid_request(&source).with_source(source),
            other => CliError::internal(other.to_string()),
        }
    }
}

