{% import "docs_lang.jinja" as lang -%}
{% import "docs_common.jinja" as c -%}
{% set _ = set_summary_filename("perseid-docs.json") -%}
{
  "generated": "this file is @generated by perseid-docs",
  "install": {{ lang.install() | trim | tojson }},
  "setup": {{ lang.setup() | trim | tojson }},
  "operations": {
{%- set first = namespace(v=true) %}
{%- for top in api.resources %}
{%- for resource in [top] + (top.subresources | items | map(attribute=1) | list) %}
{%- for op in resource.operations %}
{%- set out = namespace(ex=none, complete=true) %}{% set _ = c.example(out, resource, op, api.types) %}
{%- if not first.v %},{% endif %}{% set first.v = false %}
    {{ op.id | tojson }}: {
      "method": {{ lang.method(resource, op) | trim | tojson }},
      "signature": {{ lang.signature(resource, op) | trim | tojson }},
      "sample": {{ lang.sample(out.ex) | trim | tojson }},
      "complete": {{ out.complete | tojson }},
      "params": { {%- for p in op.typed_path_params %}{{ p.name | tojson }}: {{ lang.path_param(p.name) | trim | tojson }}, {% endfor %}{% for p in op.query_params + op.header_params %}{{ p.name | tojson }}: {{ lang.param(p) | trim | tojson }}, {% endfor %}"": "" }
    }
{%- endfor %}
{%- endfor %}
{%- endfor %}
  },
  "types": {
{%- for name, ty in api.types | items %}
    {{ name | tojson }}: { "name": {{ lang.type_name(name) | trim | tojson }}, "fields": { {%- for f in ty.fields | default([]) if not f.flatten %}{{ f.name | tojson }}: {{ lang.field(f) | trim | tojson }}{% if not loop.last %}, {% endif %}{% endfor %} } }{% if not loop.last %},{% endif %}
{%- endfor %}
  }
}
