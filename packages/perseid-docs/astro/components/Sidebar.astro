---
import Default from "@astrojs/starlight/components/Sidebar.astro";
import config from "virtual:perseid-docs/config";
import Icon from "../mintlify/Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";

const topics = Astro.locals.starlightSidebarTopics?.topics ?? [];
const anchors: { label: string; href: string; icon?: string }[] = config.anchors ?? [];
---

{
  topics.length > 1 && (
    <ul class="pd-mobile-topics md:sl-hidden">
      {topics.map((t) => (
        <li>
          <a href={t.link} aria-current={t.isCurrent ? "page" : undefined}>{t.label}</a>
        </li>
      ))}
    </ul>
  )
}
{
  anchors.length > 0 && (
    <ul class="pd-anchors">
      {anchors.map((a) => (
        <li>
          <a href={a.href}>
            <span class="pd-anchor-icon"><Icon name={a.icon} /></span>
            {a.label}
          </a>
        </li>
      ))}
    </ul>
  )
}
<Default><slot /></Default>
<div class="pd-sidebar-foot sl-hidden md:sl-flex">
  <ThemeToggle />
</div>
